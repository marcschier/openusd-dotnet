#usda 1.0
(
    defaultPrim = "World"
    startTimeCode = 1
    endTimeCode = 1
    framesPerSecond = 24
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def PointInstancer "Instancer"
    {
        rel prototypes = </World/Prototypes/Tri>
        int[] protoIndices = [0, 0, 0, 0]
        point3f[] positions = [(-0.58, -0.42, 0.08), (-0.10, 0.26, 0.08), (0.46, -0.10, 0.08), (0.72, 0.50, 0.08)]
        quath[] orientations = [(1, 0, 0, 0), (0.9238795, 0, 0, 0.3826834), (0.7071068, 0, 0, -0.7071068), (1, 0, 0, 0)]
        float3[] scales = [(0.30, 0.22, 1), (0.18, 0.34, 1), (0.26, 0.16, 1), (0.14, 0.24, 1)]
    }

    def Scope "Prototypes"
    {
        token visibility = "invisible"
        def Mesh "Tri"
        {
            uniform bool doubleSided = 1
            uniform token subdivisionScheme = "none"
            point3f[] points = [(-1, -0.65, 0), (0.95, -0.20, 0), (-0.25, 1, 0)]
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            color3f[] primvars:displayColor = [(0.55, 0.85, 0.30)]
            uniform token primvars:displayColor:interpolation = "constant"
        }
    }
}