#usda 1.0
(
    defaultPrim = "World"
    startTimeCode = 1
    endTimeCode = 1
    framesPerSecond = 24
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    # Off-centre, strongly non-square all-quad frustum. Catmull-Clark refinement
    # rounds and shrinks the projected corners; if the harness complexity asks
    # Storm for only the cage, hdSilk must not refine.
    def Mesh "RoundedFrustum"
    {
        uniform bool doubleSided = 1
        uniform token subdivisionScheme = "catmullClark"
        point3f[] points = [
            (-0.92, -0.58, -0.22), ( 0.28, -0.52, -0.22),
            ( 0.18,  0.24, -0.22), (-0.84,  0.36, -0.22),
            (-0.54, -0.18,  0.26), ( 0.04, -0.12,  0.26),
            (-0.08,  0.78,  0.26), (-0.68,  0.62,  0.26)
        ]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [
            0, 1, 2, 3,
            4, 7, 6, 5,
            0, 4, 5, 1,
            1, 5, 6, 2,
            2, 6, 7, 3,
            3, 7, 4, 0
        ]
        color3f[] primvars:displayColor = [(0.82, 0.50, 0.22)]
        uniform token primvars:displayColor:interpolation = "constant"
    }

    def Mesh "AsymmetricAnchor"
    {
        uniform bool doubleSided = 1
        uniform token subdivisionScheme = "none"
        point3f[] points = [
            (0.42, -0.86, 0.18), (0.88, -0.76, 0.18),
            (0.72, -0.32, 0.18), (0.48, -0.46, 0.18)
        ]
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 3, 1, 2, 3]
        color3f[] primvars:displayColor = [(0.30, 0.62, 0.88)]
        uniform token primvars:displayColor:interpolation = "constant"
    }
}
