#usda 1.0
(
    defaultPrim = "World"
    startTimeCode = 1
    endTimeCode = 1
    framesPerSecond = 24
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def DistantLight "WarmKey"
    {
        color3f inputs:color = (1.0, 0.72, 0.42)
        float inputs:intensity = 3.2
        float inputs:exposure = 0.5
    }
    def Mesh "OffCentrePennant" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Matte>
        uniform bool doubleSided = 1
        uniform token subdivisionScheme = "none"
        point3f[] points = [
            (-0.88, -0.58, 0.08), (0.30, -0.45, 0.08),
            (0.76, 0.18, 0.08), (-0.64, 0.64, 0.08),
            (-0.82, -0.02, 0.08)
        ]
        int[] faceVertexCounts = [3, 3, 3]
        int[] faceVertexIndices = [0, 1, 4, 1, 2, 4, 2, 3, 4]
        normal3f[] normals = [
            (0.0, 0.0, 1.0), (0.18, 0.02, 0.98), (0.34, -0.14, 0.93),
            (-0.08, 0.26, 0.96), (-0.16, -0.06, 0.99)
        ] (
            interpolation = "vertex"
        )
    }

    def Scope "Looks"
    {
        def Material "Matte"
        {
            token outputs:surface.connect = </World/Looks/Matte/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.62, 0.95)
                float inputs:roughness = 0.78
                token outputs:surface
            }
        }
    }
}
