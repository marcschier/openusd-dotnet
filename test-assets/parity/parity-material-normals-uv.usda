#usda 1.0
(
    defaultPrim = "World"
    startTimeCode = 1
    endTimeCode = 1
    framesPerSecond = 24
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "UvNormalBanner" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/WarmMat>
        uniform bool doubleSided = 1
        uniform token subdivisionScheme = "none"
        point3f[] points = [
            (-0.78, -0.46, 0.08), (0.24, -0.54, 0.08), (0.62, -0.04, 0.08),
            (0.18, 0.58, 0.08), (-0.52, 0.34, 0.08), (-0.08, -0.02, 0.08)
        ]
        int[] faceVertexCounts = [3, 3, 3, 3]
        int[] faceVertexIndices = [0, 1, 5, 1, 2, 5, 2, 3, 5, 3, 4, 5]
        normal3f[] normals = [(0, 0, 1), (0.25, 0, 0.97), (0, 0.35, 0.94), (0, 0, 1), (-0.3, 0, 0.95), (0, 0, 1)] (
            interpolation = "vertex"
        )
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0.3, 1), (0, 0.5), (0.5, 0.45)] (
            interpolation = "vertex"
        )
        color3f[] primvars:displayColor = [(0.90, 0.46, 0.18)]
        uniform token primvars:displayColor:interpolation = "constant"
    }

    def Scope "Looks"
    {
        def Material "WarmMat"
        {
            token outputs:surface.connect = </World/Looks/WarmMat/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.90, 0.46, 0.18)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }
    }
}