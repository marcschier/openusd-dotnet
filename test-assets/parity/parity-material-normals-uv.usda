#usda 1.0
(
    defaultPrim = "World"
    startTimeCode = 1
    endTimeCode = 1
    framesPerSecond = 24
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "UvNormalBanner" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/WarmMat>
        uniform bool doubleSided = 1
        uniform token subdivisionScheme = "none"
        # A pennant: a thin vertical mast spanning the full height, with a
        # triangle attached to its top half only. The previous fan silhouette
        # was close to vertically symmetric, so a vertical flip still scored
        # 0.865109 and the scene could not be gated. Mass concentrated in the
        # upper right against an otherwise empty lower right makes a flip,
        # a mirror and a transpose all move coverage substantially.
        point3f[] points = [
            (-0.72, -0.62, 0.08), (-0.52, -0.62, 0.08), (-0.52, 0.68, 0.08),
            (-0.72, 0.68, 0.08), (0.66, 0.40, 0.08), (-0.52, 0.16, 0.08)
        ]
        int[] faceVertexCounts = [3, 3, 3]
        int[] faceVertexIndices = [0, 1, 2, 0, 2, 3, 2, 5, 4]
        normal3f[] normals = [
            (0, 0, 1), (0.25, 0, 0.97), (0, 0.30, 0.95),
            (-0.28, 0, 0.96), (0.35, -0.15, 0.92), (0, -0.25, 0.97)
        ] (
            interpolation = "vertex"
        )
        texCoord2f[] primvars:st = [
            (0, 0), (0.15, 0), (0.15, 1), (0, 1), (1, 0.75), (0.15, 0.6)
        ] (
            interpolation = "vertex"
        )
        color3f[] primvars:displayColor = [(0.90, 0.46, 0.18)]
        uniform token primvars:displayColor:interpolation = "constant"
    }

    def Scope "Looks"
    {
        def Material "WarmMat"
        {
            token outputs:surface.connect = </World/Looks/WarmMat/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.90, 0.46, 0.18)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }
    }
}