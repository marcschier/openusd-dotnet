#usda 1.0
(
    defaultPrim = "World"
    startTimeCode = 1
    endTimeCode = 1
    framesPerSecond = 24
    timeCodesPerSecond = 24
    upAxis = "Y"
)

# Width-interpolation probe for linear segmented basis curves. All four prims
# author byte-identical points and curveVertexCounts and sit in their own screen
# quadrant; only the authored widths interpolation differs.
#
# Before hdSilk resolved width interpolation, only "ConstantWidth" published any
# geometry at all: a widths array that was neither a scalar nor a single element
# made the delegate drop the whole Rprim, so "UniformWidth", "VaryingWidth", and
# "VertexWidth" rendered nothing while Storm rendered all four the same.
#
# Storm rasterizes linear basis curves as one-pixel screen-space lines at the
# harness refinement and ignores authored world-space widths -- measured in
# parity-curve-width-probe.usda, where two segments authored 0.24 units wide
# covered 128 pixels rather than the 2093 that world-space ribbons covered. So
# all four prims must emit the same line geometry: the authored widths have to
# reach the wire without changing which lines are drawn.
#
# The shape is asymmetric in both axes so a mirrored or transposed render cannot
# compare equal to a correct one.
def Xform "World"
{
    def BasisCurves "ConstantWidth"
    {
        double3 xformOp:translate = (-0.45, -0.45, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        uniform token type = "linear"
        uniform token basis = "bezier"
        uniform token wrap = "segmented"
        int[] curveVertexCounts = [2, 2]
        point3f[] points = [
            (-0.20, -0.15, 0), (0.15, 0.05, 0),
            (-0.15, 0.18, 0), (0.20, 0.08, 0)
        ]
        float[] widths = [0.05] (
            interpolation = "constant"
        )
        color3f[] primvars:displayColor = [(0.80, 0.35, 0.55)]
        uniform token primvars:displayColor:interpolation = "constant"
    }

    def BasisCurves "UniformWidth"
    {
        double3 xformOp:translate = (0.45, -0.45, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        uniform token type = "linear"
        uniform token basis = "bezier"
        uniform token wrap = "segmented"
        int[] curveVertexCounts = [2, 2]
        point3f[] points = [
            (-0.20, -0.15, 0), (0.15, 0.05, 0),
            (-0.15, 0.18, 0), (0.20, 0.08, 0)
        ]
        float[] widths = [0.05, 0.11] (
            interpolation = "uniform"
        )
        color3f[] primvars:displayColor = [(0.80, 0.35, 0.55)]
        uniform token primvars:displayColor:interpolation = "constant"
    }

    def BasisCurves "VaryingWidth"
    {
        double3 xformOp:translate = (-0.45, 0.45, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        uniform token type = "linear"
        uniform token basis = "bezier"
        uniform token wrap = "segmented"
        int[] curveVertexCounts = [2, 2]
        point3f[] points = [
            (-0.20, -0.15, 0), (0.15, 0.05, 0),
            (-0.15, 0.18, 0), (0.20, 0.08, 0)
        ]
        float[] widths = [0.02, 0.04, 0.08, 0.16] (
            interpolation = "varying"
        )
        color3f[] primvars:displayColor = [(0.80, 0.35, 0.55)]
        uniform token primvars:displayColor:interpolation = "constant"
    }

    def BasisCurves "VertexWidth"
    {
        double3 xformOp:translate = (0.45, 0.45, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        uniform token type = "linear"
        uniform token basis = "bezier"
        uniform token wrap = "segmented"
        int[] curveVertexCounts = [2, 2]
        point3f[] points = [
            (-0.20, -0.15, 0), (0.15, 0.05, 0),
            (-0.15, 0.18, 0), (0.20, 0.08, 0)
        ]
        float[] widths = [0.03, 0.06, 0.12, 0.24] (
            interpolation = "vertex"
        )
        color3f[] primvars:displayColor = [(0.80, 0.35, 0.55)]
        uniform token primvars:displayColor:interpolation = "constant"
    }
}
