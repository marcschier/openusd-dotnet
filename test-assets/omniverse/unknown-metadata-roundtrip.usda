#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World" (
    prepend apiSchemas = ["CollectionAPI:lightLink", "SyntheticVendorMetadataAPI"]
    customData = {
        string vendorTool = "synthetic-import-v1"
        int64 vendorRevision = 7
    }
)
{
    custom double custom:anchorWeight = 0.5
    custom token custom:anchorTag = "unknown-metadata-fixture"

    def Mesh "Anchor" (
        prepend apiSchemas = ["CollectionAPI:lightLink"]
        customData = {
            string vendorTool = "synthetic-import-v1"
        }
    )
    {
        custom int64 custom:vendorPartId = 42
        uniform bool doubleSided = 1
        uniform token subdivisionScheme = "none"
        point3f[] points = [
            (-0.5, -0.5, 0), (0.5, -0.5, 0), (0.5, 0.5, 0), (-0.5, 0.5, 0)
        ]
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 0, 2, 3]
    }
}
