<Project>

  <PropertyGroup>
    <_OpenUsdImagingWinX64ResourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../runtimes/win-x64/resources'))</_OpenUsdImagingWinX64ResourceRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'win-x64'">
    <_OpenUsdImagingMergedPluginResource
        Include="$(_OpenUsdImagingWinX64ResourceRoot)/plugin/usd/**/*"
        Exclude="$(_OpenUsdImagingWinX64ResourceRoot)/plugin/usd/plugInfo.json;$(_OpenUsdImagingWinX64ResourceRoot)/plugin/usd/hdSilk/resources/plugInfo.json" />
    <Content Include="$(_OpenUsdImagingWinX64ResourceRoot)/**/*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="@(_OpenUsdImagingMergedPluginResource)">
      <Link>usd/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
