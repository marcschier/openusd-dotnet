<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>OpenUsd.Runtime.Core.linux-x64</PackageId>
    <Description>OpenUSD core native runtime and data plugin resources for Linux x64.</Description>
    <PackageTags>openusd;usd;native;runtime;linux;x64</PackageTags>
    <RuntimePackageKind>Core</RuntimePackageKind>
    <RuntimePackageRid>linux-x64</RuntimePackageRid>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <!--
      Package validation compares managed lib/ref assemblies. This package suppresses build output and
      ships only native assets and buildTransitive targets, so the opt-out is intentional.
    -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <Import Project="../OpenUsd.Runtime.Packaging/OpenUsd.Runtime.Packaging.targets" />

</Project>
