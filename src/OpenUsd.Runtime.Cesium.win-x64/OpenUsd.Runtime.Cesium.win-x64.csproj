<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>OpenUsd.Runtime.Cesium.win-x64</PackageId>
    <Description>Quarantined cesium-native static libraries and headers for Windows x64.</Description>
    <PackageTags>openusd;usd;cesium;3d-tiles;native;runtime;windows;x64</PackageTags>
    <RuntimePackageKind>Cesium</RuntimePackageKind>
    <RuntimePackageRid>win-x64</RuntimePackageRid>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <EnablePackageValidation>false</EnablePackageValidation>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <Import Project="../OpenUsd.Runtime.Packaging/OpenUsd.Runtime.Cesium.Packaging.targets" />

</Project>
