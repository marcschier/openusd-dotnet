<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenUsd\OpenUsd.csproj" />
    <ProjectReference Include="..\OpenUsd.Physics\OpenUsd.Physics.csproj" />
    <ProjectReference Include="..\OpenUsd.Rendering\OpenUsd.Rendering.csproj" />
    <ProjectReference Include="..\OpenUsd.Rendering.Storm\OpenUsd.Rendering.Storm.csproj" />
    <ProjectReference Include="..\OpenUsd.Rendering.Silk.D3D12\OpenUsd.Rendering.Silk.D3D12.csproj" />
    <ProjectReference Include="..\OpenUsd.Rendering.Silk.Vulkan\OpenUsd.Rendering.Silk.Vulkan.csproj" />
    <ProjectReference Include="..\OpenUsd.Rendering.Silk.Metal\OpenUsd.Rendering.Silk.Metal.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>OpenUsd.Viewer</AssemblyName>
    <RootNamespace>OpenUsd.Viewer</RootNamespace>
    <!--
      The viewer shell stays classified as an application project so the strict
      production-library gates (AOT/trim analyzers, public-API tracking) are not
      applied to ~25k lines of Avalonia UI code. It is nevertheless packed, because
      hosts such as the OPC UA OpenUSD connector embed the viewport on a stage they
      own themselves. OpenUsd.Viewer.App is the thin desktop entry point.
    -->
    <IsApplicationProject>true</IsApplicationProject>
    <IsPackable>true</IsPackable>
    <Description>Avalonia viewport and inspector shell for OpenUSD stages, embeddable on a caller-owned stage scheduler.</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Wayland" />
  </ItemGroup>

</Project>
