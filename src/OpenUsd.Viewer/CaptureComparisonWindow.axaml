<Window
    x:Class="OpenUsd.Viewer.CaptureComparisonWindow"
    x:ClassModifier="internal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Classes="openusd-viewer"
    Title="Compare captures"
    AutomationProperties.Name="Compare saved Viewer captures"
    AutomationProperties.AutomationId="viewer.captureComparison"
    Width="1040"
    Height="700"
    MinWidth="600"
    MinHeight="360"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <StyleInclude Source="avares://OpenUsd.Viewer/ViewerStyles.axaml" />
  </Window.Styles>
  <Grid Margin="{DynamicResource ViewerDialogPadding}" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
    <TextBlock
        Text="Compare saved PNG or BMP captures. This does not render, edit a stage, or change its colour settings."
        Classes="viewer-secondary"
        TextWrapping="Wrap" />
    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
      <StackPanel Spacing="8">
        <Button x:Name="ChooseBeforeButton" Content="Choose before (A)..." />
        <TextBlock
            x:Name="BeforeName"
            Text="No before image"
            AutomationProperties.Name="Before capture"
            TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="8">
        <Button x:Name="ChooseAfterButton" Content="Choose after (B)..." />
        <TextBlock
            x:Name="AfterName"
            Text="No after image"
            AutomationProperties.Name="After capture"
            TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Grid>
    <Grid x:Name="ComparisonImages" Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
      <Border
          x:Name="BeforePane"
          Background="{DynamicResource ViewerSurfaceCanvasBrush}"
          BorderBrush="{DynamicResource ViewerBorderBrush}"
          BorderThickness="1">
        <Image x:Name="BeforeImage" Stretch="Uniform" AutomationProperties.Name="Before capture image" />
      </Border>
      <Border
          x:Name="AfterPane"
          Grid.Column="1"
          Background="{DynamicResource ViewerSurfaceCanvasBrush}"
          BorderBrush="{DynamicResource ViewerBorderBrush}"
          BorderThickness="1">
        <Image x:Name="AfterImage" Stretch="Uniform" AutomationProperties.Name="After capture image" />
      </Border>
    </Grid>
    <TextBlock
        x:Name="ComparisonStatus"
        Grid.Row="3"
        Text="Choose RGBA PNGs or uncompressed 24/32-bit BMPs; up to 64 MiB, 8192 pixels per side and 16 megapixels each."
        Classes="viewer-caption"
        TextWrapping="Wrap"
        AutomationProperties.Name="Capture comparison status" />
    <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
      <ComboBox
          x:Name="ComparisonMode"
          AutomationProperties.Name="Comparison display mode"
          SelectedIndex="0"
          IsEnabled="False">
        <ComboBoxItem Content="Side by side" />
        <ComboBoxItem Content="Before (A)" />
        <ComboBoxItem Content="After (B)" />
      </ComboBox>
      <Button x:Name="CompareAgainButton" Grid.Column="2" Content="Compare" IsEnabled="False" />
      <Button x:Name="CancelComparisonButton" Grid.Column="3" Content="Cancel loading" IsEnabled="False" />
      <Button x:Name="CloseComparisonButton" Grid.Column="4" Content="Close" />
    </Grid>
  </Grid>
</Window>
