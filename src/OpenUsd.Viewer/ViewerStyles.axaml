<Styles
    x:Class="OpenUsd.Viewer.ViewerStyles"
    x:ClassModifier="internal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="ViewerSurfaceCanvasColor">#E6E9EC</Color>
          <Color x:Key="ViewerSurfaceChromeColor">#F3F4F4</Color>
          <Color x:Key="ViewerSurfacePanelColor">#FAFAF8</Color>
          <Color x:Key="ViewerSurfaceRaisedColor">#FFFFFF</Color>
          <Color x:Key="ViewerTextPrimaryColor">#18262F</Color>
          <Color x:Key="ViewerTextSecondaryColor">#50616B</Color>
          <Color x:Key="ViewerTextDisabledColor">#63727A</Color>
          <Color x:Key="ViewerAccentColor">#096A85</Color>
          <Color x:Key="ViewerAccentHoverColor">#07566F</Color>
          <Color x:Key="ViewerAccentPressedColor">#06475B</Color>
          <Color x:Key="ViewerTextOnAccentColor">#FFFFFF</Color>
          <Color x:Key="ViewerSelectionColor">#D6EAF0</Color>
          <Color x:Key="ViewerTextSelectedColor">#123C4B</Color>
          <Color x:Key="ViewerBorderColor">#BBC7CC</Color>
          <Color x:Key="ViewerControlBorderColor">#7A8B94</Color>
          <Color x:Key="ViewerFocusColor">#007A99</Color>
          <Color x:Key="ViewerWarningColor">#8A5200</Color>
          <Color x:Key="ViewerErrorColor">#B32636</Color>
          <Color x:Key="ViewerSuccessColor">#21643E</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="ViewerSurfaceCanvasColor">#11171C</Color>
          <Color x:Key="ViewerSurfaceChromeColor">#192127</Color>
          <Color x:Key="ViewerSurfacePanelColor">#202A31</Color>
          <Color x:Key="ViewerSurfaceRaisedColor">#29353E</Color>
          <Color x:Key="ViewerTextPrimaryColor">#EDF2F4</Color>
          <Color x:Key="ViewerTextSecondaryColor">#B6C3CA</Color>
          <Color x:Key="ViewerTextDisabledColor">#94A5AE</Color>
          <Color x:Key="ViewerAccentColor">#59B9CE</Color>
          <Color x:Key="ViewerAccentHoverColor">#7CCADB</Color>
          <Color x:Key="ViewerAccentPressedColor">#42A3B8</Color>
          <Color x:Key="ViewerTextOnAccentColor">#0D252E</Color>
          <Color x:Key="ViewerSelectionColor">#244653</Color>
          <Color x:Key="ViewerTextSelectedColor">#E0F5FA</Color>
          <Color x:Key="ViewerBorderColor">#40515D</Color>
          <Color x:Key="ViewerControlBorderColor">#748A97</Color>
          <Color x:Key="ViewerFocusColor">#77D0E5</Color>
          <Color x:Key="ViewerWarningColor">#F5C477</Color>
          <Color x:Key="ViewerErrorColor">#FF9AA8</Color>
          <Color x:Key="ViewerSuccessColor">#8AD3AA</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <FontFamily x:Key="ViewerFontFamily">Segoe UI, SF Pro Text, Noto Sans, DejaVu Sans, $Default</FontFamily>
      <FontFamily x:Key="ViewerMonospaceFontFamily">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
      <x:Double x:Key="ViewerBodyFontSize">13</x:Double>
      <x:Double x:Key="ViewerCaptionFontSize">12</x:Double>
      <x:Double x:Key="ViewerHeadingFontSize">16</x:Double>
      <x:Double x:Key="ViewerControlHeight">28</x:Double>
      <x:Double x:Key="ViewerSpaceSmall">4</x:Double>
      <x:Double x:Key="ViewerSpaceMedium">8</x:Double>
      <x:Double x:Key="ViewerSpaceLarge">12</x:Double>
      <Thickness x:Key="ViewerControlPadding">12,4</Thickness>
      <Thickness x:Key="ViewerInputPadding">8,4</Thickness>
      <Thickness x:Key="ViewerPanelPadding">12</Thickness>
      <Thickness x:Key="ViewerChromePadding">12,8</Thickness>
      <Thickness x:Key="ViewerStatusPadding">12,4</Thickness>
      <Thickness x:Key="ViewerDialogPadding">16</Thickness>
      <CornerRadius x:Key="ViewerControlCornerRadius">4</CornerRadius>

      <!-- Fluent aliases are local to the opted-in Viewer surface, never Application.Styles. -->
      <Thickness x:Key="ButtonPadding">12,4</Thickness>
      <Thickness x:Key="TextControlThemePadding">8,4</Thickness>
      <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
      <x:Double x:Key="TextControlThemeMinHeight">28</x:Double>
      <Thickness x:Key="TabItemHeaderMargin">8,4</Thickness>
      <x:Double x:Key="TabItemHeaderFontSize">13</x:Double>
      <x:Double x:Key="TreeViewItemMinHeight">28</x:Double>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window.openusd-viewer">
    <Setter Property="Background" Value="{DynamicResource ViewerSurfaceChromeBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ViewerTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource ViewerFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ViewerBodyFontSize}" />
  </Style>
  <Style Selector=".openusd-viewer :is(TemplatedControl)">
    <Setter Property="FontFamily" Value="{DynamicResource ViewerFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ViewerBodyFontSize}" />
  </Style>
  <Style Selector=".openusd-viewer TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource ViewerFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ViewerBodyFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource ViewerTextPrimaryBrush}" />
  </Style>
  <Style Selector=".openusd-viewer Button, .openusd-viewer ComboBox, .openusd-viewer TextBox">
    <Setter Property="MinHeight" Value="{DynamicResource ViewerControlHeight}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ViewerControlCornerRadius}" />
  </Style>
  <Style Selector=".openusd-viewer Button">
    <Setter Property="Padding" Value="{DynamicResource ViewerControlPadding}" />
  </Style>
  <Style Selector=".openusd-viewer TextBox">
    <Setter Property="Padding" Value="{DynamicResource ViewerInputPadding}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource ViewerSelectionBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource ViewerTextSelectedBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ViewerTextPrimaryBrush}" />
  </Style>
  <Style Selector=".openusd-viewer CheckBox, .openusd-viewer RadioButton">
    <Setter Property="MinHeight" Value="{DynamicResource ViewerControlHeight}" />
  </Style>
  <Style Selector=".openusd-viewer TextBox.viewer-input-error">
    <Setter Property="Foreground" Value="{DynamicResource ViewerErrorBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ViewerErrorBrush}" />
  </Style>
  <Style Selector=".openusd-viewer TextBlock.viewer-heading">
    <Setter Property="FontSize" Value="{DynamicResource ViewerHeadingFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=".openusd-viewer TextBlock.viewer-secondary">
    <Setter Property="Foreground" Value="{DynamicResource ViewerTextSecondaryBrush}" />
  </Style>
  <Style Selector=".openusd-viewer TextBlock.viewer-caption">
    <Setter Property="FontSize" Value="{DynamicResource ViewerCaptionFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource ViewerTextSecondaryBrush}" />
  </Style>
  <Style Selector=".openusd-viewer TextBlock.viewer-monospace">
    <Setter Property="FontFamily" Value="{DynamicResource ViewerMonospaceFontFamily}" />
  </Style>
  <Style Selector=".openusd-viewer TextBlock.viewer-warning">
    <Setter Property="Foreground" Value="{DynamicResource ViewerWarningBrush}" />
  </Style>
  <Style Selector=".openusd-viewer TextBlock.viewer-error">
    <Setter Property="Foreground" Value="{DynamicResource ViewerErrorBrush}" />
  </Style>
  <Style Selector=".openusd-viewer Border.viewer-chrome">
    <Setter Property="Background" Value="{DynamicResource ViewerSurfaceChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ViewerBorderBrush}" />
    <Setter Property="Padding" Value="{DynamicResource ViewerChromePadding}" />
  </Style>
  <Style Selector=".openusd-viewer Border.viewer-panel">
    <Setter Property="Background" Value="{DynamicResource ViewerSurfacePanelBrush}" />
    <Setter Property="Padding" Value="{DynamicResource ViewerPanelPadding}" />
  </Style>
  <Style Selector=".openusd-viewer StackPanel.viewer-property-row">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector=".openusd-viewer Expander.viewer-property-details">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource ViewerSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ViewerBorderBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ViewerControlCornerRadius}" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style Selector=".openusd-viewer GridSplitter">
    <Setter Property="Background" Value="{DynamicResource ViewerSurfaceChromeBrush}" />
  </Style>
  <Style Selector=".openusd-viewer GridSplitter:pointerover, .openusd-viewer GridSplitter:focus-visible">
    <Setter Property="Background" Value="{DynamicResource ViewerFocusBrush}" />
  </Style>
  <Style Selector=".openusd-viewer Path.viewer-icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource ViewerTextPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=".openusd-viewer Button.accent Path.viewer-icon">
    <Setter Property="Stroke" Value="{DynamicResource ViewerTextOnAccentBrush}" />
  </Style>
  <Style Selector=".openusd-viewer Button:disabled Path.viewer-icon">
    <Setter Property="Stroke" Value="{DynamicResource ViewerTextDisabledBrush}" />
  </Style>
</Styles>
