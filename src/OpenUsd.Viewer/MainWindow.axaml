<Window
    x:Class="OpenUsd.Viewer.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenUsd.Viewer"
    AutomationProperties.Name="OpenUsd Viewer"
    Title="OpenUsd Viewer"
    Width="1440"
    Height="900"
    MinWidth="960"
    MinHeight="600">
  <Grid RowDefinitions="Auto,*,Auto,Auto">
    <Border
        Grid.Row="0"
        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
        BorderThickness="0,0,0,1"
        Padding="8">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
        <Grid
            x:Name="ViewerToolbarGrid"
            Grid.Row="0"
            ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
            ColumnSpacing="8">
          <Menu Grid.Column="0" VerticalAlignment="Center">
            <MenuItem Header="_File">
              <MenuItem
                  x:Name="OpenStageMenuItem"
                  AutomationProperties.Name="Open stage"
                  Header="_Open Stage..."
                  InputGesture="Ctrl+O" />
              <MenuItem
                  x:Name="ReloadStageMenuItem"
                  AutomationProperties.Name="Reload current stage"
                  Header="_Reload Stage"
                  InputGesture="Ctrl+R"
                  IsEnabled="False" />
              <MenuItem
                  x:Name="CaptureFrameMenuItem"
                  AutomationProperties.Name="Capture current frame"
                  Header="_Capture Frame..."
                  IsEnabled="False" />
              <Separator />
              <MenuItem x:Name="RecentStagesMenu" Header="Recent Stages" IsEnabled="False" />
              <Separator />
              <MenuItem
                  x:Name="FileExitMenuItem"
                  AutomationProperties.Name="Exit OpenUsd Viewer"
                  Header="E_xit" />
            </MenuItem>
            <MenuItem Header="_View">
              <MenuItem
                  x:Name="StagePanelMenuItem"
                  AutomationProperties.Name="Show stage panel"
                  Header="_Stage panel"
                  ToggleType="CheckBox"
                  IsChecked="True" />
              <MenuItem
                  x:Name="InspectorPanelMenuItem"
                  AutomationProperties.Name="Show inspector panel"
                  Header="_Inspector panel"
                  ToggleType="CheckBox"
                  IsChecked="True" />
              <MenuItem
                  x:Name="TimelineMenuItem"
                  AutomationProperties.Name="Show timeline"
                  Header="_Timeline"
                  ToggleType="CheckBox"
                  IsChecked="True" />
              <Separator />
              <MenuItem Header="Inspector _Tabs">
                <MenuItem
                    x:Name="DiagnosticsMenuItem"
                    AutomationProperties.Name="Show diagnostics tab"
                    Header="_Diagnostics tab"
                    ToggleType="CheckBox"
                    IsChecked="False" />
                <MenuItem
                    x:Name="HydraTabVisibleMenuItem"
                    AutomationProperties.Name="Show Hydra scene tab"
                    Header="_Hydra tab"
                    ToggleType="CheckBox"
                    IsChecked="False" />
                <MenuItem
                    x:Name="TfDebugTabVisibleMenuItem"
                    AutomationProperties.Name="Show TfDebug tab"
                    Header="_TfDebug tab"
                    ToggleType="CheckBox"
                    IsChecked="False" />
              </MenuItem>
              <MenuItem
                  x:Name="SnapTimelineCheckBox"
                  AutomationProperties.Name="Snap manual timeline changes to authored frames"
                  Header="Snap manual time changes to authored frames"
                  ToggleType="CheckBox"
                  IsChecked="False" />
              <Separator />
              <MenuItem
                  x:Name="ResetLayoutMenuItem"
                  AutomationProperties.Name="Reset the Viewer layout to its clean defaults"
                  Header="_Reset Layout" />
            </MenuItem>
            <MenuItem x:Name="RenderMenu" Header="_Render">
              <MenuItem Header="_Renderer">
                <MenuItem
                    x:Name="RenderRendererAutoMenuItem"
                    AutomationProperties.Name="Rendering backend: Automatic"
                    Header="Automatic"
                    ToggleType="Radio"
                    GroupName="render.renderer" />
                <MenuItem
                    x:Name="RenderRendererStormMenuItem"
                    AutomationProperties.Name="Rendering backend: Storm"
                    Header="Storm"
                    ToggleType="Radio"
                    GroupName="render.renderer" />
                <MenuItem
                    x:Name="RenderRendererD3D12MenuItem"
                    AutomationProperties.Name="Rendering backend: Direct3D 12"
                    Header="Direct3D 12"
                    ToggleType="Radio"
                    GroupName="render.renderer" />
                <MenuItem
                    x:Name="RenderRendererVulkanMenuItem"
                    AutomationProperties.Name="Rendering backend: Vulkan"
                    Header="Vulkan"
                    ToggleType="Radio"
                    GroupName="render.renderer" />
                <MenuItem
                    x:Name="RenderRendererMetalMenuItem"
                    AutomationProperties.Name="Rendering backend: Metal"
                    Header="Metal"
                    ToggleType="Radio"
                    GroupName="render.renderer" />
              </MenuItem>
              <MenuItem Header="_Draw Mode">
                <MenuItem
                    x:Name="RenderDrawModeWireframeMenuItem"
                    AutomationProperties.Name="Viewport draw mode: Wireframe"
                    Header="Wireframe"
                    ToggleType="Radio"
                    GroupName="render.drawMode" />
                <MenuItem
                    x:Name="RenderDrawModeWireframeOnSurfaceMenuItem"
                    AutomationProperties.Name="Viewport draw mode: Wireframe on surface"
                    Header="Wireframe on surface"
                    ToggleType="Radio"
                    GroupName="render.drawMode" />
                <MenuItem
                    x:Name="RenderDrawModeSmoothShadedMenuItem"
                    AutomationProperties.Name="Viewport draw mode: Smooth shaded"
                    Header="Smooth shaded"
                    ToggleType="Radio"
                    GroupName="render.drawMode" />
                <MenuItem
                    x:Name="RenderDrawModeFlatShadedMenuItem"
                    AutomationProperties.Name="Viewport draw mode: Flat shaded"
                    Header="Flat shaded"
                    ToggleType="Radio"
                    GroupName="render.drawMode" />
                <MenuItem
                    x:Name="RenderDrawModePointsMenuItem"
                    AutomationProperties.Name="Viewport draw mode: Points"
                    Header="Points"
                    ToggleType="Radio"
                    GroupName="render.drawMode" />
                <MenuItem
                    x:Name="RenderDrawModeGeomOnlyMenuItem"
                    AutomationProperties.Name="Viewport draw mode: Geom only"
                    Header="Geom only"
                    ToggleType="Radio"
                    GroupName="render.drawMode" />
                <MenuItem
                    x:Name="RenderDrawModeGeomFlatMenuItem"
                    AutomationProperties.Name="Viewport draw mode: Geom flat"
                    Header="Geom flat"
                    ToggleType="Radio"
                    GroupName="render.drawMode" />
                <MenuItem
                    x:Name="RenderDrawModeGeomSmoothMenuItem"
                    AutomationProperties.Name="Viewport draw mode: Geom smooth"
                    Header="Geom smooth"
                    ToggleType="Radio"
                    GroupName="render.drawMode" />
                <MenuItem
                    x:Name="RenderDrawModeHiddenSurfaceWireframeMenuItem"
                    AutomationProperties.Name="Viewport draw mode: Hidden surface wireframe"
                    Header="Hidden surface wireframe"
                    ToggleType="Radio"
                    GroupName="render.drawMode" />
              </MenuItem>
              <MenuItem Header="Render _Purposes">
                <MenuItem
                    x:Name="RenderPurposeDefaultMenuItem"
                    AutomationProperties.Name="Show default purpose"
                    Header="Default"
                    ToggleType="CheckBox"
                    IsChecked="True" />
                <MenuItem
                    x:Name="RenderPurposeProxyMenuItem"
                    AutomationProperties.Name="Show proxy purpose"
                    Header="Proxy"
                    ToggleType="CheckBox"
                    IsChecked="True" />
                <MenuItem
                    x:Name="RenderPurposeRenderMenuItem"
                    AutomationProperties.Name="Show render purpose"
                    Header="Render"
                    ToggleType="CheckBox"
                    IsChecked="True" />
                <MenuItem
                    x:Name="RenderPurposeGuideMenuItem"
                    AutomationProperties.Name="Show guide purpose"
                    Header="Guide"
                    ToggleType="CheckBox"
                    IsChecked="False" />
              </MenuItem>
              <MenuItem
                  x:Name="RenderSceneLightingMenuItem"
                  AutomationProperties.Name="Use scene lighting"
                  Header="Use scene lighting"
                  ToggleType="CheckBox"
                  IsChecked="True" />
              <MenuItem
                  x:Name="RenderSceneShadowsMenuItem"
                  AutomationProperties.Name="Use scene shadows"
                  Header="Use shadows"
                  ToggleType="CheckBox"
                  IsChecked="True" />
              <MenuItem
                  x:Name="RenderBackfaceCullingMenuItem"
                  AutomationProperties.Name="Cull backfaces"
                  Header="Cull backfaces"
                  ToggleType="CheckBox"
                  IsChecked="True" />
              <MenuItem
                  x:Name="RenderSceneMaterialsMenuItem"
                  AutomationProperties.Name="Use authored scene materials"
                  Header="Use scene materials"
                  ToggleType="CheckBox"
                  IsChecked="True" />
              <MenuItem Header="Colour _Management">
                <MenuItem
                    x:Name="RenderColorManagementEnabledMenuItem"
                    AutomationProperties.Name="Use OpenColorIO display transform"
                    Header="Use OpenColorIO display transform"
                    ToggleType="CheckBox"
                    IsChecked="False" />
                <Separator />
                <MenuItem
                    x:Name="RenderColorManagementChooseConfigMenuItem"
                    AutomationProperties.Name="Choose OpenColorIO config"
                    Header="Choose OpenColorIO _Config..." />
                <MenuItem
                    x:Name="RenderColorManagementClearConfigMenuItem"
                    AutomationProperties.Name="Clear OpenColorIO config"
                    Header="Clear OpenColorIO Config" />
              </MenuItem>
              <MenuItem Header="_Background Colour">
                <MenuItem
                    x:Name="RenderBackgroundColorBlackMenuItem"
                    AutomationProperties.Name="Viewport background colour: Black"
                    Header="Black"
                    ToggleType="Radio"
                    GroupName="render.backgroundColor" />
                <MenuItem
                    x:Name="RenderBackgroundColorDarkGrayMenuItem"
                    AutomationProperties.Name="Viewport background colour: Dark gray"
                    Header="Dark gray"
                    ToggleType="Radio"
                    GroupName="render.backgroundColor" />
                <MenuItem
                    x:Name="RenderBackgroundColorLightGrayMenuItem"
                    AutomationProperties.Name="Viewport background colour: Light gray"
                    Header="Light gray"
                    ToggleType="Radio"
                    GroupName="render.backgroundColor" />
                <MenuItem
                    x:Name="RenderBackgroundColorWhiteMenuItem"
                    AutomationProperties.Name="Viewport background colour: White"
                    Header="White"
                    ToggleType="Radio"
                    GroupName="render.backgroundColor" />
              </MenuItem>
            </MenuItem>
            <MenuItem Header="_Camera">
              <MenuItem
                  x:Name="ResetCameraAutomaticMenuItem"
                  AutomationProperties.Name="Reset camera to automatic"
                  Header="Reset _Automatic"
                  InputGesture="Home"
                  IsEnabled="False" />
              <MenuItem
                  x:Name="ResetCameraLegacyMenuItem"
                  AutomationProperties.Name="Use explicit legacy camera pose"
                  Header="Explicit _Legacy Pose"
                  IsEnabled="False" />
              <MenuItem
                  x:Name="ToggleCameraProjectionMenuItem"
                  AutomationProperties.Name="Toggle camera projection"
                  Header="Toggle _Projection"
                  InputGesture="P"
                  IsEnabled="False" />
              <MenuItem
                  x:Name="UseSelectedCameraMenuItem"
                  AutomationProperties.Name="Use selected UsdGeomCamera"
                  Header="_Use Selected Camera"
                  IsEnabled="False"
                  ToolTip.Tip="Select a UsdGeomCamera prim to use its authored camera." />
              <Separator x:Name="StageCameraMenuSeparator" IsVisible="False" />
              <MenuItem
                  x:Name="StageCamerasMenu"
                  AutomationProperties.Name="Stage-authored cameras"
                  Header="Stage _Cameras"
                  IsEnabled="False"
                  IsVisible="False" />
              <Separator />
              <MenuItem
                  x:Name="FrameSelectedMenuItem"
                  AutomationProperties.Name="Frame selected prim"
                  Header="_Frame Selected"
                  InputGesture="F"
                  IsEnabled="False" />
              <MenuItem Header="_Orbit">
                <MenuItem
                    x:Name="CameraOrbitLeftMenuItem"
                    AutomationProperties.Name="Orbit camera left"
                    Header="Orbit Left"
                    InputGesture="Left Arrow"
                    Tag="Left"
                    IsEnabled="False" />
                <MenuItem
                    x:Name="CameraOrbitRightMenuItem"
                    AutomationProperties.Name="Orbit camera right"
                    Header="Orbit Right"
                    InputGesture="Right Arrow"
                    Tag="Right"
                    IsEnabled="False" />
                <MenuItem
                    x:Name="CameraOrbitUpMenuItem"
                    AutomationProperties.Name="Orbit camera up"
                    Header="Orbit Up"
                    InputGesture="Up Arrow"
                    Tag="Up"
                    IsEnabled="False" />
                <MenuItem
                    x:Name="CameraOrbitDownMenuItem"
                    AutomationProperties.Name="Orbit camera down"
                    Header="Orbit Down"
                    InputGesture="Down Arrow"
                    Tag="Down"
                    IsEnabled="False" />
              </MenuItem>
            </MenuItem>
            <MenuItem x:Name="PhysicsMenu" Header="_Physics">
              <MenuItem
                  x:Name="PhysicsEnableButton"
                  AutomationProperties.Name="Enable physics simulation"
                  Header="_Physics" />
              <Separator />
              <MenuItem
                  x:Name="PhysicsPlayPauseMenuItem"
                  AutomationProperties.Name="Play or pause physics simulation"
                  Header="_Play/Pause"
                  InputGesture="K" />
              <MenuItem
                  x:Name="PhysicsStopMenuItem"
                  AutomationProperties.Name="Stop physics simulation"
                  Header="_Stop"
                  InputGesture="J" />
              <MenuItem
                  x:Name="PhysicsStepMenuItem"
                  AutomationProperties.Name="Step one physics frame"
                  Header="Ste_p"
                  InputGesture="N" />
              <MenuItem
                  x:Name="PhysicsLoopMenuItem"
                  AutomationProperties.Name="Loop physics playback"
                  Header="_Loop"
                  ToggleType="CheckBox" />
              <MenuItem Header="_Speed">
                <MenuItem
                    x:Name="PhysicsSpeedQuarterMenuItem"
                    AutomationProperties.Name="Physics playback speed: 0.25x"
                    Header="0.25x"
                    ToggleType="Radio"
                    GroupName="physics.speed" />
                <MenuItem
                    x:Name="PhysicsSpeedHalfMenuItem"
                    AutomationProperties.Name="Physics playback speed: 0.5x"
                    Header="0.5x"
                    ToggleType="Radio"
                    GroupName="physics.speed" />
                <MenuItem
                    x:Name="PhysicsSpeedNormalMenuItem"
                    AutomationProperties.Name="Physics playback speed: 1x"
                    Header="1x"
                    ToggleType="Radio"
                    GroupName="physics.speed"
                    IsChecked="True" />
                <MenuItem
                    x:Name="PhysicsSpeedDoubleMenuItem"
                    AutomationProperties.Name="Physics playback speed: 2x"
                    Header="2x"
                    ToggleType="Radio"
                    GroupName="physics.speed" />
                <MenuItem
                    x:Name="PhysicsSpeedQuadrupleMenuItem"
                    AutomationProperties.Name="Physics playback speed: 4x"
                    Header="4x"
                    ToggleType="Radio"
                    GroupName="physics.speed" />
              </MenuItem>
              <MenuItem
                  x:Name="PhysicsPreviewMenuItem"
                  AutomationProperties.Name="Apply physics preview to the session overlay"
                  Header="Apply Pre_view"
                  ToggleType="CheckBox" />
              <MenuItem
                  x:Name="PhysicsBakeButton"
                  AutomationProperties.Name="Bake physics simulation"
                  Header="_Bake..."
                  InputGesture="B" />
              <Separator />
              <MenuItem Header="_Gizmo">
                <MenuItem
                    x:Name="PhysicsGizmoNoneMenuItem"
                    AutomationProperties.Name="Physics manipulation gizmo: No Gizmo"
                    Header="No Gizmo"
                    InputGesture="Q"
                    ToggleType="Radio"
                    GroupName="physics.gizmo"
                    IsChecked="True" />
                <MenuItem
                    x:Name="PhysicsGizmoMoveMenuItem"
                    AutomationProperties.Name="Physics manipulation gizmo: Move"
                    Header="Move"
                    InputGesture="G"
                    ToggleType="Radio"
                    GroupName="physics.gizmo" />
                <MenuItem
                    x:Name="PhysicsGizmoRotateMenuItem"
                    AutomationProperties.Name="Physics manipulation gizmo: Rotate"
                    Header="Rotate"
                    InputGesture="E"
                    ToggleType="Radio"
                    GroupName="physics.gizmo" />
                <MenuItem
                    x:Name="PhysicsGizmoScaleMenuItem"
                    AutomationProperties.Name="Physics manipulation gizmo: Scale"
                    Header="Scale"
                    InputGesture="R"
                    ToggleType="Radio"
                    GroupName="physics.gizmo" />
                <MenuItem
                    x:Name="PhysicsGizmoDragMenuItem"
                    AutomationProperties.Name="Physics manipulation gizmo: Drag Body"
                    Header="Drag Body"
                    InputGesture="H"
                    ToggleType="Radio"
                    GroupName="physics.gizmo" />
              </MenuItem>
              <MenuItem
                  x:Name="PhysicsSnapMenuItem"
                  AutomationProperties.Name="Snap gizmo drags to increments"
                  Header="_Snap"
                  InputGesture="X"
                  ToggleType="CheckBox" />
              <Separator />
              <MenuItem
                  x:Name="PhysicsUndoButton"
                  AutomationProperties.Name="Undo the last physics property edit"
                  Header="_Undo"
                  InputGesture="Z"
                  IsEnabled="False" />
              <MenuItem
                  x:Name="PhysicsRedoButton"
                  AutomationProperties.Name="Redo the last undone physics property edit"
                  Header="_Redo"
                  InputGesture="Y"
                  IsEnabled="False" />
              <Separator />
              <MenuItem
                  x:Name="PhysicsShowInspectorMenuItem"
                  AutomationProperties.Name="Show the Physics inspector tab"
                  Header="Show Physics _Inspector" />
            </MenuItem>
            <MenuItem x:Name="ToolsMenu" Header="_Tools">
              <MenuItem
                  x:Name="ToolsValidationRunMenuItem"
                  AutomationProperties.Name="Refresh UsdValidation results"
                  Header="_Refresh Validation" />
              <MenuItem Header="Validation _Scope">
                <MenuItem
                    x:Name="ToolsValidationScopeStageMenuItem"
                    AutomationProperties.Name="UsdValidation scope: Whole stage"
                    Header="Whole stage"
                    ToggleType="Radio"
                    GroupName="tools.validationScope"
                    IsChecked="True" />
                <MenuItem
                    x:Name="ToolsValidationScopePrimMenuItem"
                    AutomationProperties.Name="UsdValidation scope: Selected prim"
                    Header="Selected prim"
                    ToggleType="Radio"
                    GroupName="tools.validationScope" />
              </MenuItem>
              <MenuItem Header="_Pick Mode">
                <MenuItem
                    x:Name="ToolsPickModePrimsMenuItem"
                    AutomationProperties.Name="usdview pick mode: Prims"
                    Header="Prims"
                    ToggleType="Radio"
                    GroupName="tools.pickMode"
                    IsChecked="True" />
                <MenuItem
                    x:Name="ToolsPickModeModelsMenuItem"
                    AutomationProperties.Name="usdview pick mode: Models"
                    Header="Models"
                    ToggleType="Radio"
                    GroupName="tools.pickMode" />
                <MenuItem
                    x:Name="ToolsPickModeInstancesMenuItem"
                    AutomationProperties.Name="usdview pick mode: Instances"
                    Header="Instances"
                    ToggleType="Radio"
                    GroupName="tools.pickMode" />
                <MenuItem
                    x:Name="ToolsPickModePrototypesMenuItem"
                    AutomationProperties.Name="usdview pick mode: Prototypes"
                    Header="Prototypes"
                    ToggleType="Radio"
                    GroupName="tools.pickMode" />
              </MenuItem>
              <MenuItem Header="Pick _Target">
                <MenuItem
                    x:Name="ToolsPickTargetPrimitiveMenuItem"
                    AutomationProperties.Name="Pick target: Prim"
                    Header="Prim"
                    ToggleType="Radio"
                    GroupName="tools.pickTarget"
                    IsChecked="True" />
                <MenuItem
                    x:Name="ToolsPickTargetFaceMenuItem"
                    AutomationProperties.Name="Pick target: Authored face"
                    Header="Face"
                    ToggleType="Radio"
                    GroupName="tools.pickTarget" />
                <MenuItem
                    x:Name="ToolsPickTargetEdgeMenuItem"
                    AutomationProperties.Name="Pick target: Authored edge"
                    Header="Edge"
                    ToggleType="Radio"
                    GroupName="tools.pickTarget" />
                <MenuItem
                    x:Name="ToolsPickTargetPointMenuItem"
                    AutomationProperties.Name="Pick target: Authored point"
                    Header="Point"
                    ToggleType="Radio"
                    GroupName="tools.pickTarget" />
              </MenuItem>
              <MenuItem Header="Se_lection Outline">
                <MenuItem
                    x:Name="ToolsSelectionVisibleOnlyMenuItem"
                    AutomationProperties.Name="Selection outline: Visible only"
                    Header="Visible only"
                    ToggleType="Radio"
                    GroupName="tools.selection"
                    IsChecked="True" />
                <MenuItem
                    x:Name="ToolsSelectionXRayMenuItem"
                    AutomationProperties.Name="Selection outline: X-ray through occluders"
                    Header="X-ray"
                    ToggleType="Radio"
                    GroupName="tools.selection" />
              </MenuItem>
              <Separator />
              <MenuItem Header="_Developer">
                <MenuItem Header="_Diagnostics">
                  <MenuItem
                      x:Name="ToolsDiagnosticsTabVisibleMenuItem"
                      AutomationProperties.Name="Show diagnostics tab"
                      Header="Show tab"
                      ToggleType="CheckBox"
                      IsChecked="False" />
                  <Separator />
                  <MenuItem
                      x:Name="ToolsCopyDiagnosticsMenuItem"
                      AutomationProperties.Name="Copy redacted diagnostics"
                      Header="_Copy"
                      IsEnabled="False" />
                  <MenuItem
                      x:Name="ToolsExportDiagnosticsMenuItem"
                      AutomationProperties.Name="Export redacted diagnostics"
                      Header="_Export..."
                      IsEnabled="False" />
                  <MenuItem
                      x:Name="ToolsIncludeDiagnosticPathsMenuItem"
                      AutomationProperties.Name="Include source and user paths in diagnostics"
                      Header="Include paths"
                      ToggleType="CheckBox" />
                </MenuItem>
                <MenuItem Header="_Hydra Scene">
                  <MenuItem
                      x:Name="ToolsHydraTabVisibleMenuItem"
                      AutomationProperties.Name="Show Hydra scene tab"
                      Header="Show tab"
                      ToggleType="CheckBox"
                      IsChecked="False" />
                  <Separator />
                  <MenuItem
                      x:Name="ToolsRefreshHydraSceneMenuItem"
                      AutomationProperties.Name="Refresh Hydra scene browser"
                      Header="_Refresh"
                      IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="Tf_Debug">
                  <MenuItem
                      x:Name="ToolsTfDebugTabVisibleMenuItem"
                      AutomationProperties.Name="Show TfDebug tab"
                      Header="Show tab"
                      ToggleType="CheckBox"
                      IsChecked="False" />
                  <Separator />
                  <MenuItem
                      x:Name="ToolsRefreshTfDebugMenuItem"
                      AutomationProperties.Name="Refresh TfDebug flags"
                      Header="_Refresh" />
                </MenuItem>
              </MenuItem>
              <Separator />
              <MenuItem Header="_Connections">
                <MenuItem
                    x:Name="ToolsOmniverseBridgeMenuItem"
                    AutomationProperties.Name="Connect to an Omniverse Bridge session"
                    Header="Omniverse _Bridge..."
                    IsEnabled="False"
                    IsVisible="False"
                    ToolTip.Tip="No Omniverse Bridge provider is installed or configured." />
              </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
              <MenuItem
                  x:Name="ShortcutsMenuItem"
                  AutomationProperties.Name="Show keyboard and mouse shortcuts"
                  Header="Keyboard _Shortcuts"
                  InputGesture="F1"
                  ToolTip.Tip="List the camera and navigation bindings (F1)." />
              <MenuItem
                  x:Name="AboutMenuItem"
                  AutomationProperties.Name="Show OpenUSD and Omniverse compatibility information"
                  Header="_About OpenUsd Viewer..." />
            </MenuItem>
          </Menu>
          <Button
              x:Name="OpenStageButton"
              Grid.Column="1"
              AutomationProperties.Name="Open stage"
              Content="_Open"
              ToolTip.Tip="Open a USD stage (Ctrl+O)" />
          <Button
              x:Name="ReloadStageButton"
              Grid.Column="2"
              AutomationProperties.Name="Reload current stage"
              Content="_Reload"
              IsEnabled="False"
              ToolTip.Tip="Reload the current stage (Ctrl+R)" />
          <ComboBox
              x:Name="RendererSelector"
              Grid.Column="3"
              Width="180"
              AutomationProperties.Name="Rendering backend"
              SelectedIndex="0"
              ToolTip.Tip="Select the rendering backend">
            <ComboBoxItem Content="Automatic" Tag="Auto" />
            <ComboBoxItem Content="Storm" Tag="Storm" />
            <ComboBoxItem Content="Direct3D 12" Tag="D3D12" />
            <ComboBoxItem Content="Vulkan" Tag="Vulkan" />
            <ComboBoxItem Content="Metal" Tag="Metal" />
          </ComboBox>
          <Button
              x:Name="FrameSelectedButton"
              Grid.Column="5"
              AutomationProperties.Name="Frame selected prim"
              Content="_Frame Selected"
              IsEnabled="False"
              ToolTip.Tip="Center and frame the selected prim at the current time (F)" />
        </Grid>
        <Grid
            x:Name="PhysicsToolbarGrid"
            Grid.Row="1"
            ColumnDefinitions="Auto,Auto,Auto,*,Auto"
            ColumnSpacing="8"
            ClipToBounds="False"
            IsVisible="False">
          <StackPanel
              x:Name="PhysicsCommandBar"
              Grid.Column="0"
              AutomationProperties.Name="Physics simulation controls"
              Orientation="Horizontal"
              Spacing="4"
              ClipToBounds="False">
            <Button
                x:Name="PhysicsPlayPauseButton"
                AutomationProperties.Name="Play physics simulation"
                Content="Play"
                IsEnabled="False"
                ToolTip.Tip="Play or pause the interactive simulation (K)" />
            <Button
                x:Name="PhysicsStopButton"
                AutomationProperties.Name="Stop physics simulation"
                Content="Stop"
                IsEnabled="False"
                ToolTip.Tip="Return the simulation to the authored start (J)" />
            <Button
                x:Name="PhysicsStepButton"
                AutomationProperties.Name="Step one physics frame"
                Content="Step"
                IsEnabled="False"
                ToolTip.Tip="Advance exactly one fixed simulation step (N)" />
          </StackPanel>
          <Button
              x:Name="PhysicsOverflowButton"
              Grid.Column="1"
              AutomationProperties.Name="More physics controls"
              Content="&#x22EF;"
              IsVisible="False"
              ToolTip.Tip="Physics controls that do not fit the current width" />
          <StackPanel
              x:Name="PhysicsBakeProgressPanel"
              Grid.Column="2"
              Orientation="Horizontal"
              Spacing="4"
              IsVisible="False"
              VerticalAlignment="Center">
            <ProgressBar
                x:Name="PhysicsBakeProgressBar"
                Width="120"
                AutomationProperties.Name="Physics bake progress"
                Minimum="0"
                Maximum="1"
                Value="0"
                VerticalAlignment="Center" />
            <Button
                x:Name="PhysicsBakeCancelButton"
                AutomationProperties.Name="Cancel the running physics bake"
                Content="Cancel Bake"
                IsEnabled="False"
                ToolTip.Tip="Stop the running bake and roll back everything it authored" />
          </StackPanel>
          <Slider
              x:Name="PhysicsScrubber"
              Grid.Column="3"
              MinWidth="120"
              AutomationProperties.Name="Physics simulation time code"
              IsEnabled="False"
              Minimum="0"
              Maximum="1"
              Value="0"
              ToolTip.Tip="Scrub the simulation between the authored start and end time codes" />
          <TextBlock
              x:Name="PhysicsStatus"
              Grid.Column="4"
              MaxWidth="360"
              AutomationProperties.Name="Physics simulation state"
              HorizontalAlignment="Right"
              TextTrimming="CharacterEllipsis"
              VerticalAlignment="Center"
              Text="Physics: off" />
        </Grid>
        <!--
          Controls whose selection/enabled state remains the single source of truth for
          existing viewport, physics, pick-mode, and validation logic, but which are no longer
          shown directly: the menu items above are the reachable UI and drive these by setting
          their SelectedIndex/IsChecked, which raises the same SelectionChanged/Click events the
          existing handlers already subscribe to. Hidden controls are excluded from tab order and
          automation traversal, so no distinct route or focus stop is left behind for them.
        -->
        <StackPanel x:Name="LegacyStateHost" Grid.Row="0" IsVisible="False">
          <ComboBox
              x:Name="PickModeSelector"
              AutomationProperties.Name="usdview pick mode"
              SelectedIndex="0">
            <ComboBoxItem Content="Prims" Tag="Prims" />
            <ComboBoxItem Content="Models" Tag="Models" />
            <ComboBoxItem Content="Instances" Tag="Instances" />
            <ComboBoxItem Content="Prototypes" Tag="Prototypes" />
          </ComboBox>
          <ComboBox
              x:Name="ViewportDrawModeSelector"
              AutomationProperties.Name="Viewport draw mode"
              IsEnabled="False"
              SelectedIndex="0">
            <ComboBoxItem Content="Wireframe" Tag="Wireframe" />
            <ComboBoxItem Content="Wireframe on surface" Tag="WireframeOnSurface" />
            <ComboBoxItem Content="Smooth shaded" Tag="SmoothShaded" />
            <ComboBoxItem Content="Flat shaded" Tag="FlatShaded" />
            <ComboBoxItem Content="Points" Tag="Points" />
            <ComboBoxItem Content="Geom only" Tag="GeomOnly" />
            <ComboBoxItem Content="Geom flat" Tag="GeomFlat" />
            <ComboBoxItem Content="Geom smooth" Tag="GeomSmooth" />
            <ComboBoxItem Content="Hidden surface wireframe" Tag="HiddenSurfaceWireframe" />
          </ComboBox>
          <CheckBox
              x:Name="PurposeDefaultCheckBox"
              AutomationProperties.Name="Show default purpose"
              Content="Default"
              IsChecked="True"
              IsEnabled="False" />
          <CheckBox
              x:Name="PurposeProxyCheckBox"
              AutomationProperties.Name="Show proxy purpose"
              Content="Proxy"
              IsChecked="True"
              IsEnabled="False" />
          <CheckBox
              x:Name="PurposeRenderCheckBox"
              AutomationProperties.Name="Show render purpose"
              Content="Render"
              IsChecked="True"
              IsEnabled="False" />
          <CheckBox
              x:Name="PurposeGuideCheckBox"
              AutomationProperties.Name="Show guide purpose"
              Content="Guide"
              IsEnabled="False" />
          <CheckBox
              x:Name="SceneLightingCheckBox"
              AutomationProperties.Name="Use scene lighting"
              Content="Use scene lighting"
              IsChecked="True"
              IsEnabled="False" />
          <CheckBox
              x:Name="SceneShadowsCheckBox"
              AutomationProperties.Name="Use scene shadows"
              Content="Use shadows"
              IsChecked="True"
              IsEnabled="False" />
          <CheckBox
              x:Name="BackfaceCullingCheckBox"
              AutomationProperties.Name="Cull backfaces"
              Content="Cull backfaces"
              IsChecked="True"
              IsEnabled="False" />
          <CheckBox
              x:Name="SceneMaterialsCheckBox"
              AutomationProperties.Name="Use authored scene materials"
              Content="Use scene materials"
              IsChecked="True"
              IsEnabled="False" />
          <ComboBox
              x:Name="BackgroundColorSelector"
              AutomationProperties.Name="Viewport background colour"
              IsEnabled="False"
              SelectedIndex="0">
            <ComboBoxItem Content="Black" Tag="Black" />
            <ComboBoxItem Content="Dark gray" Tag="DarkGray" />
            <ComboBoxItem Content="Light gray" Tag="LightGray" />
            <ComboBoxItem Content="White" Tag="White" />
          </ComboBox>
          <ComboBox
              x:Name="PhysicsSpeedSelector"
              AutomationProperties.Name="Physics playback speed"
              IsEnabled="False"
              SelectedIndex="2">
            <ComboBoxItem Content="0.25x" Tag="0.25" />
            <ComboBoxItem Content="0.5x" Tag="0.5" />
            <ComboBoxItem Content="1x" Tag="1" />
            <ComboBoxItem Content="2x" Tag="2" />
            <ComboBoxItem Content="4x" Tag="4" />
          </ComboBox>
          <ComboBox
              x:Name="PhysicsGizmoSelector"
              AutomationProperties.Name="Physics manipulation gizmo"
              IsEnabled="False"
              SelectedIndex="0">
            <ComboBoxItem Content="No Gizmo" Tag="None" />
            <ComboBoxItem Content="Move" Tag="Translate" />
            <ComboBoxItem Content="Rotate" Tag="Rotate" />
            <ComboBoxItem Content="Scale" Tag="Scale" />
            <ComboBoxItem Content="Drag Body" Tag="Drag" />
          </ComboBox>
          <CheckBox
              x:Name="PhysicsLoopCheckBox"
              AutomationProperties.Name="Loop physics playback"
              Content="Loop"
              IsEnabled="False" />
          <CheckBox
              x:Name="PhysicsPreviewCheckBox"
              AutomationProperties.Name="Apply physics preview to the session overlay"
              Content="Apply Preview"
              IsEnabled="False" />
          <CheckBox
              x:Name="PhysicsSnapCheckBox"
              AutomationProperties.Name="Snap gizmo drags to increments"
              Content="Snap"
              IsEnabled="False" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="MainContentGrid" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>
      <Border x:Name="StagePanel" Grid.Column="0" Padding="8">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="Stage" />
          <TextBlock
              x:Name="StageIdentity"
              Grid.Row="1"
              Margin="0,6,0,0"
              AutomationProperties.Name="Stage identity"
              Text="Identity: —"
              TextWrapping="Wrap" />
          <TextBlock
              x:Name="StageStatistics"
              Grid.Row="2"
              Margin="0,4,0,0"
              AutomationProperties.Name="Stage statistics"
              Text="Statistics: —"
              TextWrapping="Wrap" />
          <TextBox
              x:Name="HierarchyFilter"
              Grid.Row="3"
              Margin="0,8,0,0"
              AutomationProperties.Name="Filter stage hierarchy by name"
              PlaceholderText="Filter paths or names"
              ToolTip.Tip="Matching prims and their ancestors remain visible" />
          <TextBox
              x:Name="HierarchyTypeFilter"
              Grid.Row="4"
              Margin="0,6,0,0"
              AutomationProperties.Name="Filter stage hierarchy by type"
              PlaceholderText="Filter by prim type"
              ToolTip.Tip="Filter by composed prim type, such as Xform, Mesh, or Scope" />
          <StackPanel Grid.Row="5" Margin="0,6,0,0" Orientation="Horizontal" Spacing="6">
            <TextBlock VerticalAlignment="Center" Text="Expand depth" />
            <TextBox
                x:Name="HierarchyExpandDepthInput"
                Width="60"
                AutomationProperties.Name="Expand stage hierarchy to depth"
                Text="0"
                ToolTip.Tip="Enter 0 for lazy roots, or a non-negative depth to expand descendants" />
          </StackPanel>
          <WrapPanel Grid.Row="6" Margin="0,6,0,0">
            <CheckBox
                x:Name="ShowInactivePrimsCheckBox"
                Content="Inactive"
                AutomationProperties.Name="Show inactive prims in hierarchy"
                ToolTip.Tip="Show inactive prims that are present in the composed hierarchy" />
            <CheckBox
                x:Name="ShowUndefinedPrimsCheckBox"
                Margin="8,0,0,0"
                Content="Undefined"
                AutomationProperties.Name="Show undefined prims in hierarchy"
                ToolTip.Tip="Show prims without a composed type name" />
            <CheckBox
                x:Name="ShowAbstractPrimsCheckBox"
                Margin="8,0,0,0"
                Content="Abstract"
                AutomationProperties.Name="Show abstract prims in hierarchy"
                ToolTip.Tip="Reserved for native abstract-prim classification when available" />
            <CheckBox
                x:Name="ShowPrototypePrimsCheckBox"
                Margin="8,0,0,0"
                Content="Prototypes"
                AutomationProperties.Name="Show prototype prims in hierarchy"
                ToolTip.Tip="Show prototype roots produced by instancing" />
          </WrapPanel>
          <TextBlock
              x:Name="HierarchyState"
              Grid.Row="7"
              Margin="0,8,0,0"
              AutomationProperties.Name="Stage hierarchy state"
              Text="Open or drop a USD stage to inspect its prims."
              TextWrapping="Wrap" />
          <TreeView
              x:Name="StageHierarchy"
              Grid.Row="8"
              Margin="0,8,0,0"
              AutomationProperties.Name="Stage hierarchy"
              IsVisible="False" />
        </Grid>
      </Border>

      <GridSplitter
          x:Name="StagePanelSplitter"
          Grid.Column="1"
          AutomationProperties.Name="Resize stage panel"
          ResizeDirection="Columns" />

      <Border
          Grid.Column="2"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
          BorderThickness="1">
        <local:RendererSwitchingViewport
            x:Name="ViewportHost"
            AutomationProperties.Name="Rendered stage viewport" />
      </Border>

      <GridSplitter
          x:Name="InspectorPanelSplitter"
          Grid.Column="3"
          AutomationProperties.Name="Resize inspector panel"
          ResizeDirection="Columns" />

      <Border x:Name="InspectorPanel" Grid.Column="4" Padding="8">
        <TabControl
            x:Name="InspectorTabs"
            AutomationProperties.Name="Stage details tabs"
            SelectedIndex="0">
          <TabItem x:Name="PropertiesTab" Header="_Properties">
            <ScrollViewer Margin="0,8,0,0">
              <StackPanel
                  x:Name="InspectorRows"
                  AutomationProperties.Name="Selected prim properties, variants, payloads, and session controls"
                  Spacing="6">
                <TextBlock
                    x:Name="InspectorState"
                    Text="Select a prim to inspect metadata and attributes."
                    TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem x:Name="ValueTab" Header="_Value">
            <ScrollViewer Margin="0,8,0,0">
              <StackPanel
                  x:Name="ValueRows"
                  AutomationProperties.Name="Selected prim attribute values and time samples"
                  Spacing="6">
                <TextBlock
                    Text="Select a prim to inspect attribute values and samples."
                    TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem x:Name="MetadataTab" Header="_Metadata">
            <ScrollViewer Margin="0,8,0,0">
              <StackPanel
                  x:Name="MetadataRows"
                  AutomationProperties.Name="Selected prim metadata, variants, payloads, and relationships"
                  Spacing="6">
                <TextBlock
                    Text="Select a prim to inspect metadata."
                    TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem x:Name="CompositionTab" Header="_Composition">
            <ScrollViewer Margin="0,8,0,0">
              <StackPanel
                  x:Name="CompositionRows"
                  AutomationProperties.Name="Selected prim Pcp composition"
                  Spacing="6">
                <TextBlock
                    Text="Select a prim to inspect its Pcp prim index."
                    TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem x:Name="LayersTab" Header="_LayerStack">
            <Grid Margin="0,8,0,0" RowDefinitions="Auto,Auto,Auto,Auto,*">
              <TextBlock
                  x:Name="LayerEditTarget"
                  AutomationProperties.Name="Current edit target"
                  Text="Edit target: —"
                  TextWrapping="Wrap" />
              <StackPanel Grid.Row="1" Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="SetSessionEditTargetButton"
                    AutomationProperties.Name="Use session layer for edits"
                    Content="Edit _Session"
                    IsEnabled="False" />
                <Button
                    x:Name="SetRootEditTargetButton"
                    AutomationProperties.Name="Explicitly enable in-memory root layer edits"
                    Content="Enable _Root Edits"
                    IsEnabled="False" />
              </StackPanel>
              <TextBlock
                  x:Name="RootEditWarning"
                  Grid.Row="2"
                  Margin="0,8,0,0"
                  AutomationProperties.Name="Root edit policy"
                  Text="Prim controls author to the session layer by default. Root edits require the explicit button above and are never saved automatically."
                  TextWrapping="Wrap" />
              <TextBlock
                  x:Name="LayersState"
                  Grid.Row="3"
                  Margin="0,8,0,0"
                  Text="Open a USD stage to inspect its local layer stack."
                  TextWrapping="Wrap" />
              <ScrollViewer Grid.Row="4" Margin="0,8,0,0">
                <StackPanel x:Name="LayersRows" Spacing="8" />
              </ScrollViewer>
            </Grid>
          </TabItem>
          <TabItem x:Name="DiagnosticsTab" Header="_Diagnostics" IsVisible="False">
            <Grid Margin="0,8,0,0" RowDefinitions="Auto,Auto,*">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="CopyDiagnosticsButton"
                    AutomationProperties.Name="Copy redacted diagnostics"
                    Content="_Copy"
                    IsEnabled="False" />
                <Button
                    x:Name="ExportDiagnosticsButton"
                    AutomationProperties.Name="Export redacted diagnostics"
                    Content="_Export..."
                    IsEnabled="False" />
                <CheckBox
                    x:Name="IncludeDiagnosticPathsCheckBox"
                    AutomationProperties.Name="Include source and user paths in diagnostics"
                    Content="Include paths" />
              </StackPanel>
              <TextBlock
                  x:Name="DiagnosticsState"
                  Grid.Row="1"
                  Margin="0,8,0,0"
                  Text="Diagnostics are sampled from normal rendering at a bounded cadence."
                  TextWrapping="Wrap" />
              <TextBox
                  x:Name="DiagnosticsText"
                  Grid.Row="2"
                  Margin="0,8,0,0"
                  AutomationProperties.Name="Latest viewer diagnostics"
                  AcceptsReturn="True"
                  IsReadOnly="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Text="No diagnostics have been sampled."
                  TextWrapping="NoWrap" />
            </Grid>
          </TabItem>
          <TabItem x:Name="ValidationTab" Header="_Validation">
            <Grid Margin="0,8,0,0" RowDefinitions="Auto,Auto,*">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="RefreshValidationButton"
                    AutomationProperties.Name="Refresh UsdValidation results"
                    Content="_Refresh"
                    IsEnabled="False" />
                <TextBlock
                    VerticalAlignment="Center"
                    Text="Scope:" />
                <ComboBox
                    x:Name="ValidationScopeSelector"
                    AutomationProperties.Name="UsdValidation scope"
                    IsEnabled="False"
                    MinWidth="160"
                    SelectedIndex="0">
                  <ComboBoxItem Content="Whole stage" Tag="Stage" />
                  <ComboBoxItem Content="Selected prim" Tag="Prim" />
                </ComboBox>
              </StackPanel>
              <TextBlock
                  x:Name="ValidationState"
                  Grid.Row="1"
                  Margin="0,8,0,0"
                  Text="Open a USD stage to run UsdValidation."
                  TextWrapping="Wrap" />
              <TextBox
                  x:Name="ValidationText"
                  Grid.Row="2"
                  Margin="0,8,0,0"
                  AutomationProperties.Name="UsdValidation results"
                  AcceptsReturn="True"
                  IsReadOnly="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Text="No validation results."
                  TextWrapping="NoWrap" />
            </Grid>
          </TabItem>
          <TabItem x:Name="HydraSceneTab" Header="_Hydra" IsVisible="False">
            <Grid Margin="0,8,0,0" RowDefinitions="Auto,Auto,*">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="RefreshHydraSceneButton"
                    AutomationProperties.Name="Refresh Hydra scene browser"
                    Content="_Refresh"
                    IsEnabled="False" />
              </StackPanel>
              <TextBlock
                  x:Name="HydraSceneState"
                  Grid.Row="1"
                  Margin="0,8,0,0"
                  Text="Render an hdSilk frame to inspect the Hydra scene command snapshot."
                  TextWrapping="Wrap" />
              <TextBox
                  x:Name="HydraSceneText"
                  Grid.Row="2"
                  Margin="0,8,0,0"
                  AutomationProperties.Name="Hydra scene browser"
                  AcceptsReturn="True"
                  IsReadOnly="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Text="No Hydra scene snapshot."
                  TextWrapping="NoWrap" />
            </Grid>
          </TabItem>
          <TabItem x:Name="PhysicsTab" Header="P_hysics">
            <ScrollViewer Margin="0,8,0,0">
              <StackPanel Spacing="8">
                <TextBlock
                    x:Name="PhysicsInspectorState"
                    AutomationProperties.Name="Physics simulation status"
                    Text="Enable physics for this stage to inspect its simulation."
                    TextWrapping="Wrap" />
                <TextBlock Text="Capabilities" FontWeight="SemiBold" />
                <ItemsControl
                    x:Name="PhysicsCapabilityRows"
                    AutomationProperties.Name="Physics capability matrix">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ViewerPhysicsCapabilityRow">
                      <Grid ColumnDefinitions="160,80,*" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding StatusText}"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{Binding Detail}"
                            Opacity="0.75"
                            TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Diagnostics" FontWeight="SemiBold" />
                <ItemsControl
                    x:Name="PhysicsDiagnosticRows"
                    AutomationProperties.Name="Physics diagnostics">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ViewerPhysicsDiagnosticRow">
                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Simulated objects" FontWeight="SemiBold" />
                <ItemsControl
                    x:Name="PhysicsObjectRows"
                    AutomationProperties.Name="Simulated physics objects">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ViewerPhysicsObjectRow">
                      <Grid ColumnDefinitions="*,120" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="{Binding Path}" TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding StatusText}"
                            Opacity="0.75"
                            TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Authoring" FontWeight="SemiBold" />
                <TextBlock
                    x:Name="PhysicsAuthoringState"
                    AutomationProperties.Name="Physics authoring status"
                    Text="Enable physics for this stage to author its simulation inputs."
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button
                      x:Name="PhysicsRefreshPropertiesButton"
                      AutomationProperties.Name="Reload physics properties"
                      Content="Reload Properties"
                      IsEnabled="False"
                      ToolTip.Tip="Re-extract every physics object and its properties" />
                  <ComboBox
                      x:Name="PhysicsObjectSelector"
                      Width="200"
                      AutomationProperties.Name="Physics object to author"
                      IsEnabled="False"
                      ToolTip.Tip="Choose the extracted object whose properties are listed" />
                </StackPanel>
                <ListBox
                    x:Name="PhysicsPropertyList"
                    Height="180"
                    AutomationProperties.Name="Physics properties"
                    IsEnabled="False">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:ViewerPhysicsPropertyRow">
                      <Grid ColumnDefinitions="180,*,110" Margin="0,0,0,2">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding ValueText}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{Binding StatusText}"
                            Opacity="0.75"
                            TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock
                    x:Name="PhysicsPropertyDetail"
                    AutomationProperties.Name="Physics property description"
                    Text="Select a property to author it."
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBox
                      x:Name="PhysicsPropertyValueBox"
                      Width="200"
                      AutomationProperties.Name="Physics property value"
                      IsEnabled="False"
                      ToolTip.Tip="The value authored into the session overlay's user layer" />
                  <ComboBox
                      x:Name="PhysicsPropertyTokenSelector"
                      Width="160"
                      AutomationProperties.Name="Physics property token"
                      IsEnabled="False"
                      IsVisible="False"
                      ToolTip.Tip="Choose one of the tokens the schema declares" />
                  <Button
                      x:Name="PhysicsApplyPropertyButton"
                      AutomationProperties.Name="Author the physics property"
                      Content="Apply"
                      IsEnabled="False"
                      ToolTip.Tip="Author this value into the session overlay's user layer" />
                  <Button
                      x:Name="PhysicsClearPropertyButton"
                      AutomationProperties.Name="Clear the authored physics property"
                      Content="Clear"
                      IsEnabled="False"
                      ToolTip.Tip="Remove the opinion this inspector authored" />
                </StackPanel>
                <TextBlock Text="Interaction" FontWeight="SemiBold" />
                <TextBlock
                    x:Name="PhysicsInteractionState"
                    AutomationProperties.Name="Physics interaction status"
                    Text="Enable physics and select a simulated object to drive it."
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBox
                      x:Name="PhysicsForceDirectionBox"
                      Width="140"
                      AutomationProperties.Name="Force direction"
                      Text="0 1 0"
                      IsEnabled="False"
                      ToolTip.Tip="Direction the force or impulse acts in, in stage space" />
                  <TextBox
                      x:Name="PhysicsForceMagnitudeBox"
                      Width="90"
                      AutomationProperties.Name="Force magnitude"
                      Text="10"
                      IsEnabled="False"
                      ToolTip.Tip="Magnitude of the force or impulse" />
                  <ComboBox
                      x:Name="PhysicsForceModeSelector"
                      Width="140"
                      AutomationProperties.Name="Force mode"
                      IsEnabled="False"
                      SelectedIndex="0"
                      ToolTip.Tip="How the value is integrated by the solver">
                    <ComboBoxItem Content="Force" Tag="Default" />
                    <ComboBoxItem Content="Acceleration" Tag="Acceleration" />
                    <ComboBoxItem Content="Velocity Change" Tag="VelocityChange" />
                  </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button
                      x:Name="PhysicsApplyForceButton"
                      AutomationProperties.Name="Apply a force to the selected body"
                      Content="Force"
                      IsEnabled="False"
                      ToolTip.Tip="Apply a continuous force on the next simulation step" />
                  <Button
                      x:Name="PhysicsApplyImpulseButton"
                      AutomationProperties.Name="Apply an impulse to the selected body"
                      Content="Impulse"
                      IsEnabled="False"
                      ToolTip.Tip="Apply an instantaneous impulse on the next simulation step" />
                  <Button
                      x:Name="PhysicsApplyTorqueButton"
                      AutomationProperties.Name="Apply a torque to the selected body"
                      Content="Torque"
                      IsEnabled="False"
                      ToolTip.Tip="Apply a continuous torque on the next simulation step" />
                  <Button
                      x:Name="PhysicsWakeButton"
                      AutomationProperties.Name="Wake the selected body"
                      Content="Wake"
                      IsEnabled="False"
                      ToolTip.Tip="Wake the selected body on the next simulation step" />
                  <Button
                      x:Name="PhysicsSleepButton"
                      AutomationProperties.Name="Put the selected body to sleep"
                      Content="Sleep"
                      IsEnabled="False"
                      ToolTip.Tip="Put the selected body to sleep on the next simulation step" />
                </StackPanel>
                <TextBlock Text="Character controller" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <CheckBox
                      x:Name="PhysicsControllerDriveCheckBox"
                      AutomationProperties.Name="Drive the selected character controller"
                      Content="Drive with WASD"
                      IsEnabled="False"
                      ToolTip.Tip="Move the selected controller with the movement keys" />
                  <TextBox
                      x:Name="PhysicsControllerSpeedBox"
                      Width="90"
                      AutomationProperties.Name="Character controller speed"
                      Text="2"
                      IsEnabled="False"
                      ToolTip.Tip="Speed in stage linear units per second" />
                </StackPanel>
                <TextBlock Text="Vehicle" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Throttle" />
                  <Slider
                      x:Name="PhysicsVehicleThrottleSlider"
                      Grid.Row="0"
                      Grid.Column="1"
                      AutomationProperties.Name="Vehicle throttle"
                      IsEnabled="False"
                      Minimum="0"
                      Maximum="1"
                      Value="0" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Brake" />
                  <Slider
                      x:Name="PhysicsVehicleBrakeSlider"
                      Grid.Row="1"
                      Grid.Column="1"
                      AutomationProperties.Name="Vehicle brake"
                      IsEnabled="False"
                      Minimum="0"
                      Maximum="1"
                      Value="0" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Steer" />
                  <Slider
                      x:Name="PhysicsVehicleSteerSlider"
                      Grid.Row="2"
                      Grid.Column="1"
                      AutomationProperties.Name="Vehicle steering"
                      IsEnabled="False"
                      Minimum="-1"
                      Maximum="1"
                      Value="0" />
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Hand brake" />
                  <Slider
                      x:Name="PhysicsVehicleHandBrakeSlider"
                      Grid.Row="3"
                      Grid.Column="1"
                      AutomationProperties.Name="Vehicle hand brake"
                      IsEnabled="False"
                      Minimum="0"
                      Maximum="1"
                      Value="0" />
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="Clutch" />
                  <Slider
                      x:Name="PhysicsVehicleClutchSlider"
                      Grid.Row="4"
                      Grid.Column="1"
                      AutomationProperties.Name="Vehicle clutch"
                      IsEnabled="False"
                      Minimum="0"
                      Maximum="1"
                      Value="0" />
                  <TextBlock Grid.Row="5" Grid.Column="0" Text="Gear" />
                  <ComboBox
                      x:Name="PhysicsVehicleGearSelector"
                      Grid.Row="5"
                      Grid.Column="1"
                      AutomationProperties.Name="Vehicle gear"
                      IsEnabled="False"
                      SelectedIndex="0"
                      ToolTip.Tip="Gear 0 leaves the choice to the drivetrain">
                    <ComboBoxItem Content="Automatic" Tag="0" />
                    <ComboBoxItem Content="Reverse" Tag="1" />
                    <ComboBoxItem Content="Neutral" Tag="2" />
                    <ComboBoxItem Content="First" Tag="3" />
                    <ComboBoxItem Content="Second" Tag="4" />
                    <ComboBoxItem Content="Third" Tag="5" />
                    <ComboBoxItem Content="Fourth" Tag="6" />
                  </ComboBox>
                </Grid>
                <CheckBox
                    x:Name="PhysicsVehicleDriveCheckBox"
                    AutomationProperties.Name="Drive the selected vehicle"
                    Content="Send vehicle input every step"
                    IsEnabled="False"
                    ToolTip.Tip="Submit the throttle, brake, steering, and gear on every step" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem x:Name="TfDebugTab" Header="_TfDebug" IsVisible="False">
            <Grid Margin="0,8,0,0" RowDefinitions="Auto,Auto,*">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="RefreshTfDebugButton"
                    AutomationProperties.Name="Refresh TfDebug flags"
                    Content="_Refresh" />
              </StackPanel>
              <TextBlock
                  x:Name="TfDebugState"
                  Grid.Row="1"
                  Margin="0,8,0,0"
                  Text="Refresh to list OpenUSD TfDebug symbols."
                  TextWrapping="Wrap" />
              <ScrollViewer Grid.Row="2" Margin="0,8,0,0">
                <StackPanel
                    x:Name="TfDebugRows"
                    AutomationProperties.Name="TfDebug flags"
                    Spacing="6" />
              </ScrollViewer>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>

    <Border
        x:Name="TimelinePanel"
        Grid.Row="2"
        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
        BorderThickness="0,1,0,0"
        Padding="8,6">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
        <Button
            x:Name="PlayPauseButton"
            AutomationProperties.Name="Play timeline"
            Content="_Play"
            IsEnabled="False"
            ToolTip.Tip="Play or pause the authored timeline (Space)" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock VerticalAlignment="Center" Text="Time" />
          <TextBox
              x:Name="CurrentTimeInput"
              Width="110"
              AutomationProperties.Name="Current time code"
              IsEnabled="False"
              ToolTip.Tip="Enter an invariant numeric USD time code" />
        </StackPanel>
        <TextBlock
            x:Name="TimelineStart"
            Grid.Column="2"
            VerticalAlignment="Center"
            Text="Start: —" />
        <Slider
            x:Name="TimelineSlider"
            Grid.Column="3"
            AutomationProperties.Name="Timeline time code"
            IsEnabled="False"
            Minimum="0"
            Maximum="1"
            Value="0" />
        <StackPanel Grid.Column="4" MinWidth="260">
          <TextBlock
              x:Name="TimelineEndAndRate"
              HorizontalAlignment="Right"
              Text="End: — · FPS: — · TCPS: —" />
          <TextBlock
              x:Name="TimelineDiagnostic"
              HorizontalAlignment="Right"
              TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Border
        Grid.Row="3"
        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
        BorderThickness="0,1,0,0"
        Padding="8,4">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16">
        <TextBlock x:Name="ViewerStatus" AutomationProperties.Name="Viewer status" Text="Ready" />
        <TextBlock
            x:Name="StageStatus"
            Grid.Column="1"
            MaxWidth="240"
            AutomationProperties.Name="Current stage"
            TextTrimming="CharacterEllipsis"
            Text="No stage loaded" />
        <TextBlock
            x:Name="CameraStatus"
            Grid.Column="2"
            MaxWidth="240"
            AutomationProperties.Name="Camera navigation state"
            TextTrimming="CharacterEllipsis"
            Text="Camera: Automatic" />
        <TextBlock
            x:Name="CompositionStatus"
            Grid.Column="3"
            AutomationProperties.Name="Composition status"
            Text="GPU: probing" />
        <TextBlock
            x:Name="RendererStatus"
            Grid.Column="4"
            AutomationProperties.Name="Renderer status"
            Text="Renderer: unavailable" />
        <TextBlock
            x:Name="BridgeStatus"
            Grid.Column="5"
            MaxWidth="320"
            AutomationProperties.Name="Omniverse Bridge status"
            TextTrimming="CharacterEllipsis"
            IsVisible="False"
            Text="" />
      </Grid>
    </Border>
  </Grid>
</Window>
