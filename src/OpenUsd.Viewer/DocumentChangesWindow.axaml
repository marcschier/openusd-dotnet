<Window
    x:Class="OpenUsd.Viewer.DocumentChangesWindow"
    x:ClassModifier="internal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Classes="openusd-viewer"
    Title="Unsaved document changes"
    AutomationProperties.Name="Unsaved document changes"
    AutomationProperties.AutomationId="viewer.unsavedDocument"
    Width="640"
    Height="420"
    MinWidth="480"
    MinHeight="320"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <StyleInclude Source="avares://OpenUsd.Viewer/ViewerStyles.axaml" />
  </Window.Styles>
  <Grid Margin="{DynamicResource ViewerDialogPadding}" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="16">
    <TextBlock x:Name="DocumentTransitionHeading" TextWrapping="Wrap" />
    <ScrollViewer Grid.Row="1">
      <TextBlock x:Name="UnsavedDocumentDetails" TextWrapping="Wrap"
                 AutomationProperties.Name="Exact unsaved layer identities" />
    </ScrollViewer>
    <TextBlock x:Name="DocumentSaveRestriction" Grid.Row="2" TextWrapping="Wrap" Classes="viewer-secondary" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="SaveDocumentReviewButton" Content="Save Review" IsEnabled="False"
              AutomationProperties.Name="Save review before continuing" />
      <Button x:Name="DiscardDocumentChangesButton" Content="Discard and continue"
              AutomationProperties.Name="Discard unsaved document changes and continue" />
      <Button x:Name="CancelDocumentTransitionButton" Content="Cancel"
              AutomationProperties.Name="Cancel and keep the current document" />
    </StackPanel>
  </Grid>
</Window>
