<Window
    x:Class="OpenUsd.Viewer.CameraBookmarksWindow"
    x:ClassModifier="internal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Classes="openusd-viewer"
    AutomationProperties.Name="Saved views"
    Title="Saved views"
    Width="660" Height="520" MinWidth="560" MinHeight="440"
    ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <StyleInclude Source="avares://OpenUsd.Viewer/ViewerStyles.axaml" />
  </Window.Styles>
  <Grid Margin="{DynamicResource ViewerDialogPadding}" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" RowSpacing="12">
    <StackPanel Spacing="4">
      <TextBlock Text="Saved views in this review" FontWeight="SemiBold" />
      <TextBlock x:Name="SavedViewsSource" TextWrapping="Wrap" Classes="viewer-secondary"
                 AutomationProperties.Name="Saved-view source and persistence" />
    </StackPanel>
    <ListBox x:Name="SavedViewsList" Grid.Row="1" MinHeight="120"
             AutomationProperties.Name="Saved views in the current review" />
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
      <TextBlock Text="Name" VerticalAlignment="Center" />
      <TextBox x:Name="SavedViewName" Grid.Column="1" MaxLength="128"
               AutomationProperties.Name="Saved-view name" />
    </Grid>
    <StackPanel Grid.Row="3" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="SaveCurrentViewButton" Content="_Add Current View"
                AutomationProperties.Name="Add current camera and time as a saved view"
                ToolTip.Tip="Adds unsaved review data. Save Review Document to persist it." />
        <Button x:Name="RenameSavedViewButton" Content="Re_name"
                AutomationProperties.Name="Rename selected saved view" />
        <Button x:Name="RemoveSavedViewButton" Content="_Remove"
                AutomationProperties.Name="Remove selected saved view" />
        <Button x:Name="RecallSavedViewButton" Content="Re_call" Classes="accent"
                AutomationProperties.Name="Recall selected saved view" />
      </StackPanel>
      <TextBlock x:Name="SavedViewsCaptureReason" TextWrapping="Wrap" Classes="viewer-caption"
                 AutomationProperties.Name="Saved-view capture availability" />
    </StackPanel>
    <StackPanel Grid.Row="4" Spacing="4">
      <TextBlock x:Name="SavedViewsStatus" TextWrapping="Wrap" AutomationProperties.Name="Saved-view result" />
      <TextBlock Text="32 views; 4096 UTF-8 bytes per record; 128 KiB total. Save Review preserves the catalog."
                 TextWrapping="Wrap" Classes="viewer-caption" />
    </StackPanel>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="SavedViewsRefreshButton" Content="Refresh" AutomationProperties.Name="Refresh saved views" />
      <Button x:Name="SavedViewsCancelButton" Content="Cancel operation" IsEnabled="False"
              AutomationProperties.Name="Cancel saved-view operation" />
      <Button x:Name="SavedViewsCloseButton" Content="Close" AutomationProperties.Name="Close saved views" />
    </StackPanel>
  </Grid>
</Window>
