(
    defaultPrim = "Review"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Review"
{
    def Cube "TealCube"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.04, 0.42, 0.5)]
        double3 xformOp:translate = (-0.9, 0.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "WarmSphere"
    {
        double radius = 0.6
        color3f[] primvars:displayColor = [(0.8, 0.26, 0.06)]
        double3 xformOp:translate = (0.7, 0.6, 0.2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Mesh "Ground"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-3, 0, -3), (-3, 0, 3), (3, 0, 3), (3, 0, -3)]
        color3f[] primvars:displayColor = [(0.35, 0.38, 0.4)]
        uniform token subdivisionScheme = "none"
    }

    def DistantLight "KeyLight"
    {
        float inputs:intensity = 2
        color3f inputs:color = (1, 0.95, 0.85)
        float3 xformOp:rotateXYZ = (-45, -30, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "FillLight"
    {
        float inputs:intensity = 0.4
        color3f inputs:color = (0.75, 0.85, 1)
    }
}
