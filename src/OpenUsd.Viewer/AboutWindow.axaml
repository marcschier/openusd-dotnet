<Window
    x:Class="OpenUsd.Viewer.AboutWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Classes="openusd-viewer"
    AutomationProperties.Name="About OpenUsd Viewer"
    Title="About OpenUsd Viewer"
    Width="460"
    Height="280"
    MinWidth="360"
    MinHeight="220"
    WindowStartupLocation="CenterOwner"
    CanResize="False">
  <Window.Styles>
    <StyleInclude Source="avares://OpenUsd.Viewer/ViewerStyles.axaml" />
  </Window.Styles>
  <DockPanel Margin="{DynamicResource ViewerDialogPadding}">
    <TextBlock
        DockPanel.Dock="Top"
        Text="OpenUsd Viewer"
        Classes="viewer-heading"
        Margin="0,0,0,4" />
    <TextBlock
        x:Name="VersionText"
        Classes="viewer-caption"
        DockPanel.Dock="Top"
        Text="Version: —"
        Margin="0,0,0,12" />
    <Button
        x:Name="CloseButton"
        DockPanel.Dock="Bottom"
        AutomationProperties.Name="Close about dialog"
        Content="Close"
        IsCancel="True"
        IsDefault="True"
        HorizontalAlignment="Right"
        MinWidth="88"
        Margin="0,12,0,0" />
    <ScrollViewer>
      <TextBlock
          x:Name="CompatibilityText"
          TextWrapping="Wrap"
          Text="OpenUsd Viewer is an OpenUSD inspector and focused editor. Omniverse interoperability is offered as a versioned, evidence-backed compatibility profile rather than a blanket 'current Omniverse' claim; see docs/omniverse-profile.md for the exact Kit/OpenUSD baselines this build has evidence against." />
    </ScrollViewer>
  </DockPanel>
</Window>
