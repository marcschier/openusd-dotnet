     Project-owned 16-unit Viewer line icons; labels remain on every action. -->
<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StreamGeometry x:Key="ViewerIconOpen">M 1,6 L 1,3 L 6,3 L 8,5 L 14,5 L 14,7 M 1,7 L 15,7 L 13,13 L 1,13 Z</StreamGeometry>
  <StreamGeometry x:Key="ViewerIconReload">M 12,5 A 5,5 0 1 0 13,10 M 12,1 L 12,5 L 16,5</StreamGeometry>
  <StreamGeometry x:Key="ViewerIconFrame">M 1,6 L 1,1 L 6,1 M 10,1 L 15,1 L 15,6 M 15,10 L 15,15 L 10,15 M 6,15 L 1,15 L 1,10 M 6,8 L 10,8 M 8,6 L 8,10</StreamGeometry>
</ResourceDictionary>
