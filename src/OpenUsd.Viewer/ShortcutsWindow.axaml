<Window
    x:Class="OpenUsd.Viewer.ShortcutsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenUsd.Viewer"
    Classes="openusd-viewer"
    AutomationProperties.Name="Keyboard and mouse shortcuts"
    Title="Keyboard and Mouse Shortcuts"
    Width="660"
    Height="540"
    MinWidth="480"
    MinHeight="320"
    WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <StyleInclude Source="avares://OpenUsd.Viewer/ViewerStyles.axaml" />
  </Window.Styles>
  <DockPanel Margin="{DynamicResource ViewerDialogPadding}">
    <TextBlock
        DockPanel.Dock="Top"
        Text="Workspace and navigation"
        Classes="viewer-heading"
        Margin="0,0,0,4" />
    <TextBlock
        DockPanel.Dock="Top"
        Text="Search commands with Ctrl+Shift+P, or use the adjacent Commands button when a native viewport owns focus."
        TextWrapping="Wrap"
        Classes="viewer-secondary"
        Margin="0,0,0,12" />
    <Button
        x:Name="CloseButton"
        DockPanel.Dock="Bottom"
        AutomationProperties.Name="Close shortcuts"
        Content="Close"
        IsCancel="True"
        IsDefault="True"
        HorizontalAlignment="Right"
        MinWidth="88"
        Margin="0,12,0,0" />
    <ScrollViewer>
      <ItemsControl x:Name="ShortcutItems" AutomationProperties.Name="Shortcut list">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:ViewerShortcut">
            <Grid ColumnDefinitions="200,*" Margin="0,0,0,12">
              <TextBlock
                  Grid.Column="0"
                  Text="{Binding Gesture}"
                  Classes="viewer-monospace"
                  TextWrapping="Wrap"
                  VerticalAlignment="Top" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Action}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock
                    Text="{Binding Detail}"
                    TextWrapping="Wrap"
                    Classes="viewer-secondary"
                    Margin="0,4,0,0" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
