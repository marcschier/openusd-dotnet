<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenUsd\OpenUsd.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>OpenUsd.Cesium</AssemblyName>
    <RootNamespace>OpenUsd.Cesium</RootNamespace>
    <Description>Optional Cesium 3D Tiles importer for OpenUSD stages.</Description>
    <PackageTags>openusd;usd;cesium;3d-tiles;gltf</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Cesium ships as a separate optional package with its own lock, so the core
      runtime carries none of the ~30 vcpkg dependencies. No pack script
      produces it yet, and claiming otherwise would put a package in the
      packable contract that nothing builds.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>