<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenUsd\OpenUsd.csproj" />
    <ProjectReference Include="..\OpenUsd.Runtime.Cesium\OpenUsd.Runtime.Cesium.csproj" IncludeAssets="all" PrivateAssets="none" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
