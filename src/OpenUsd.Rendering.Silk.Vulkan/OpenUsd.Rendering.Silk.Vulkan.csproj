<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenUsd.Rendering.Silk\OpenUsd.Rendering.Silk.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>OpenUsd.Rendering.Silk.Vulkan</AssemblyName>
    <RootNamespace>OpenUsd.Rendering.Silk.Vulkan</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Vulkan backend for the OpenUsd Silk.NET renderer.</Description>
    <PackageTags>openusd;usd;silk.net;vulkan;rendering</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Direct3D11" />
    <PackageReference Include="Silk.NET.DXGI" />
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Vulkan.Loader.Native" />
    <PackageReference Include="Stride.Dependencies.SwiftShader" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Shaders\pick.replay.fragment.spv"
                      LogicalName="OpenUsd.Rendering.Silk.Vulkan.Shaders.pick.replay.fragment.spv" />
  </ItemGroup>

</Project>
