<Project>

  <PropertyGroup>
    <_OURid>$(NETCoreSdkPortableRuntimeIdentifier)</_OURid>
    <_OUOs Condition="$([MSBuild]::IsOSPlatform('Windows'))">Windows</_OUOs>
    <_OUOs Condition="$([MSBuild]::IsOSPlatform('Linux'))">Linux</_OUOs>
    <_OUOs Condition="$([MSBuild]::IsOSPlatform('OSX'))">OSX</_OUOs>
    <_OUArch Condition="'$(_OURid)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</_OUArch>
    <_OURid Condition="'$(_OURid)' == '' and '$(_OUOs)' == 'Windows' and '$(_OUArch)' == 'X64'">win-x64</_OURid>
    <_OURid Condition="'$(_OURid)' == '' and '$(_OUOs)' == 'Linux' and '$(_OUArch)' == 'X64'">linux-x64</_OURid>
    <_OURid Condition="'$(_OURid)' == '' and '$(_OUOs)' == 'OSX' and '$(_OUArch)' == 'Arm64'">osx-arm64</_OURid>
    <_OUHostOk Condition="'$(_OURid)' == 'win-x64'">true</_OUHostOk>
    <_OUHostOk Condition="'$(_OURid)' == 'linux-x64'">true</_OUHostOk>
    <_OUHostOk Condition="'$(_OURid)' == 'osx-arm64'">true</_OUHostOk>
  </PropertyGroup>

  <Target
    Name="ValidateOpenUsdRidlessHostRuntime"
    BeforeTargets="ResolveReferences"
    Condition="'$(RuntimeIdentifier)' == '' and '$(_OUHostOk)' != 'true'">
    <Error
      Text="OpenUSD RID-less builds need host win-x64, linux-x64, or osx-arm64. Set RuntimeIdentifier explicitly." />
  </Target>
  <PropertyGroup>
    <_OUImgOsxRes>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../runtimes/osx-arm64/resources'))</_OUImgOsxRes>
    <_OUImgOsxNative>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../runtimes/osx-arm64/native'))</_OUImgOsxNative>
    <_OUImgOsxApplies Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">true</_OUImgOsxApplies>
    <_OUImgOsxRidless Condition="'$(RuntimeIdentifier)' == '' and '$(_OURid)' == 'osx-arm64'">true</_OUImgOsxRidless>
    <_OUImgOsxApplies Condition="'$(_OUImgOsxRidless)' == 'true'">true</_OUImgOsxApplies>
  </PropertyGroup>

  <ItemGroup Condition="'$(_OUImgOsxApplies)' == 'true'">
    <_OUImgOsxMerged
        Include="$(_OUImgOsxRes)/plugin/usd/**/*"
        Exclude="$(_OUImgOsxRes)/plugin/usd/plugInfo.json;$(_OUImgOsxRes)/plugin/usd/hdSilk/resources/plugInfo.json" />
    <Content Include="$(_OUImgOsxRes)/**/*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="@(_OUImgOsxMerged)">
      <Link>usd/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(_OUImgOsxRidless)' == 'true'">
    <Content Include="$(_OUImgOsxNative)/**/*">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
