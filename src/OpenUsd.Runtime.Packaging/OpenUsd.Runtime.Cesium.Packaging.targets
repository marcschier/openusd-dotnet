<Project>

  <PropertyGroup>
    <OpenUsdCesiumInstallRoot Condition="'$(OpenUsdCesiumInstallRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../native/install/cesium/$(RuntimePackageRid)'))</OpenUsdCesiumInstallRoot>
    <_OpenUsdCesiumRuntimePackagePath>runtimes/$(RuntimePackageRid)/native/cesium</_OpenUsdCesiumRuntimePackagePath>
  </PropertyGroup>

  <ItemGroup>
    <_OpenUsdCesiumLibraries Include="$(OpenUsdCesiumInstallRoot)/lib/*.lib;$(OpenUsdCesiumInstallRoot)/lib/*.a;$(OpenUsdCesiumInstallRoot)/lib/*.dll;$(OpenUsdCesiumInstallRoot)/lib/*.so;$(OpenUsdCesiumInstallRoot)/lib/*.dylib;$(OpenUsdCesiumInstallRoot)/bin/*.dll" />
    <_OpenUsdCesiumCMake Include="$(OpenUsdCesiumInstallRoot)/share/cesium-native/cmake/**/*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="@(_OpenUsdCesiumLibraries)" Pack="true" PackagePath="$(_OpenUsdCesiumRuntimePackagePath)/lib" />
    <None Include="@(_OpenUsdCesiumCMake)" Pack="true" PackagePath="$(_OpenUsdCesiumRuntimePackagePath)/share/cesium-native/cmake/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(OpenUsdCesiumInstallRoot)/cesium-headers.tar.gz" Pack="true" PackagePath="$(_OpenUsdCesiumRuntimePackagePath)/include/cesium-headers.tar.gz" />
    <None Include="$(OpenUsdCesiumInstallRoot)/THIRD-PARTY-CESIUM.md" Pack="true" PackagePath="THIRD-PARTY-CESIUM-NOTICES.md" />
    <None Include="$(MSBuildProjectDirectory)/buildTransitive/$(PackageId).targets" Pack="true" PackagePath="buildTransitive/$(PackageId).targets" />
  </ItemGroup>

  <Target Name="ValidateOpenUsdCesiumRuntimePackageInputs" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(OpenUsdCesiumInstallRoot)')" Text="The locked cesium-native install for $(RuntimePackageRid) is missing at '$(OpenUsdCesiumInstallRoot)'. Run eng/build-cesium-native.ps1 -Rid $(RuntimePackageRid) before packing $(PackageId)." />
    <Error Condition="!Exists('$(OpenUsdCesiumInstallRoot)/cesium-headers.tar.gz')" Text="The locked cesium-native header archive is missing at '$(OpenUsdCesiumInstallRoot)/cesium-headers.tar.gz'." />
    <Error Condition="@(_OpenUsdCesiumLibraries->Count()) == 0" Text="The locked cesium-native install has no native libraries under '$(OpenUsdCesiumInstallRoot)/lib'." />
  </Target>

</Project>
