{
  "mcpServers": {
    "openusd": {
      "type": "stdio",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-File",
        "<REPOSITORY_ROOT>\\eng\\run-mcp.ps1",
        "-Rid",
        "win-x64",
        "-Configuration",
        "Release"
      ],
      "env": {
        "OPENUSD_MCP_SOURCE_ROOT": "<ABSOLUTE_SOURCE_ROOT>",
        "OPENUSD_MCP_OUTPUT_ROOT": "<ABSOLUTE_OUTPUT_ROOT>",
        "OPENUSD_MCP_VIEWER_ROOT": "<ABSOLUTE_VIEWER_ROOT>"
      },
      "tools": [
        "*"
      ]
    }
  }
}
