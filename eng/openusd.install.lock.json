    "runtimePatchLockSha256": "A7EFA454840071345937B342D939CDFC1327E5D9B3DD219B6CAD964433C90032",
    "storageAdmissionPatchLockSha256": "1E6280DBC19E3C9DBAD1004D5F5B78474D564D54097448E0B6F3BF425DE1874D",
    "patches": [
      {
        "id": "windows-python-3.13-batch-launch",
        "description": "Run Boost bootstrap through cmd.exe with the vc143 toolset and restore batch lookup in the configured build directory."
      },
      {
        "id": "windows-vs18-boost-toolset",
        "description": "Bind Boost's vc143 toolset to the cl.exe already configured by the developer shell when Visual Studio is newer than Boost's discovery table."
      },
      {
        "id": "windows-draco-monolithic-profile",
        "description": "Permit the locked Windows monolithic native profile to build the Draco plugin by removing the upstream script and CMake configure guards; the resulting install is verified by native probes and package gates."
      },
      {
        "id": "boost-openvdb-iostreams-existence",
        "description": "Require the Boost iostreams binary when OpenVDB is enabled so an existing lean Boost install is rebuilt instead of being reused."
      },
      {
        "id": "alembic-macos-cmp0042",
        "description": "Set Alembic 1.8.5 CMP0042 to NEW instead of OLD; modern CMake removed OLD for that policy, so the macOS Alembic configure fails outright. The policy is MACOSX_RPATH, which is why only osx-arm64 is affected, and the locked build already passes -DCMAKE_MACOSX_RPATH=ON."
      },
      {
        "id": "alembic-root-for-usd-configure",
        "description": "Pass the locked Alembic install root into USD configure so the Ogawa-only Alembic build is found without HDF5 on every platform."
      },
      {
        "id": "openvdb-boost-module-configure",
        "description": "Use Boost's FindBoost path when configuring OpenVDB so the locked b2 Boost install works without component CMake packages."
      },
      {
        "id": "openvdb-root-for-usd-configure",
        "description": "Pass the locked OpenVDB install root into USD configure so hioOpenVDB never resolves from a system or vcpkg tree."
      },
      {
        "id": "locked-dependency-source-selection",
        "description": "Bind every dependency source URL and Boost/Ptex version in the verified upstream build script to the reviewed stable versions and archives in this lock."
      }
    ],
    "license": "Apache-2.0"
  },
