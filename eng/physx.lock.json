{
  "$schemaVersion": 1,
  "physx": {
    "version": "5.5.0",
    "tag": "106.4-physx-5.5.0",
    "repository": "https://github.com/NVIDIA-Omniverse/PhysX.git",
    "license": "BSD-3-Clause",
    "vcpkgPackage": "physx",
    "vcpkgConfigPackage": "unofficial-omniverse-physx-sdk",
    "vcpkgTarget": "unofficial::omniverse-physx-sdk::sdk",
    "releaseScope": "statically linked into the published OpenUsd.Runtime.Physics.<rid> packages",
    "supportedRids": [
      "win-x64",
      "linux-x64"
    ],
    "gpuModules": [
      "PhysXGpu_64",
      "PhysXDevice64"
    ],
    "gpuModuleLicense": "LicenseRef-NvidiaProprietary",
    "gpuModuleScope": "downloaded by the vcpkg port as a build and local runtime input; never redistributed in any OpenUsd package"
  },
  "vcpkg": {
    "repository": "https://github.com/microsoft/vcpkg.git",
    "baseline": "56bb2411609227288b70117ead2c47585ba07713",
    "manifestMode": true,
    "windowsTriplet": "x64-windows-static-md",
    "linuxTriplet": "x64-linux",
    "portSupports": "(windows & x64 & !mingw & !uwp) | (linux & x64) | (linux & arm64)"
  },
  "profile": {
    "name": "physx-quarantined",
    "configuration": "Release",
    "libraryLinkage": "static",
    "enabled": [
      "headers",
      "static libraries",
      "separate C ABI shim",
      "smoke probe"
    ],
    "disabled": [
      "PhysX samples",
      "PhysX snippets",
      "shared libraries",
      "GPU module redistribution"
    ]
  },
  "directVcpkgDependencies": [
    "physx"
  ]
}
