--- a/pxr/usd/sdf/layer.cpp
+++ b/pxr/usd/sdf/layer.cpp
@@ -71,6 +71,108 @@ using std::vector;
 
 namespace ph = std::placeholders;
 
+#include <cstddef>
+
+#if defined(__GNUC__) && !defined(_WIN32)
+namespace OpenUsdOwnedSdkPhaseObservation __attribute__((visibility("hidden")))
+#else
+namespace OpenUsdOwnedSdkPhaseObservation
+#endif
+{
+namespace Detail
+{
+void Write(const char* phase, std::size_t count) noexcept;
+}
+
+template <std::size_t Count>
+inline void Write(const char (&phase)[Count]) noexcept
+{
+    static_assert(Count <= 32, "SDK observations must use bounded fixed labels.");
+    Detail::Write(phase, Count);
+}
+}
+
+// Copyright (c) marcschier. Licensed under the MIT License.
+#include <atomic>
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#else
+#include <unistd.h>
+#endif
+
+#if defined(__GNUC__) && !defined(_WIN32)
+namespace OpenUsdOwnedSdkPhaseObservation __attribute__((visibility("hidden")))
+#else
+namespace OpenUsdOwnedSdkPhaseObservation
+#endif
+{
+namespace Detail
+{
+namespace
+{
+std::atomic<unsigned> records{0};
+std::atomic<unsigned> failedRecords{0};
+
+bool Enabled() noexcept
+{
+#if defined(_WIN32)
+    char value[2]{};
+    return GetEnvironmentVariableA("OPENUSD_DOTNET_OWN_SDK_PHASES", value, sizeof(value)) == 1 &&
+        value[0] == '1';
+#else
+    const char* value = std::getenv("OPENUSD_DOTNET_OWN_SDK_PHASES");
+    return value != nullptr && value[0] == '1' && value[1] == '\0';
+#endif
+}
+}
+
+void Write(const char* phase, std::size_t count) noexcept
+{
+#if defined(_WIN32)
+    const DWORD savedError = GetLastError();
+#endif
+    const int savedErrno = errno;
+    if (Enabled() && records.load(std::memory_order_relaxed) < 64 &&
+        records.fetch_add(1, std::memory_order_relaxed) < 64)
+    {
+        constexpr char prefix[] = "[OWN-sdk-phase] ";
+        char line[sizeof(prefix) - 1 + 32];
+        std::memcpy(line, prefix, sizeof(prefix) - 1);
+        std::memcpy(line + sizeof(prefix) - 1, phase, count - 1);
+        const std::size_t size = sizeof(prefix) - 1 + count;
+        line[size - 1] = '\n';
+#if defined(_WIN32)
+        DWORD written = 0;
+        const bool complete = WriteFile(
+            GetStdHandle(STD_ERROR_HANDLE), line, static_cast<DWORD>(size), &written, nullptr) != 0 &&
+            written == size;
+#else
+        const auto written = ::write(STDERR_FILENO, line, size);
+        const bool complete = written >= 0 && static_cast<std::size_t>(written) == size;
+#endif
+        if (!complete)
+        {
+            failedRecords.fetch_add(1, std::memory_order_relaxed);
+        }
+    }
+    errno = savedErrno;
+#if defined(_WIN32)
+    SetLastError(savedError);
+#endif
+}
+}
+}
+
