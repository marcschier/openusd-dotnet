+{
+thread_local SdfStorageAdmissionScope* currentScope = nullptr;
+std::atomic<uint64_t> nextStoreIdentity{1};
+
+const char* Message(SdfStorageAdmissionStatus status)
+{
+    switch (status)
+    {
+        case SdfStorageAdmissionStatus::UnsupportedStore:
+            return "Native storage admission: backing store or deferred layer open is unsupported.";
+        case SdfStorageAdmissionStatus::UnsupportedType:
+            return "Native storage admission: field or storage type is unsupported.";
+        case SdfStorageAdmissionStatus::QuotaExceeded:
+            return "Native storage admission: item/text/decode/materialization budget exceeded before allocation.";
+        case SdfStorageAdmissionStatus::InvalidData:
+            return "Native storage admission: serialized field data is invalid.";
+        case SdfStorageAdmissionStatus::Stale:
+            return "Native storage admission: source store generation changed during preparation.";
+        default:
+            return "Native storage admission failed.";
+    }
+}
+
+template <typename T>
+bool TokenList(const VtValue& value, SdfStorageAdmissionScope& scope)
+{
+    if (!value.IsHolding<T>()) return false;
+    const auto& op = value.UncheckedGet<T>();
+    for (const auto* items : {&op.GetExplicitItems(), &op.GetAddedItems(),
+        &op.GetPrependedItems(), &op.GetAppendedItems(), &op.GetDeletedItems(), &op.GetOrderedItems()})
+    {
+        scope._Items(items->size());
+        scope._Decode(items->size());
+        scope._Materialization(items->size() * sizeof(typename T::ItemType) * 4 + 128);
+        for (const auto& item : *items)
+        {
+            if constexpr (std::is_same_v<typename T::ItemType, TfToken>) scope._Text(item.GetString().size() + 1);
+            else if constexpr (std::is_same_v<typename T::ItemType, std::string>) scope._Text(item.size() + 1);
+            else scope._PathText(item);
+        }
+    }
+    return true;
+}
+}
+
+SdfStorageAdmissionError::SdfStorageAdmissionError(SdfStorageAdmissionStatus status)
+    : std::runtime_error(Message(status)), _status(status) {}
+
+SdfStorageAdmissionScope::SdfStorageAdmissionScope(const SdfStorageAdmissionLimits& limits)
+    : _limits(limits), _previous(currentScope)
+{
+    if (_previous)
+    {
+        _previous->RequireSucceeded();
+        throw std::logic_error("Native storage admission: nested preparation scopes are unsupported.");
+    }
+    if (limits.maximumItems > (uint64_t{1} << 30) ||
+        limits.maximumUtf8Bytes > (uint64_t{1} << 40))
+        _Fail(SdfStorageAdmissionStatus::InvalidData);
+    currentScope = this;
+}
+
+SdfStorageAdmissionScope::~SdfStorageAdmissionScope()
+{
+    currentScope = _previous;
+}
+
+uint32_t SdfStorageAdmissionScope::GetApiVersion() noexcept { return SDF_STORAGE_ADMISSION_VERSION; }
+SdfStorageAdmissionScope* SdfStorageAdmissionScope::GetCurrent() noexcept { return currentScope; }
+uint64_t SdfStorageAdmissionScope::_NewStoreIdentity() noexcept { return nextStoreIdentity.fetch_add(1); }
+
+void SdfStorageAdmissionScope::_Fail(SdfStorageAdmissionStatus status)
+{
+    if (_failure == SdfStorageAdmissionStatus::Ready) _failure = status;
+    _last.status = status;
+    if (status == SdfStorageAdmissionStatus::UnsupportedType ||
+        status == SdfStorageAdmissionStatus::UnsupportedStore)
+        _last.countKnown = false;
+    throw SdfStorageAdmissionError(status);
+}
+
+void SdfStorageAdmissionScope::_BeginRead(uint64_t identity, uint64_t generation, bool resident)
+{
+    RequireSucceeded();
+    _last = {};
+    _last.status = SdfStorageAdmissionStatus::Ready;
+    _last.resident = resident;
+    _last.storeIdentity = identity;
+    _last.storeGeneration = generation;
+    _Decode(1);
+    auto found = _generations.find(identity);
+    if (found != _generations.end())
+    {
+        if (found->second != generation) _Fail(SdfStorageAdmissionStatus::Stale);
+    }
+    else
+    {
+        ReserveExternalMaterialization(128);
+        _generations.emplace(identity, generation);
+    }
+    ++_statistics.readCount;
+}
+
+void SdfStorageAdmissionScope::RequireSucceeded() const
+{
+    if (_failure != SdfStorageAdmissionStatus::Ready) throw SdfStorageAdmissionError(_failure);
+}
+
+void SdfStorageAdmissionScope::_Items(uint64_t count)
+{
+    if (count > std::numeric_limits<uint64_t>::max() - _last.itemCount)
+    {
+        _last.countKnown = false;
+        _Fail(SdfStorageAdmissionStatus::InvalidData);
+    }
+    _last.countKnown = true;
+    _last.itemCount += count;
+    if (count > _limits.maximumItems - _statistics.items)
+        _Fail(SdfStorageAdmissionStatus::QuotaExceeded);
+    _statistics.items += count;
+}
+
+void SdfStorageAdmissionScope::_Field(const TfToken& field)
+{
+    const auto& name = field.GetString();
+    _Text(name.size() + 1);
+    if (name != "default" && name != "properties" && name != "propertyChildren" &&
+        name != "propertyOrder" && name != "variantSetChildren" &&
+        name != "typeName" && name != "custom" && name != "variability" &&
+        name != "specifier" && name != "permission" && name != "apiSchemas" &&
+        name != "targetPaths" && name != "connectionPaths" && name != "renderSettingsPrimPath")
+        _Fail(SdfStorageAdmissionStatus::UnsupportedType);
+}
+
+void SdfStorageAdmissionScope::_Text(uint64_t bytes)
+{
+    if (bytes > _limits.maximumUtf8Bytes - _statistics.utf8Bytes)
+        _Fail(SdfStorageAdmissionStatus::QuotaExceeded);
+    _statistics.utf8Bytes += bytes;
+    _last.utf8Bytes += bytes;
+    _Decode(bytes);
+    _Materialization(bytes * 2);
+}
+
+void SdfStorageAdmissionScope::_Decode(uint64_t work)
+{
+    if (work > _limits.maximumDecodeWork - _statistics.decodeWork)
+        _Fail(SdfStorageAdmissionStatus::QuotaExceeded);
+    _statistics.decodeWork += work;
+    _last.decodeWork += work;
+}
+
+void SdfStorageAdmissionScope::_Materialization(uint64_t bytes)
+{
+    if (bytes > _limits.maximumPeakMaterializationBytes - _statistics.totalMaterializationBytes ||
+        bytes > _limits.maximumTotalMaterializationBytes - _statistics.totalMaterializationBytes)
+        _Fail(SdfStorageAdmissionStatus::QuotaExceeded);
+    _last.materializationBytes += bytes;
+    _statistics.totalMaterializationBytes += bytes;
+    _statistics.peakMaterializationBytes = _statistics.totalMaterializationBytes;
+}
+
+void SdfStorageAdmissionScope::ReserveExternalMaterialization(uint64_t bytes)
+{
+    if (bytes > _limits.maximumPeakMaterializationBytes - _statistics.totalMaterializationBytes ||
+        bytes > _limits.maximumTotalMaterializationBytes - _statistics.totalMaterializationBytes)
+        _Fail(SdfStorageAdmissionStatus::QuotaExceeded);
+    _statistics.totalMaterializationBytes += bytes;
+    _statistics.peakMaterializationBytes = _statistics.totalMaterializationBytes;
+}
+
+void SdfStorageAdmissionScope::_PathText(const SdfPath& path)
+{
+    if ((!path.IsPrimPath() && !path.IsPrimPropertyPath() && !path.IsAbsoluteRootPath()) ||
+        path.ContainsPrimVariantSelection())
+        _Fail(SdfStorageAdmissionStatus::UnsupportedType);
+    _Text(1);
+    for (const auto& part : path.GetAncestorsRange())
+    {
+        _Decode(1);
+        _Text(part.GetNameToken().GetString().size() + 1);
+    }
+}
+
+void SdfStorageAdmissionScope::_ResidentValue(const VtValue& value)
+{
+    if (value.IsHolding<TfTokenVector>())
+    {
+        const auto& items = value.UncheckedGet<TfTokenVector>();
+        _Items(items.size());
+        _Decode(items.size());
+        _Materialization(items.size() * sizeof(TfToken) * 2 + 128);
+        for (const auto& token : items) _Text(token.GetString().size() + 1);
+    }
+    else if (value.IsHolding<SdfPathVector>())
+    {
+        const auto& items = value.UncheckedGet<SdfPathVector>();
+        _Items(items.size());
+        _Decode(items.size());
+        _Materialization(items.size() * sizeof(SdfPath) * 2 + 128);
+        for (const auto& path : items) _PathText(path);
+    }
+    else if (TokenList<SdfTokenListOp>(value, *this) || TokenList<SdfPathListOp>(value, *this) ||
+        TokenList<SdfStringListOp>(value, *this)) {}
+    else if (value.IsHolding<VtArray<TfToken>>())
+    {
+        const auto& items = value.UncheckedGet<VtArray<TfToken>>();
+        _Items(items.size());
+        _Decode(items.size());
+        _Materialization(items.size() * sizeof(TfToken) * 2 + 128);
+        for (const auto& item : items) _Text(item.GetString().size() + 1);
+    }
+    else if (value.IsHolding<VtArrayEdit<TfToken>>())
+    {
+        const auto& edit = value.UncheckedGet<VtArrayEdit<TfToken>>();
+        const auto words = edit.GetEncodedInstructions();
+        _Items(words.size() + edit.GetLiterals().size());
+        _Decode(words.size() + edit.GetLiterals().size());
+        _Materialization(words.size() * sizeof(int64_t) * 2 + edit.GetLiterals().size() * sizeof(TfToken) * 2 + 256);
+        for (const auto& literal : edit.GetLiterals()) _Text(literal.GetString().size() + 1);
+    }
+    else if (value.IsHolding<std::string>())
+    {
+        const auto size = value.UncheckedGet<std::string>().size();
+        _Items(1); _Text(size + 1); _Materialization(size + 129);
+    }
+    else if (value.IsHolding<TfToken>())
+    {
+        _Items(1); _Text(value.UncheckedGet<TfToken>().GetString().size() + 1); _Materialization(128);
+    }
+    else if (value.IsHolding<SdfAssetPath>())
+    {
+        const auto& asset = value.UncheckedGet<SdfAssetPath>();
+        const auto size = asset.GetAuthoredPath().size() + asset.GetEvaluatedPath().size() + asset.GetResolvedPath().size();
+        _Items(1); _Text(size + 3); _Materialization(size + 256);
+    }
+    else if (value.IsEmpty() || value.IsHolding<bool>() || value.IsHolding<int>() ||
+        value.IsHolding<unsigned int>() || value.IsHolding<int64_t>() || value.IsHolding<uint64_t>() ||
+        value.IsHolding<float>() || value.IsHolding<double>() || value.IsHolding<GfHalf>() ||
+        value.IsHolding<GfVec2i>() || value.IsHolding<GfVec4f>() ||
+        value.IsHolding<SdfSpecifier>() || value.IsHolding<SdfVariability>() ||
+        value.IsHolding<SdfPermission>() || value.IsHolding<SdfValueBlock>() ||
+        value.IsHolding<SdfAnimationBlock>())
+    {
+        _Items(1); _Materialization(256);
+    }
+    else _Fail(SdfStorageAdmissionStatus::UnsupportedType);
+}
