+
+template <typename T>
+uint64_t _AdmitListStorage(const SdfListOp<T>& op, SdfStorageAdmissionScope& scope)
+{
+    uint64_t count = 0;
+    for (const auto* items : {&op.GetExplicitItems(), &op.GetAddedItems(),
+        &op.GetPrependedItems(), &op.GetAppendedItems(), &op.GetDeletedItems(), &op.GetOrderedItems()})
+    {
+        count += _AdmitListItems(*items, scope);
+    }
+    return count;
+}
