+template <typename T>
+uint64_t _AdmitListItems(const std::vector<T>& items, SdfStorageAdmissionScope& scope)
+{
+    scope._Items(items.size());
+    scope._Decode(items.size());
+    for (const auto& item : items)
+    {
+        if constexpr (std::is_same_v<T, TfToken>) scope._Text(item.GetString().size() + 1);
+        else if constexpr (std::is_same_v<T, SdfPath>) scope._PathText(item);
+        else scope._Fail(SdfStorageAdmissionStatus::UnsupportedType);
+    }
+    return items.size();
