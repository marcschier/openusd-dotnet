+void
+CrateFile::AdmitStorageValue(ValueRep rep, SdfStorageAdmissionScope& scope) const
+{
+    _AdmitStorageValue(rep, scope, 0);
+}
+
+void
+CrateFile::_AdmitStorageValue(
+    ValueRep rep, SdfStorageAdmissionScope& scope, unsigned depth) const
+{
+    if (depth > 4) scope._Fail(SdfStorageAdmissionStatus::InvalidData);
+    if (rep.IsArray() && rep.IsArrayEdit()) scope._Fail(SdfStorageAdmissionStatus::InvalidData);
+    if ((rep.IsInlined() && (rep.IsArray() || rep.IsArrayEdit() || rep.IsCompressed())) ||
+        (rep.IsCompressed() && !rep.IsArray()))
+        scope._Fail(SdfStorageAdmissionStatus::InvalidData);
+    scope._Decode(1);
+    const auto type = rep.GetType();
+    if (type <= TypeEnum::Invalid || type >= TypeEnum::NumTypes)
+        scope._Fail(SdfStorageAdmissionStatus::UnsupportedType);
+
+    auto token = [&](uint32_t index) -> const TfToken&
+    {
+        if (index >= _tokens.size()) scope._Fail(SdfStorageAdmissionStatus::InvalidData);
+        return _tokens[index];
+    };
+    auto stringBytes = [&](uint32_t index)
+    {
+        if (index >= _strings.size()) scope._Fail(SdfStorageAdmissionStatus::InvalidData);
+        const auto& text = token(_strings[index].value).GetString();
+        scope._Text(text.size() + 1);
+        scope._Materialization(text.size() + 1);
+    };
+    auto pathBytes = [&](uint32_t index)
+    {
+        if (index >= _paths.size()) scope._Fail(SdfStorageAdmissionStatus::InvalidData);
+        scope._PathText(_paths[index]);
+    };
+
+    if (rep.IsArrayEdit())
+    {
+        if (type != TypeEnum::Token || Version(_boot.version) < Version(0,14,0))
+            scope._Fail(SdfStorageAdmissionStatus::UnsupportedType);
+        scope._Materialization(256);
+        if (rep.GetPayload() == 0)
+        {
+            scope._Items(0);
+            return;
+        }
+        _StorageCursor cursor(*this, scope, rep.GetPayload());
+        const auto valuesRep = cursor.Read<ValueRep>();
+        const auto indexesRep = cursor.Read<ValueRep>();
+        cursor.Read<bool>();
+        if (!valuesRep.IsArray() || valuesRep.GetType() != TypeEnum::Token ||
+            !indexesRep.IsArray() || indexesRep.GetType() != TypeEnum::Int64)
+            scope._Fail(SdfStorageAdmissionStatus::InvalidData);
+        _AdmitStorageValue(valuesRep, scope, depth + 1);
+        const auto before = scope.GetLastResult().itemCount;
+        _AdmitStorageValue(indexesRep, scope, depth + 1);
+        const auto words = scope.GetLastResult().itemCount - before;
+        // Array-edit construction copies its encoded words. Include temporary
+        // validation decode and the later normal SDK decode in total admission.
+        scope._Materialization(words * sizeof(int64_t) * 3 + 256);
+        _AdmitStorageValue(indexesRep, scope, depth + 1);
+        TfErrorMark errors;
+        VtInt64Array indexes;
+        _UnpackValue(indexesRep, &indexes);
+        if (!errors.IsClean() || indexes.size() != words)
+        {
+            errors.Clear();
+            scope._Fail(SdfStorageAdmissionStatus::InvalidData);
+        }
+        const auto& admittedIndexes = indexes;
+        size_t position = 0;
+        while (position < admittedIndexes.size())
+        {
+            Vt_ArrayEditOps::OpAndCount block{};
+            std::memcpy(&block, &admittedIndexes[position++], sizeof(block));
+            if (!Vt_ArrayEditOps::IsValidOp(block.op) || block.count < 0 ||
+                static_cast<uint64_t>(block.count) > (admittedIndexes.size() - position) /
+                    static_cast<size_t>(Vt_ArrayEditOps::GetArity(block.op)))
+                scope._Fail(SdfStorageAdmissionStatus::InvalidData);
+            position += static_cast<size_t>(block.count) *
+                static_cast<size_t>(Vt_ArrayEditOps::GetArity(block.op));
+        }
+        return;
+    }
+
+    if (rep.IsArray())
+    {
+        if (type != TypeEnum::Token && type != TypeEnum::String && type != TypeEnum::AssetPath &&
+            type != TypeEnum::Int && type != TypeEnum::UInt &&
+            type != TypeEnum::Int64 && type != TypeEnum::UInt64)
+            scope._Fail(SdfStorageAdmissionStatus::UnsupportedType);
+        if (rep.GetPayload() == 0)
+        {
+            scope._Items(0);
+            scope._Materialization(128);
+            return;
+        }
+        const auto version = Version(_boot.version);
+        if (version < Version(0,5,0)) scope._Fail(SdfStorageAdmissionStatus::UnsupportedType);
+        _StorageCursor cursor(*this, scope, rep.GetPayload());
+        const uint64_t count = version < Version(0,7,0) ? cursor.Read<uint32_t>() : cursor.Read<uint64_t>();
+        scope._Items(count);
+        scope._Decode(count);
+        if (type == TypeEnum::Token || type == TypeEnum::String || type == TypeEnum::AssetPath)
+        {
+            if (rep.IsCompressed()) scope._Fail(SdfStorageAdmissionStatus::InvalidData);
+            scope._Materialization(count * (type == TypeEnum::Token ? sizeof(TfToken) :
+                (type == TypeEnum::String ? sizeof(std::string) : sizeof(SdfAssetPath))) * 2 + 256);
+            cursor.Check(count * sizeof(uint32_t));
+            for (uint64_t index = 0; index < count; ++index)
+            {
+                const auto id = cursor.Read<uint32_t>();
+                if (type == TypeEnum::String) stringBytes(id);
+                else
+                {
+                    const auto bytes = token(id).GetString().size() + 1;
+                    scope._Text(bytes);
+                    if (type == TypeEnum::AssetPath) scope._Materialization(bytes);
+                }
+            }
+            return;
+        }
+        if (type == TypeEnum::Int64 || type == TypeEnum::UInt64 ||
+            type == TypeEnum::Int || type == TypeEnum::UInt)
+        {
+            const size_t width = type == TypeEnum::Int64 || type == TypeEnum::UInt64 ? 8 : 4;
+            scope._Materialization(count * width * 2 + 128);
+            if (!rep.IsCompressed() || count < MinCompressedArraySize)
+            {
+                cursor.Skip(count * width);
+                return;
+            }
+            const uint64_t compressedBytes = cursor.Read<uint64_t>();
+            const uint64_t capacity = width == 8 ?
+                Sdf_IntegerCompression64::GetCompressedBufferSize(count) :
+                Sdf_IntegerCompression::GetCompressedBufferSize(count);
+            const uint64_t workspace = width == 8 ?
+                Sdf_IntegerCompression64::GetDecompressionWorkingSpaceSize(count) :
+                Sdf_IntegerCompression::GetDecompressionWorkingSpaceSize(count);
+            if (compressedBytes > capacity) scope._Fail(SdfStorageAdmissionStatus::InvalidData);
+            scope._Materialization(capacity + workspace);
+            scope._Decode(count * width);
+            cursor.Skip(compressedBytes);
+            return;
+        }
+        scope._Fail(SdfStorageAdmissionStatus::UnsupportedType);
+    }
+
+    if (type == TypeEnum::PathListOp || type == TypeEnum::TokenListOp ||
+        type == TypeEnum::StringListOp || type == TypeEnum::PathVector || type == TypeEnum::TokenVector)
+    {
+        if (rep.IsInlined()) scope._Fail(SdfStorageAdmissionStatus::UnsupportedType);
+        scope._Materialization(256);
+        _StorageCursor cursor(*this, scope, rep.GetPayload());
+        auto list = [&]()
+        {
+            const uint64_t count = cursor.Read<uint64_t>();
+            scope._Items(count);
+            scope._Decode(count);
+            scope._Materialization(count * (type == TypeEnum::StringListOp ? sizeof(std::string) :
+                sizeof(SdfPath)) * 4 + 256);
+            cursor.Check(count * sizeof(uint32_t));
+            for (uint64_t index = 0; index < count; ++index)
+            {
+                const auto id = cursor.Read<uint32_t>();
+                if (type == TypeEnum::PathListOp || type == TypeEnum::PathVector) pathBytes(id);
+                else if (type == TypeEnum::StringListOp) stringBytes(id);
+                else scope._Text(token(id).GetString().size() + 1);
+            }
+        };
+        if (type == TypeEnum::PathVector || type == TypeEnum::TokenVector) list();
+        else
+        {
+            const auto header = cursor.Read<_ListOpHeader>();
+            scope._Items(0);
+            if (header.HasExplicitItems()) list();
+            if (header.HasAddedItems()) list();
+            if (header.HasPrependedItems()) list();
+            if (header.HasAppendedItems()) list();
+            if (header.HasDeletedItems()) list();
+            if (header.HasOrderedItems()) list();
+        }
+        return;
+    }
+
+    scope._Items(1);
+    if (type == TypeEnum::String || type == TypeEnum::Token || type == TypeEnum::AssetPath)
+    {
+        if (!rep.IsInlined()) scope._Fail(SdfStorageAdmissionStatus::InvalidData);
+        if (type == TypeEnum::String) stringBytes(static_cast<uint32_t>(rep.GetPayload()));
+        else scope._Text(token(static_cast<uint32_t>(rep.GetPayload())).GetString().size() + 1);
+        scope._Materialization(256);
+        return;
+    }
+    if (type == TypeEnum::Bool || type == TypeEnum::UChar ||
+        type == TypeEnum::Int || type == TypeEnum::UInt ||
+        type == TypeEnum::Int64 || type == TypeEnum::UInt64 ||
+        type == TypeEnum::Half || type == TypeEnum::Float || type == TypeEnum::Double ||
+        type == TypeEnum::Vec2i || type == TypeEnum::Vec4f ||
+        type == TypeEnum::Specifier || type == TypeEnum::Variability ||
+        type == TypeEnum::Permission || type == TypeEnum::ValueBlock || type == TypeEnum::AnimationBlock)
+    {
+        scope._Materialization(256);
+        scope._Decode(32);
+        if (!rep.IsInlined())
+        {
+            const uint64_t bytes = type == TypeEnum::Vec4f ? 16 :
+                (type == TypeEnum::Vec2i || type == TypeEnum::Double ||
+                 type == TypeEnum::Int64 || type == TypeEnum::UInt64 ? 8 : 4);
+            _StorageCursor cursor(*this, scope, rep.GetPayload());
+            cursor.Check(bytes);
+        }
+        return;
+    }
+    scope._Fail(SdfStorageAdmissionStatus::UnsupportedType);
+}
