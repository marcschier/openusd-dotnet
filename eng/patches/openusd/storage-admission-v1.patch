+// Copyright (c) marcschier. Licensed under the MIT License.
+
+#ifndef PXR_USD_SDF_STORAGE_ADMISSION_H
+#define PXR_USD_SDF_STORAGE_ADMISSION_H
+
+#include "pxr/pxr.h"
+#include "pxr/usd/sdf/api.h"
+
+#include <cstdint>
+#include <map>
+#include <stdexcept>
+
+#define SDF_STORAGE_ADMISSION_VERSION 1u
+
+PXR_NAMESPACE_OPEN_SCOPE
+
+class SdfPath;
+class TfToken;
+class VtValue;
+
+enum class SdfStorageAdmissionStatus : uint32_t
+{
+    Ready,
+    Absent,
+    UnsupportedStore,
+    UnsupportedType,
+    QuotaExceeded,
+    InvalidData,
+    Stale
+};
+
+struct SdfStorageAdmissionLimits
+{
+    uint64_t maximumItems = 1048576;
+    uint64_t maximumUtf8Bytes = 8388608;
+    uint64_t maximumDecodeWork = 67108864;
+    uint64_t maximumPeakMaterializationBytes = 67108864;
+    uint64_t maximumTotalMaterializationBytes = 67108864;
+};
+
+struct SdfStorageAdmissionStatistics
+{
+    uint64_t items = 0;
+    uint64_t utf8Bytes = 0;
+    uint64_t decodeWork = 0;
+    uint64_t peakMaterializationBytes = 0;
+    uint64_t totalMaterializationBytes = 0;
+    uint64_t readCount = 0;
+};
+
+struct SdfStorageAdmissionResult
+{
+    SdfStorageAdmissionStatus status = SdfStorageAdmissionStatus::Absent;
+    // Only observed serialized/resident item counts are known. A refusal before
+    // reading them is not an empty value. Only Ready denotes complete admission;
+    // failed reads may contain partial observed counts, including validation reads.
+    bool countKnown = false;
+    bool resident = false;
+    uint64_t itemCount = 0;
+    uint64_t utf8Bytes = 0;
+    uint64_t decodeWork = 0;
+    uint64_t materializationBytes = 0;
+    uint64_t storeIdentity = 0;
+    uint64_t storeGeneration = 0;
+};
+
+#if defined(_MSC_VER)
+class SdfStorageAdmissionError : public std::runtime_error
+#else
+class SDF_API SdfStorageAdmissionError : public std::runtime_error
+#endif
+{
+public:
+    SDF_API explicit SdfStorageAdmissionError(SdfStorageAdmissionStatus status);
+    SDF_API SdfStorageAdmissionStatus GetStatus() const noexcept { return _status; }
+private:
+    SdfStorageAdmissionStatus _status;
+};
+
+/// Optional native-only scoped admission for reads from known crate stores.
+/// Inactive scopes do not change ordinary SDK behavior. A scope never reopens
+/// an asset, replaces a layer or executes scene-authored commands.
+/// Reservations are retained until scope destruction, so peak is a conservative
+/// bound even when callers retain values from earlier reads. Read counts include
+/// repeated detaches; GetLastResult describes the last materializing field read,
+/// not an existence-only Has or a missing field. Unknown serialized types and
+/// generic ArAsset readers are refused, not represented by an invented count.
+/// Nesting is refused before replacing the active scope; an enclosing failure
+/// remains sticky. A failed nested construction leaves the enclosing scope current.
+class SdfStorageAdmissionScope
+{
+public:
+    SDF_API explicit SdfStorageAdmissionScope(const SdfStorageAdmissionLimits& limits);
+    SDF_API ~SdfStorageAdmissionScope();
+    SdfStorageAdmissionScope(const SdfStorageAdmissionScope&) = delete;
+    SdfStorageAdmissionScope& operator=(const SdfStorageAdmissionScope&) = delete;
+
+    SDF_API static uint32_t GetApiVersion() noexcept;
+    SDF_API static SdfStorageAdmissionScope* GetCurrent() noexcept;
+    const SdfStorageAdmissionStatistics& GetStatistics() const noexcept { return _statistics; }
+    const SdfStorageAdmissionResult& GetLastResult() const noexcept { return _last; }
+
+    /// Reserve caller-known composition/copy allocations against the same
+    /// cumulative budget used by every native repeat read.
+    SDF_API void ReserveExternalMaterialization(uint64_t bytes);
+    SDF_API void RequireSucceeded() const;
+
+    // SDK storage integration. These operate on actual resident store identity
+    // and generation; they are not permission tokens for a pathname.
+    SDF_API static uint64_t _NewStoreIdentity() noexcept;
+    SDF_API void _BeginRead(uint64_t identity, uint64_t generation, bool resident);
+    SDF_API void _Field(const TfToken& field);
+    SDF_API void _Items(uint64_t count);
+    SDF_API void _Text(uint64_t bytes);
+    SDF_API void _Decode(uint64_t work);
+    SDF_API void _Materialization(uint64_t bytes);
+    SDF_API void _PathText(const SdfPath& path);
+    SDF_API void _ResidentValue(const VtValue& value);
+    [[noreturn]] SDF_API void _Fail(SdfStorageAdmissionStatus status);
+
+private:
+    SdfStorageAdmissionLimits _limits;
+    SdfStorageAdmissionStatistics _statistics;
+    SdfStorageAdmissionResult _last;
+    SdfStorageAdmissionStatus _failure = SdfStorageAdmissionStatus::Ready;
+    std::map<uint64_t, uint64_t> _generations;
+    SdfStorageAdmissionScope* _previous;
+};
