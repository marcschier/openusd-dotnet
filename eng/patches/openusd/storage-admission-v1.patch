+template <typename T>
+void _AdmitListComposition(const SdfListOp<T>& op, const std::vector<T>* input,
+                          const SdfListOp<T>* inner)
+{
+    auto* scope = SdfStorageAdmissionScope::GetCurrent();
+    if (!scope) return;
+    scope->RequireSucceeded();
+    if constexpr (!std::is_same_v<T, TfToken> && !std::is_same_v<T, SdfPath>)
+        scope->_Fail(SdfStorageAdmissionStatus::UnsupportedType);
+    uint64_t count = _AdmitListStorage(op, *scope);
+    if (inner) count += _AdmitListStorage(*inner, *scope);
+    if (input)
+    {
+        count += _AdmitListItems(*input, *scope);
+    }
+    // Pinned ApplyOperations uses temporary list/map nodes and result vectors;
+    // the list-op-over-list-op overload also performs quadratic linear searches.
+    uint64_t comparisons = count;
+    if (inner) comparisons *= count;
+    else for (auto remaining = count; remaining > 0; remaining >>= 1) comparisons += count;
+    scope->_Decode(comparisons);
+    scope->ReserveExternalMaterialization(count * (128 + sizeof(T) * 12) + 512);
+}
