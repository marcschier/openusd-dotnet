+uint64_t
+CrateFile::_StorageLength(SdfStorageAdmissionScope& scope) const
+{
+    if (_useMmap && _mmapSrc) return _mmapSrc.GetLength();
+    if (_preadSrc && _preadSrc.length >= 0) return static_cast<uint64_t>(_preadSrc.length);
+    if (_assetSrc) scope._Fail(SdfStorageAdmissionStatus::UnsupportedStore);
+    scope._Fail(SdfStorageAdmissionStatus::InvalidData);
+}
+
+class CrateFile::_StorageCursor
+{
+public:
+    _StorageCursor(const CrateFile& file, SdfStorageAdmissionScope& scope, uint64_t offset)
+        : _file(file), _scope(scope), _offset(offset), _length(file._StorageLength(scope)) {}
+
+    template <typename T>
+    T Read()
+    {
+        Check(sizeof(T));
+        _scope._Decode(sizeof(T));
+        T result{};
+        _file._ReadRawBytes(static_cast<int64_t>(_offset), sizeof(T), reinterpret_cast<char*>(&result));
+        _offset += sizeof(T);
+        return result;
+    }
+
+    void Skip(uint64_t bytes)
+    {
+        Check(bytes);
+        _scope._Decode(bytes);
+        _offset += bytes;
+    }
+
+    void Check(uint64_t bytes) const
+    {
+        if (_offset > _length || bytes > _length - _offset ||
+            _offset > static_cast<uint64_t>(INT64_MAX))
+            _scope._Fail(SdfStorageAdmissionStatus::InvalidData);
+    }
+
+private:
+    const CrateFile& _file;
+    SdfStorageAdmissionScope& _scope;
+    uint64_t _offset;
+    uint64_t _length;
+};
