{
  "$schemaVersion": 1,
  "$comment": [
    "Reviewed map from the pinned OpenUSD schema registry to the managed facades.",
    "Hand-authored: every entry is a deliberate statement about what the public",
    "OpenUsd assembly represents. schema-registry.g.json is the generated ground",
    "truth; OpenUsdSchemaCoverageContractTests joins the two and fails when a",
    "schema or a declared property is neither mapped nor listed as an exception.",
    "Property names are the ones the schema itself declares; inherited properties",
    "are stated once, on the schema that introduces them.",
    "UsdPhysics* here is the standard usdPhysics library shipped by OpenUSD, which",
    "the OpenUsd.Physics facades wrap. The repository-owned codeless plugin under",
    "schemas/openUsdPhysics is a separate surface with its own generator and tests."
  ],
  "assembly": "OpenUsd",
  "exceptionReasons": {
    "noFacade": "No managed facade represents this schema. Prims and properties of this type remain reachable through UsdPrim and its generic typed accessors.",
    "versionedSuccessor": "A versioned successor schema shipped by the pinned OpenUSD release. The facades target the predecessor that authoring tools still write, and adopting the successor is a separate, deliberate API change.",
    "genericAccessorOnly": "Declared by a schema the facades cover, but no typed facade member represents this property. It is authored and read through the generic UsdPrim typed accessors.",
    "genericRelationshipOnly": "Declared by a schema the facades cover, but no typed facade member represents this relationship. It is authored and read through UsdPrim.GetRelationship.",
    "collectionBacked": "Backed by UsdCollectionAPI, which the managed surface does not model as a typed facade.",
    "transformStackOnly": "The facade authors and reads the composed local transform and the reset-xform-stack flag; the raw xformOp stack order is not surfaced."
  },
