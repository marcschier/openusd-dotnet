class OpenUsdPhysicsFixedTendon "OpenUsdPhysicsFixedTendon" (
    customData = {
        string className = "FixedTendon"
    }
    doc = """A fixed tendon coupling articulation joint axes through a linear gearing relation. Modelled as a prim rather than an applied schema so one articulation can carry several tendons."""

    inherits = </Typed>
)
{
    rel openUsdPhysics:fixedTendon:articulation (
        displayName = "Articulation"
        doc = """Single articulation root prim the tendon belongs to."""
    )

    double openUsdPhysics:fixedTendon:damping = 0 (
        displayName = "Damping"
        doc = """Damping of the tendon length constraint."""
    )

    bool openUsdPhysics:fixedTendon:enabled = true (
        displayName = "Enabled"
        doc = """Enables this tendon."""
    )

    float[] openUsdPhysics:fixedTendon:forceCoefficients = [] (
        displayName = "Force Coefficients"
        doc = """Fraction of the tendon force applied to each joint axis, in the order of the joints relationship."""
    )

    float[] openUsdPhysics:fixedTendon:gearings = [] (
        displayName = "Gearings"
        doc = """Gearing applied to each joint axis, in the order of the joints relationship."""
    )

    rel openUsdPhysics:fixedTendon:joints (
        displayName = "Joints"
        doc = """Ordered joint prims coupled by this tendon. Each entry pairs with one gearing and one force coefficient."""
    )

    double openUsdPhysics:fixedTendon:limitStiffness = 0 (
        displayName = "Limit Stiffness"
        doc = """Spring stiffness applied once the tendon length leaves the limit range."""
    )

    double openUsdPhysics:fixedTendon:lowerLimit = -inf (
        displayName = "Lower Limit"
        doc = """Lower bound of the tendon length limit range."""
    )

    double openUsdPhysics:fixedTendon:offset = 0 (
        displayName = "Offset"
        doc = """Constant added to the geared sum of the joint axis positions."""
    )

    double openUsdPhysics:fixedTendon:restLength = 0 (
        displayName = "Rest Length"
        doc = """Tendon length at which the spring applies no force."""
    )

    rel openUsdPhysics:fixedTendon:rootJoint (
        displayName = "Root Joint"
        doc = """Single joint prim closest to the articulation root. Defines the tendon traversal order."""
    )

    double openUsdPhysics:fixedTendon:stiffness = 0 (
        displayName = "Stiffness"
        doc = """Spring stiffness of the tendon length constraint."""
    )

    double openUsdPhysics:fixedTendon:upperLimit = inf (
        displayName = "Upper Limit"
        doc = """Upper bound of the tendon length limit range."""
    )
}

class OpenUsdPhysicsSpatialTendon "OpenUsdPhysicsSpatialTendon" (
    customData = {
        string className = "SpatialTendon"
    }
    doc = """A spatial tendon constraining distances between attachment points on an articulation. Attachment points carry OpenUsdPhysicsTendonAttachmentAPI."""

    inherits = </Typed>
)
{
    rel openUsdPhysics:spatialTendon:articulation (
        displayName = "Articulation"
        doc = """Single articulation root prim the tendon belongs to."""
    )

    double openUsdPhysics:spatialTendon:damping = 0 (
        displayName = "Damping"
        doc = """Damping of the tendon length constraint."""
    )

    bool openUsdPhysics:spatialTendon:enabled = true (
        displayName = "Enabled"
        doc = """Enables this tendon."""
    )

    double openUsdPhysics:spatialTendon:limitStiffness = 0 (
        displayName = "Limit Stiffness"
        doc = """Spring stiffness applied once the tendon length leaves the limit range."""
    )

    double openUsdPhysics:spatialTendon:offset = 0 (
        displayName = "Offset"
        doc = """Constant added to the accumulated tendon length."""
    )

    rel openUsdPhysics:spatialTendon:rootAttachment (
        displayName = "Root Attachment"
        doc = """Single prim carrying OpenUsdPhysicsTendonAttachmentAPI with the 'root' role. The remaining attachments are reached through their parent relationships."""
    )

    double openUsdPhysics:spatialTendon:stiffness = 0 (
        displayName = "Stiffness"
        doc = """Spring stiffness of the tendon length constraint."""
    )
}

class "OpenUsdPhysicsTendonAttachmentAPI" (
    customData = {
        string className = "TendonAttachmentAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """One attachment point of a spatial tendon. Apply to a link prim of the articulation that owns the tendon."""

    inherits = </APISchemaBase>
)
{
    double openUsdPhysics:tendonAttachment:gearing = 1 (
        displayName = "Gearing"
        doc = """Gearing applied to the distance between this attachment and its parent."""
    )

    float3 openUsdPhysics:tendonAttachment:localPosition = (0, 0, 0) (
        displayName = "Local Position"
        doc = """Attachment point in the local space of the prim, in stage linear units."""
    )

    double openUsdPhysics:tendonAttachment:lowerLimit = -inf (
        displayName = "Lower Limit"
        doc = """Lower bound of the tendon length limit range. Applies to 'leaf' attachments."""
    )

    rel openUsdPhysics:tendonAttachment:parentAttachment (
        displayName = "Parent Attachment"
        doc = """Single prim carrying the parent attachment. Absent on the 'root' attachment."""
    )

    double openUsdPhysics:tendonAttachment:restLength = 0 (
        displayName = "Rest Length"
        doc = """Tendon length at which the spring applies no force. Applies to 'leaf' attachments."""
    )

    uniform token openUsdPhysics:tendonAttachment:role = "intermediate" (
        allowedTokens = ["root", "intermediate", "leaf"]
        displayName = "Role"
        doc = """Position of this attachment in the tendon tree. Limits and rest length apply to 'leaf' attachments only."""
    )

    rel openUsdPhysics:tendonAttachment:tendon (
        displayName = "Tendon"
        doc = """Single OpenUsdPhysicsSpatialTendon prim this attachment belongs to."""
    )

    double openUsdPhysics:tendonAttachment:upperLimit = inf (
        displayName = "Upper Limit"
        doc = """Upper bound of the tendon length limit range. Applies to 'leaf' attachments."""
    )
}

class "OpenUsdPhysicsMimicJointAPI" (
    customData = {
        string className = "MimicJointAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Couples one articulation joint axis to an axis of another joint through a linear gearing relation. Apply to the joint prim that follows the reference."""

    inherits = </APISchemaBase>
)
{
    uniform token openUsdPhysics:mimicJoint:axis = "rotX" (
        allowedTokens = ["transX", "transY", "transZ", "rotX", "rotY", "rotZ"]
        displayName = "Axis"
        doc = """Axis of this joint that follows the reference axis."""
    )

    double openUsdPhysics:mimicJoint:dampingRatio = 0 (
        displayName = "Damping Ratio"
        doc = """Damping ratio of the coupling constraint. Ignored when the natural frequency is zero."""
    )

    bool openUsdPhysics:mimicJoint:enabled = true (
        displayName = "Enabled"
        doc = """Enables the coupling."""
    )

    double openUsdPhysics:mimicJoint:gearing = 1 (
        displayName = "Gearing"
        doc = """Ratio between the reference axis position and this axis position."""
    )

    double openUsdPhysics:mimicJoint:naturalFrequency = 0 (
        displayName = "Natural Frequency"
        doc = """Natural frequency of the coupling constraint. Zero requests a rigid coupling."""
    )

    double openUsdPhysics:mimicJoint:offset = 0 (
        displayName = "Offset"
        doc = """Constant added to the geared reference axis position."""
    )

    uniform token openUsdPhysics:mimicJoint:referenceAxis = "rotX" (
        allowedTokens = ["transX", "transY", "transZ", "rotX", "rotY", "rotZ"]
        displayName = "Reference Axis"
        doc = """Axis of the reference joint that drives this joint."""
    )

    rel openUsdPhysics:mimicJoint:referenceJoint (
        displayName = "Reference Joint"
        doc = """Single joint prim that drives this joint."""
    )
}

class "OpenUsdPhysicsParticleSystemAPI" (
    customData = {
        string className = "ParticleSystemAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """A position-based-dynamics particle system that owns particle sets, particle cloth, and fluids. Apply to a prim that represents the system."""

    inherits = </APISchemaBase>
)
{
    double openUsdPhysics:particleSystem:contactOffset = -1 (
        displayName = "Contact Offset"
        doc = """Distance at which particle contacts with other objects are generated, in stage linear units. A negative value requests the runtime default."""
    )

    bool openUsdPhysics:particleSystem:enableCCD = false (
        displayName = "Enable CCD"
        doc = """Enables continuous collision detection for particles of this system."""
    )

    bool openUsdPhysics:particleSystem:enabled = true (
        displayName = "Enabled"
        doc = """Enables the particle system."""
    )

    double openUsdPhysics:particleSystem:fluidRestOffset = -1 (
        displayName = "Fluid Rest Offset"
        doc = """Separation kept at rest between two fluid particles, in stage linear units. A negative value requests the runtime default."""
    )

    bool openUsdPhysics:particleSystem:globalSelfCollisionEnabled = true (
        displayName = "Global Self Collision Enabled"
        doc = """Enables collisions between particles of different particle groups."""
    )

    double openUsdPhysics:particleSystem:maxDepenetrationVelocity = inf (
        displayName = "Max Depenetration Velocity"
        doc = """Upper bound on the velocity applied to resolve particle penetration."""
    )

    uniform int64 openUsdPhysics:particleSystem:maxNeighborhood = 96 (
        displayName = "Max Neighborhood"
        doc = """Maximum number of neighbours tracked per particle."""
    )

    double openUsdPhysics:particleSystem:neighborhoodScale = 1.01 (
        displayName = "Neighborhood Scale"
        doc = """Scale applied to the particle contact offset when building the neighbourhood."""
    )

    bool openUsdPhysics:particleSystem:nonParticleCollisionEnabled = true (
        displayName = "Non Particle Collision Enabled"
        doc = """Enables collisions between particles and rigid or deformable geometry."""
    )

    double openUsdPhysics:particleSystem:particleContactOffset = -1 (
        displayName = "Particle Contact Offset"
        doc = """Distance at which particle-particle contacts are generated, in stage linear units. A negative value requests the runtime default."""
    )

    double openUsdPhysics:particleSystem:restOffset = -1 (
        displayName = "Rest Offset"
        doc = """Separation kept at rest between particles and other objects, in stage linear units. A negative value requests the runtime default."""
    )

    rel openUsdPhysics:particleSystem:simulationOwner (
        displayName = "Simulation Owner"
        doc = """Single PhysicsScene that simulates this particle system."""
    )

    double openUsdPhysics:particleSystem:solidRestOffset = -1 (
        displayName = "Solid Rest Offset"
        doc = """Separation kept at rest between two solid particles, in stage linear units. A negative value requests the runtime default."""
    )

    uniform int64 openUsdPhysics:particleSystem:solverPositionIterationCount = 4 (
        displayName = "Solver Position Iteration Count"
        doc = """Solver position iterations per simulation step for this system."""
    )

    float3 openUsdPhysics:particleSystem:wind = (0, 0, 0) (
        displayName = "Wind"
        doc = """Wind velocity applied to the system in stage space, in stage linear units per second."""
    )
}

class "OpenUsdPhysicsParticleSetAPI" (
    customData = {
        string className = "ParticleSetAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Turns the points of a UsdGeomPointBased prim into simulated particles. Apply alongside the geometry that supplies the points."""

    inherits = </APISchemaBase>
)
{
    bool openUsdPhysics:particleSet:enabled = true (
        displayName = "Enabled"
        doc = """Enables simulation of this particle set."""
    )

    bool openUsdPhysics:particleSet:fluid = false (
        displayName = "Fluid"
        doc = """Simulates the particles with the fluid constraint model instead of the solid one."""
    )

    double openUsdPhysics:particleSet:mass = 0 (
        displayName = "Mass"
        doc = """Total mass of the set in stage mass units. Zero requests a mass derived from the material density and the particle volume."""
    )

    rel openUsdPhysics:particleSet:material (
        displayName = "Material"
        doc = """Single material prim carrying OpenUsdPhysicsPbdMaterialAPI."""
    )

    uniform int64 openUsdPhysics:particleSet:particleGroup = 0 (
        displayName = "Particle Group"
        doc = """Group index used to filter particle-particle collisions."""
    )

    rel openUsdPhysics:particleSet:particleSystem (
        displayName = "Particle System"
        doc = """Single prim carrying OpenUsdPhysicsParticleSystemAPI that owns these particles."""
    )

    float3[] openUsdPhysics:particleSet:restPoints = [] (
        displayName = "Rest Points"
        doc = """Rest configuration of the particles in local space. When empty the authored geometry points are used."""
    )

    bool openUsdPhysics:particleSet:selfCollision = true (
        displayName = "Self Collision"
        doc = """Enables collisions between particles of this set."""
    )
}

class "OpenUsdPhysicsParticleClothAPI" (
