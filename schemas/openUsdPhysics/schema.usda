class OpenUsdPhysicsAttachment "OpenUsdPhysicsAttachment" (
    customData = {
        string className = "Attachment"
    }
    doc = """Attaches two simulated actors to each other. Modelled as a prim so one actor can take part in several attachments."""

    inherits = </Typed>
)
{
    rel openUsdPhysics:attachment:actor0 (
        displayName = "Actor 0"
        doc = """Single first actor prim. May be a rigid body, a surface deformable, a volume deformable, or a particle object."""
    )

    rel openUsdPhysics:attachment:actor1 (
        displayName = "Actor 1"
        doc = """Single second actor prim. May be a rigid body, a surface deformable, a volume deformable, or a particle object."""
    )

    uniform token openUsdPhysics:attachment:attachmentType = "vertex" (
        allowedTokens = ["vertex", "element", "surface", "rigidSurface"]
        displayName = "Attachment Type"
        doc = """How the attachment points bind to each actor."""
    )

    int[] openUsdPhysics:attachment:collisionFilterIndices0 = [] (
        displayName = "Collision Filter Indices 0"
        doc = """Elements or vertices of the first actor excluded from collision with the second actor."""
    )

    int[] openUsdPhysics:attachment:collisionFilterIndices1 = [] (
        displayName = "Collision Filter Indices 1"
        doc = """Elements or vertices of the second actor excluded from collision with the first actor."""
    )

    double openUsdPhysics:attachment:damping = 0 (
        displayName = "Damping"
        doc = """Damping of the attachment constraint. Ignored when the stiffness is zero."""
    )

    int[] openUsdPhysics:attachment:elementIndices0 = [] (
        displayName = "Element Indices 0"
        doc = """Element index bound by each attachment point on the first actor. Empty selects vertex binding."""
    )

    int[] openUsdPhysics:attachment:elementIndices1 = [] (
        displayName = "Element Indices 1"
        doc = """Element index bound by each attachment point on the second actor. Empty selects vertex binding."""
    )

    bool openUsdPhysics:attachment:enabled = true (
        displayName = "Enabled"
        doc = """Enables this attachment."""
    )

    uniform token openUsdPhysics:attachment:filterType0 = "none" (
        allowedTokens = ["none", "vertices", "elements", "geometry"]
        displayName = "Filter Type 0"
        doc = """How the first collision filter index list is interpreted."""
    )

    uniform token openUsdPhysics:attachment:filterType1 = "none" (
        allowedTokens = ["none", "vertices", "elements", "geometry"]
        displayName = "Filter Type 1"
        doc = """How the second collision filter index list is interpreted."""
    )

    float3[] openUsdPhysics:attachment:points0 = [] (
        displayName = "Points 0"
        doc = """Attachment points in the local space of the first actor, in stage linear units."""
    )

    float3[] openUsdPhysics:attachment:points1 = [] (
        displayName = "Points 1"
        doc = """Attachment points in the local space of the second actor, paired with the first actor points."""
    )

    double openUsdPhysics:attachment:stiffness = 0 (
        displayName = "Stiffness"
        doc = """Spring stiffness of the attachment constraint. Zero requests a rigid attachment."""
    )
}

class "OpenUsdPhysicsAutoAttachmentAPI" (
    customData = {
        string className = "AutoAttachmentAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Derives the attachment points and collision filters of an OpenUsdPhysicsAttachment from the overlap of its two actors. Apply to the attachment prim."""

    inherits = </APISchemaBase>
)
{
    double openUsdPhysics:autoAttachment:collisionFilteringOffset = 0 (
        displayName = "Collision Filtering Offset"
        doc = """Distance added to the region used to generate collision filters, in stage linear units."""
    )

    double openUsdPhysics:autoAttachment:deformableVertexOverlapOffset = 0 (
        displayName = "Deformable Vertex Overlap Offset"
        doc = """Distance added to the overlap test for deformable vertices, in stage linear units."""
    )

    bool openUsdPhysics:autoAttachment:enableCollisionFiltering = true (
        displayName = "Enable Collision Filtering"
        doc = """Generates collision filters for the attached regions."""
    )

    bool openUsdPhysics:autoAttachment:enableDeformableFilteringPairs = true (
        displayName = "Enable Deformable Filtering Pairs"
        doc = """Generates element-level filter pairs when both actors are deformable."""
    )

    bool openUsdPhysics:autoAttachment:enableDeformableVertexAttachments = true (
        displayName = "Enable Deformable Vertex Attachments"
        doc = """Generates attachments at deformable vertices that overlap the other actor."""
    )

    bool openUsdPhysics:autoAttachment:enableRigidSurfaceAttachments = true (
        displayName = "Enable Rigid Surface Attachments"
        doc = """Generates attachments by sampling the surface of a rigid actor."""
    )

    bool openUsdPhysics:autoAttachment:enabled = true (
        displayName = "Enabled"
        doc = """Enables automatic generation. Authored attachment points are replaced when this is on."""
    )

    rel openUsdPhysics:autoAttachment:maskShapes (
        displayName = "Mask Shapes"
        doc = """Geometry prims that restrict where attachments may be generated."""
    )

    double openUsdPhysics:autoAttachment:rigidSurfaceSamplingDistance = 0 (
        displayName = "Rigid Surface Sampling Distance"
        doc = """Spacing of the rigid surface samples in stage linear units. Zero requests a spacing derived from the geometry."""
    )
}

class "OpenUsdPhysicsCollisionFilterSettingsAPI" (
    customData = {
        string className = "CollisionFilterSettingsAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Collision filtering that standard UsdPhysicsFilteredPairsAPI and UsdPhysicsCollisionGroup do not express, including element-level filtering for deformables and particles."""

    inherits = </APISchemaBase>
)
{
    bool openUsdPhysics:collisionFilter:enabled = true (
        displayName = "Enabled"
        doc = """Enables the filters declared here."""
    )

    rel openUsdPhysics:collisionFilter:filterGroups (
        displayName = "Filter Groups"
        doc = """UsdPhysicsCollisionGroup prims this object must not collide with, or may only collide with when the groups are inverted."""
    )

    int[] openUsdPhysics:collisionFilter:filterIndices = [] (
        displayName = "Filter Indices"
        doc = """Vertex or element indices on this prim excluded from collision with the filtered pairs."""
    )

    rel openUsdPhysics:collisionFilter:filteredPairs (
        displayName = "Filtered Pairs"
        doc = """Prims this object must not collide with."""
    )

    bool openUsdPhysics:collisionFilter:invertFilteredGroups = false (
        displayName = "Invert Filtered Groups"
        doc = """Treats the filtered groups as the only groups this object may collide with."""
    )

    string openUsdPhysics:collisionFilter:mergeGroupName = "" (
        displayName = "Merge Group Name"
        doc = """Objects sharing a non-empty merge group name never collide with each other."""
    )

    uniform token openUsdPhysics:collisionFilter:pairFilterMode = "pairs" (
        allowedTokens = ["none", "pairs", "groups", "vertexPairs", "elementPairs"]
        displayName = "Pair Filter Mode"
        doc = """How the filtered pairs and filter indices are interpreted."""
    )
}

class "OpenUsdPhysicsCookedDataAPI" (
    customData = {
        string className = "CookedDataAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """References cached cooked collision data produced at build time so a session does not have to cook geometry while loading. Apply alongside a collider."""

    inherits = </APISchemaBase>
)
{
    string openUsdPhysics:cookedData:assetPath = "" (
        displayName = "Asset Path"
        doc = """Path of the cooked data asset, resolved against the layer that authored this opinion."""
    )

    string openUsdPhysics:cookedData:assetSubIdentifier = "" (
        displayName = "Asset Sub Identifier"
        doc = """Entry inside the cooked data asset. Empty selects the only entry."""
    )

    string openUsdPhysics:cookedData:buildRevision = "" (
        displayName = "Build Revision"
        doc = """Opaque revision of the tool that produced the cooked data."""
    )

    string openUsdPhysics:cookedData:contentHash = "" (
        displayName = "Content Hash"
        doc = """Hash of the source geometry and cooking parameters the cached data was produced from. A mismatch invalidates the cache."""
    )

    bool openUsdPhysics:cookedData:enabled = true (
        displayName = "Enabled"
        doc = """Enables the cooked data reference."""
    )

    uniform token openUsdPhysics:cookedData:format = "none" (
        allowedTokens = ["none", "convexMesh", "convexDecomposition", "triangleMesh", "heightField", "sdf", "tetrahedralMesh"]
        displayName = "Format"
        doc = """Kind of cooked data referenced here."""
    )

    uniform token openUsdPhysics:cookedData:missingDataBehavior = "cookAtRuntime" (
        allowedTokens = ["cookAtRuntime", "error", "ignore"]
        displayName = "Missing Data Behavior"
        doc = """What the session does when the cooked data is absent or its content hash does not match."""
    )

    uniform token openUsdPhysics:cookedData:sdfBitsPerSubgridPixel = "bits16" (
        allowedTokens = ["bits8", "bits16", "bits32"]
        displayName = "SDF Bits Per Subgrid Pixel"
        doc = """Storage precision of one sparse grid sample for the 'sdf' format."""
    )

    double openUsdPhysics:cookedData:sdfNarrowBandThickness = 0.01 (
        displayName = "SDF Narrow Band Thickness"
        doc = """Thickness of the narrow band kept around the surface, as a fraction of the longest bounding box axis."""
    )

    uniform int64 openUsdPhysics:cookedData:sdfResolution = 256 (
        displayName = "SDF Resolution"
        doc = """Grid resolution along the longest bounding box axis for the 'sdf' format."""
    )

    uniform int64 openUsdPhysics:cookedData:sdfSubgridResolution = 6 (
        displayName = "SDF Subgrid Resolution"
        doc = """Sparse block resolution for the 'sdf' format. Zero requests a dense grid."""
    )
}
