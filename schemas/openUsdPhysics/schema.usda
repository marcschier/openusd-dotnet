        displayName = "Material"
        doc = """Single material prim carrying OpenUsdPhysicsPbdMaterialAPI."""
    )

    uniform int64 openUsdPhysics:particleCloth:particleGroup = 0 (
        displayName = "Particle Group"
        doc = """Group index used to filter particle-particle collisions."""
    )

    rel openUsdPhysics:particleCloth:particleSystem (
        displayName = "Particle System"
        doc = """Single prim carrying OpenUsdPhysicsParticleSystemAPI that owns these particles."""
    )

    double openUsdPhysics:particleCloth:pressure = 0 (
        displayName = "Pressure"
        doc = """Inflation pressure for closed meshes. Zero disables the pressure constraint."""
    )

    float3[] openUsdPhysics:particleCloth:restPoints = [] (
        displayName = "Rest Points"
        doc = """Rest configuration of the cloth particles in local space. When empty the authored mesh points are used."""
