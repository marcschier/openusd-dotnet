class "OpenUsdPhysicsPbdMaterialAPI" (
    customData = {
        string className = "PbdMaterialAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Material response for position-based-dynamics particles, fluids, and particle cloth. Apply to a UsdShadeMaterial prim."""

    inherits = </APISchemaBase>
)
{
    double openUsdPhysics:pbdMaterial:adhesion = 0 (
        displayName = "Adhesion"
        doc = """Attraction between particles and other objects."""
    )

    double openUsdPhysics:pbdMaterial:adhesionOffsetScale = 0 (
        displayName = "Adhesion Offset Scale"
        doc = """Scale applied to the particle contact offset when evaluating adhesion."""
    )

    double openUsdPhysics:pbdMaterial:cflCoefficient = 1 (
        displayName = "CFL Coefficient"
        doc = """Courant-Friedrichs-Lewy coefficient limiting the fluid time step."""
    )

    double openUsdPhysics:pbdMaterial:cohesion = 0 (
        displayName = "Cohesion"
        doc = """Attraction between particles of the same set."""
    )

    double openUsdPhysics:pbdMaterial:damping = 0 (
        displayName = "Damping"
        doc = """Velocity damping applied to the particles."""
    )

    double openUsdPhysics:pbdMaterial:density = 0 (
        displayName = "Density"
        doc = """Particle density in stage mass units per cubic linear unit. Zero requests the runtime default."""
    )

    double openUsdPhysics:pbdMaterial:drag = 0 (
        displayName = "Drag"
        doc = """Aerodynamic drag coefficient applied to particle cloth."""
    )

    double openUsdPhysics:pbdMaterial:friction = 0.2 (
        displayName = "Friction"
        doc = """Friction coefficient between particles and other objects."""
    )

    double openUsdPhysics:pbdMaterial:gravityScale = 1 (
        displayName = "Gravity Scale"
        doc = """Scale applied to scene gravity for these particles."""
    )

    double openUsdPhysics:pbdMaterial:lift = 0 (
        displayName = "Lift"
        doc = """Aerodynamic lift coefficient applied to particle cloth."""
    )

    double openUsdPhysics:pbdMaterial:particleAdhesionScale = 1 (
        displayName = "Particle Adhesion Scale"
        doc = """Scale applied to the adhesion for particle-particle contacts."""
    )

    double openUsdPhysics:pbdMaterial:particleFrictionScale = 1 (
        displayName = "Particle Friction Scale"
        doc = """Scale applied to the friction coefficient for particle-particle contacts."""
    )

    double openUsdPhysics:pbdMaterial:surfaceTension = 0 (
        displayName = "Surface Tension"
        doc = """Fluid surface tension."""
    )

    double openUsdPhysics:pbdMaterial:viscosity = 0 (
        displayName = "Viscosity"
        doc = """Fluid viscosity. Ignored for solid particles."""
    )

    double openUsdPhysics:pbdMaterial:vorticityConfinement = 0 (
        displayName = "Vorticity Confinement"
        doc = """Strength of the fluid vorticity confinement term."""
    )
}

class "OpenUsdPhysicsDiffuseParticlesAPI" (
    customData = {
        string className = "DiffuseParticlesAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Spray, foam, and bubble particles generated from a fluid particle set. Apply alongside OpenUsdPhysicsParticleSetAPI."""

    inherits = </APISchemaBase>
)
{
    double openUsdPhysics:diffuseParticles:airDrag = 0 (
        displayName = "Air Drag"
        doc = """Drag applied to diffuse particles outside the fluid."""
    )

    double openUsdPhysics:diffuseParticles:bubbleDrag = 0.9 (
        displayName = "Bubble Drag"
        doc = """Drag applied to diffuse particles inside the fluid."""
    )

    double openUsdPhysics:diffuseParticles:buoyancy = 1 (
        displayName = "Buoyancy"
        doc = """Buoyancy applied to diffuse particles inside the fluid."""
    )

    double openUsdPhysics:diffuseParticles:collisionDecay = 0.5 (
        displayName = "Collision Decay"
        doc = """Fraction of the remaining lifetime removed when a diffuse particle collides."""
    )

    double openUsdPhysics:diffuseParticles:divergenceWeight = 1 (
        displayName = "Divergence Weight"
        doc = """Weight of the divergence term in the spawn potential."""
    )

    bool openUsdPhysics:diffuseParticles:enabled = false (
        displayName = "Enabled"
        doc = """Enables diffuse particle generation."""
    )

    double openUsdPhysics:diffuseParticles:kineticEnergyWeight = 0 (
        displayName = "Kinetic Energy Weight"
        doc = """Weight of the kinetic energy term in the spawn potential."""
    )

    double openUsdPhysics:diffuseParticles:lifetime = 5 (
        displayName = "Lifetime"
        doc = """Diffuse particle lifetime in seconds."""
    )

    double openUsdPhysics:diffuseParticles:maxParticleMultiplier = 0.5 (
        displayName = "Max Particle Multiplier"
        doc = """Upper bound on the diffuse particle count as a multiple of the fluid particle count."""
    )

    double openUsdPhysics:diffuseParticles:pressureWeight = 1 (
        displayName = "Pressure Weight"
        doc = """Weight of the pressure term in the spawn potential."""
    )

    double openUsdPhysics:diffuseParticles:threshold = 100 (
        displayName = "Threshold"
        doc = """Weighted potential above which a diffuse particle is spawned."""
    )

    bool openUsdPhysics:diffuseParticles:useAccurateVelocity = false (
        displayName = "Use Accurate Velocity"
        doc = """Advects diffuse particles with the accurate fluid velocity field at a higher cost."""
    )
}

class "OpenUsdPhysicsParticleAnisotropyAPI" (
    customData = {
        string className = "ParticleAnisotropyAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Anisotropic shaping of fluid particles for surface reconstruction. Apply alongside OpenUsdPhysicsParticleSystemAPI."""

    inherits = </APISchemaBase>
)
{
    bool openUsdPhysics:particleAnisotropy:enabled = false (
        displayName = "Enabled"
        doc = """Enables anisotropic particle shaping."""
    )

    double openUsdPhysics:particleAnisotropy:max = 2 (
        displayName = "Max"
        doc = """Upper bound on an anisotropy axis, as a fraction of the particle radius."""
    )

    double openUsdPhysics:particleAnisotropy:min = 0.1 (
        displayName = "Min"
        doc = """Lower bound on an anisotropy axis, as a fraction of the particle radius."""
    )

    double openUsdPhysics:particleAnisotropy:scale = 1 (
        displayName = "Scale"
        doc = """Scale applied to the computed anisotropy."""
    )
}

class "OpenUsdPhysicsParticleSmoothingAPI" (
    customData = {
        string className = "ParticleSmoothingAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Laplacian smoothing of fluid particle positions used for surface reconstruction. Apply alongside OpenUsdPhysicsParticleSystemAPI."""

    inherits = </APISchemaBase>
)
{
    bool openUsdPhysics:particleSmoothing:enabled = false (
        displayName = "Enabled"
        doc = """Enables position smoothing."""
    )

    double openUsdPhysics:particleSmoothing:strength = 0.8 (
        displayName = "Strength"
        doc = """Smoothing strength between zero and one."""
    )
}

class "OpenUsdPhysicsParticleIsosurfaceAPI" (
    customData = {
        string className = "ParticleIsosurfaceAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Isosurface extraction settings for a fluid particle system. Apply alongside OpenUsdPhysicsParticleSystemAPI."""

    inherits = </APISchemaBase>
)
{
    bool openUsdPhysics:isosurface:enabled = false (
        displayName = "Enabled"
        doc = """Enables isosurface extraction."""
    )

    string openUsdPhysics:isosurface:gridFilteringPasses = "" (
        displayName = "Grid Filtering Passes"
        doc = """Ordered grid filter passes. Each character selects one pass: 's' smooth, 'g' grow, 'r' reduce."""
    )

    double openUsdPhysics:isosurface:gridSmoothingRadius = 0.2 (
        displayName = "Grid Smoothing Radius"
        doc = """Radius of the grid smoothing kernel in stage linear units."""
    )

    double openUsdPhysics:isosurface:gridSpacing = 0.2 (
        displayName = "Grid Spacing"
        doc = """Extraction grid cell size in stage linear units."""
    )

    uniform int64 openUsdPhysics:isosurface:maxSubgrids = 1024 (
        displayName = "Max Subgrids"
        doc = """Upper bound on the number of sparse grid blocks used during extraction."""
    )

    uniform int64 openUsdPhysics:isosurface:maxTriangles = 2097152 (
        displayName = "Max Triangles"
        doc = """Upper bound on the extracted triangle count."""
    )

    uniform int64 openUsdPhysics:isosurface:maxVertices = 1048576 (
        displayName = "Max Vertices"
        doc = """Upper bound on the extracted vertex count."""
    )

    uniform int64 openUsdPhysics:isosurface:numMeshNormalSmoothingPasses = 4 (
        displayName = "Num Mesh Normal Smoothing Passes"
        doc = """Smoothing passes applied to the extracted mesh normals."""
    )

    uniform int64 openUsdPhysics:isosurface:numMeshSmoothingPasses = 4 (
        displayName = "Num Mesh Smoothing Passes"
        doc = """Smoothing passes applied to the extracted mesh positions."""
    )

    double openUsdPhysics:isosurface:surfaceDistance = 0.25 (
        displayName = "Surface Distance"
        doc = """Distance from a particle centre at which the surface is placed, in stage linear units."""
    )
}

class "OpenUsdPhysicsSurfaceDeformableAPI" (
    customData = {
        string className = "SurfaceDeformableAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Simulates a triangulated mesh as a surface deformable solved on its own vertices. Apply alongside the mesh geometry."""

    inherits = </APISchemaBase>
)
{
    uniform int64 openUsdPhysics:surfaceDeformable:collisionIterationMultiplier = 1 (
        displayName = "Collision Iteration Multiplier"
        doc = """Collision iterations performed per solver position iteration."""
    )

    uniform int64 openUsdPhysics:surfaceDeformable:collisionPairUpdateFrequency = 1 (
        displayName = "Collision Pair Update Frequency"
        doc = """Simulation steps between two collision pair rebuilds."""
    )

    bool openUsdPhysics:surfaceDeformable:enableCCD = false (
        displayName = "Enable CCD"
        doc = """Enables continuous collision detection for this surface."""
    )

    bool openUsdPhysics:surfaceDeformable:enabled = true (
        displayName = "Enabled"
        doc = """Enables simulation of this surface deformable."""
    )

    rel openUsdPhysics:surfaceDeformable:material (
        displayName = "Material"
        doc = """Single material prim carrying OpenUsdPhysicsSurfaceDeformableMaterialAPI."""
    )

    double openUsdPhysics:surfaceDeformable:maxDisplacement = 0 (
        displayName = "Max Displacement"
        doc = """Upper bound on the distance a vertex may move in one step, in stage linear units. Zero disables the clamp."""
    )

    float3[] openUsdPhysics:surfaceDeformable:restPoints = [] (
        displayName = "Rest Points"
        doc = """Rest configuration of the simulated vertices in local space. When empty the authored mesh points are used."""
    )

    bool openUsdPhysics:surfaceDeformable:selfCollision = false (
        displayName = "Self Collision"
        doc = """Enables collisions between parts of this surface."""
    )

    double openUsdPhysics:surfaceDeformable:selfCollisionFilterDistance = 0.1 (
        displayName = "Self Collision Filter Distance"
        doc = """Rest distance below which self collisions are filtered, in stage linear units."""
    )

    int[] openUsdPhysics:surfaceDeformable:simulationIndices = [] (
        displayName = "Simulation Indices"
        doc = """Triangle indices of the simulated surface, three indices per triangle. When empty the authored mesh topology is used."""
    )

    rel openUsdPhysics:surfaceDeformable:simulationOwner (
        displayName = "Simulation Owner"
        doc = """Single PhysicsScene that simulates this surface deformable."""
    )

    uniform int64 openUsdPhysics:surfaceDeformable:solverPositionIterationCount = 16 (
        displayName = "Solver Position Iteration Count"
        doc = """Solver position iterations per simulation step."""
    )

    double openUsdPhysics:surfaceDeformable:vertexVelocityDamping = 0.005 (
        displayName = "Vertex Velocity Damping"
        doc = """Velocity damping applied to the simulated vertices."""
    )
}

class "OpenUsdPhysicsSurfaceDeformableMaterialAPI" (
    customData = {
        string className = "SurfaceDeformableMaterialAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Material response for surface deformables. Apply to a UsdShadeMaterial prim."""

    inherits = </APISchemaBase>
)
{
    double openUsdPhysics:surfaceDeformableMaterial:bendingDamping = 0 (
        displayName = "Bending Damping"
        doc = """Damping applied to the bending response."""
    )

    double openUsdPhysics:surfaceDeformableMaterial:bendingStiffness = 0 (
        displayName = "Bending Stiffness"
        doc = """Resistance to bending across shared edges."""
    )

    double openUsdPhysics:surfaceDeformableMaterial:density = 1000 (
        displayName = "Density"
        doc = """Material density in stage mass units per cubic linear unit."""
    )

    double openUsdPhysics:surfaceDeformableMaterial:dynamicFriction = 0.25 (
        displayName = "Dynamic Friction"
        doc = """Friction coefficient against other objects."""
    )

    double openUsdPhysics:surfaceDeformableMaterial:elasticityDamping = 0 (
        displayName = "Elasticity Damping"
        doc = """Damping applied to the stretch response."""
    )

    double openUsdPhysics:surfaceDeformableMaterial:poissonsRatio = 0.45 (
        displayName = "Poissons Ratio"
        doc = """Transverse contraction under stretch, between zero and one half."""
    )

    double openUsdPhysics:surfaceDeformableMaterial:thickness = 0.001 (
        displayName = "Thickness"
        doc = """Simulated shell thickness in stage linear units."""
    )

    double openUsdPhysics:surfaceDeformableMaterial:youngsModulus = 500000 (
        displayName = "Youngs Modulus"
        doc = """Stretch resistance of the surface."""
    )
}

class "OpenUsdPhysicsVolumeDeformableAPI" (
    customData = {
        string className = "VolumeDeformableAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Simulates a closed mesh as a finite-element volume deformable driven by a tetrahedral simulation mesh. Apply alongside the render geometry."""

    inherits = </APISchemaBase>
)
{
    int[] openUsdPhysics:volumeDeformable:collisionIndices = [] (
        displayName = "Collision Indices"
        doc = """Tetrahedron indices of the collision mesh, four indices per tetrahedron."""
    )

    float3[] openUsdPhysics:volumeDeformable:collisionRestPoints = [] (
        displayName = "Collision Rest Points"
        doc = """Rest positions of the collision mesh vertices in local space. When empty the simulation mesh is used for collision."""
    )

    bool openUsdPhysics:volumeDeformable:enableCCD = false (
        displayName = "Enable CCD"
        doc = """Enables continuous collision detection for this volume."""
    )

    bool openUsdPhysics:volumeDeformable:enabled = true (
        displayName = "Enabled"
        doc = """Enables simulation of this volume deformable."""
    )

    bool openUsdPhysics:volumeDeformable:kinematicEnabled = false (
        displayName = "Kinematic Enabled"
        doc = """Drives the simulation mesh from the authored animation instead of the solver."""
    )

    rel openUsdPhysics:volumeDeformable:material (
        displayName = "Material"
        doc = """Single material prim carrying OpenUsdPhysicsVolumeDeformableMaterialAPI."""
    )

    double openUsdPhysics:volumeDeformable:maxDepenetrationVelocity = inf (
        displayName = "Max Depenetration Velocity"
        doc = """Upper bound on the velocity applied to resolve penetration."""
    )

    bool openUsdPhysics:volumeDeformable:selfCollision = false (
        displayName = "Self Collision"
        doc = """Enables collisions between parts of this volume."""
    )

    double openUsdPhysics:volumeDeformable:selfCollisionFilterDistance = 0.1 (
        displayName = "Self Collision Filter Distance"
        doc = """Rest distance below which self collisions are filtered, in stage linear units."""
    )

    double openUsdPhysics:volumeDeformable:settlingThreshold = 0.1 (
        displayName = "Settling Threshold"
        doc = """Mass-normalized kinetic energy below which the body starts accumulating sleep time."""
    )

    uniform int64 openUsdPhysics:volumeDeformable:simulationHexahedralResolution = 10 (
        displayName = "Simulation Hexahedral Resolution"
        doc = """Resolution of the voxel grid used to build a simulation mesh when none is authored."""
    )

    int[] openUsdPhysics:volumeDeformable:simulationIndices = [] (
        displayName = "Simulation Indices"
        doc = """Tetrahedron indices of the simulation mesh, four indices per tetrahedron."""
    )

    rel openUsdPhysics:volumeDeformable:simulationOwner (
        displayName = "Simulation Owner"
        doc = """Single PhysicsScene that simulates this volume deformable."""
    )

    float3[] openUsdPhysics:volumeDeformable:simulationRestPoints = [] (
        displayName = "Simulation Rest Points"
        doc = """Rest positions of the tetrahedral simulation mesh vertices in local space."""
    )

    double openUsdPhysics:volumeDeformable:sleepThreshold = 0.05 (
        displayName = "Sleep Threshold"
        doc = """Mass-normalized kinetic energy below which the body may sleep."""
    )

    uniform int64 openUsdPhysics:volumeDeformable:solverPositionIterationCount = 16 (
        displayName = "Solver Position Iteration Count"
        doc = """Solver position iterations per simulation step."""
    )

    double openUsdPhysics:volumeDeformable:vertexVelocityDamping = 0.005 (
        displayName = "Vertex Velocity Damping"
        doc = """Velocity damping applied to the simulation mesh vertices."""
    )
}

class "OpenUsdPhysicsVolumeDeformableMaterialAPI" (
    customData = {
        string className = "VolumeDeformableMaterialAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Material response for finite-element volume deformables. Apply to a UsdShadeMaterial prim."""

    inherits = </APISchemaBase>
)
{
    double openUsdPhysics:volumeDeformableMaterial:damping = 0 (
        displayName = "Damping"
        doc = """Damping applied to the elastic response."""
    )

    double openUsdPhysics:volumeDeformableMaterial:dampingScale = 1 (
        displayName = "Damping Scale"
        doc = """Scale applied to the damping term."""
    )

    double openUsdPhysics:volumeDeformableMaterial:density = 1000 (
        displayName = "Density"
        doc = """Material density in stage mass units per cubic linear unit."""
    )

    double openUsdPhysics:volumeDeformableMaterial:dynamicFriction = 0.25 (
        displayName = "Dynamic Friction"
        doc = """Friction coefficient against other objects."""
    )

    double openUsdPhysics:volumeDeformableMaterial:elasticityDamping = 0 (
        displayName = "Elasticity Damping"
        doc = """Damping proportional to the elastic strain rate."""
    )

    double openUsdPhysics:volumeDeformableMaterial:poissonsRatio = 0.45 (
        displayName = "Poissons Ratio"
        doc = """Transverse contraction under stretch, between zero and one half."""
    )

    double openUsdPhysics:volumeDeformableMaterial:youngsModulus = 50000000 (
        displayName = "Youngs Modulus"
        doc = """Resistance to deformation of the volume."""
    )
