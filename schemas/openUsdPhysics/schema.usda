        doc = """Rest length per spring, in spring order and in stage linear units."""
    )

    float[] openUsdPhysics:particleCloth:springStiffnesses = [] (
        displayName = "Spring Stiffnesses"
        doc = """Stiffness per spring, in spring order."""
    )
