#usda 1.0
(
    subLayers = [
        @usdGeom/schema.usda@,
        @usdPhysics/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "openUsdPhysics"
        string libraryPath = "./"
        string libraryPrefix = "OpenUsdPhysics"
        bool skipCodeGeneration = true
    }
)
{
}

class "OpenUsdPhysicsSceneAPI" (
    customData = {
        string className = "SceneAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Solver and stepping settings that the standard UsdPhysicsScene schema does not express. Apply to a PhysicsScene prim."""

    inherits = </APISchemaBase>
)
{
    double openUsdPhysics:scene:bounceThreshold = 0.2 (
        displayName = "Bounce Threshold"
        doc = """Relative normal speed below which contacts do not bounce, in stage linear units per second."""
    )

    uniform token openUsdPhysics:scene:broadPhaseType = "abp" (
        allowedTokens = ["sap", "mbp", "abp", "pabp"]
        displayName = "Broad Phase Type"
        doc = """Broad-phase algorithm to use for this scene."""
    )

    uniform bool openUsdPhysics:scene:enableCCD = false (
        displayName = "Enable CCD"
        doc = """Enables continuous collision detection for the whole scene."""
    )

    uniform bool openUsdPhysics:scene:enableEnhancedDeterminism = false (
        displayName = "Enable Enhanced Determinism"
        doc = """Requests additional ordering guarantees at a performance cost."""
    )

    uniform bool openUsdPhysics:scene:enableStabilization = false (
        displayName = "Enable Stabilization"
        doc = """Enables the solver stabilization pass."""
    )

    double openUsdPhysics:scene:frictionCorrelationDistance = 0.025 (
        displayName = "Friction Correlation Distance"
        doc = """Distance used to merge friction anchors, in stage linear units."""
    )

    double openUsdPhysics:scene:frictionOffsetThreshold = 0.04 (
        displayName = "Friction Offset Threshold"
        doc = """Contact separation above which friction anchors are discarded, in stage linear units."""
    )

    uniform token openUsdPhysics:scene:frictionType = "patch" (
        allowedTokens = ["patch", "oneDirectional", "twoDirectional"]
        displayName = "Friction Type"
        doc = """Friction model used when resolving contacts."""
    )

    uniform token openUsdPhysics:scene:gpuRequestMode = "preferred" (
        allowedTokens = ["disabled", "preferred", "required"]
        displayName = "GPU Request Mode"
        doc = """How the session should treat optional GPU acceleration. 'required' turns an unavailable capability into a build failure instead of a per-object diagnostic."""
    )

    double openUsdPhysics:scene:maxBiasCoefficient = inf (
        displayName = "Max Bias Coefficient"
        doc = """Upper bound on the solver penetration bias coefficient."""
    )

    uniform int64 openUsdPhysics:scene:maxSubStepCount = 8 (
        displayName = "Max Sub Step Count"
        doc = """Maximum fixed steps consumed for one transport tick before playback slows down instead of dropping steps."""
    )

    uniform int64 openUsdPhysics:scene:positionIterationCount = 4 (
        displayName = "Position Iteration Count"
        doc = """Solver position iterations per simulation step."""
    )

    uniform bool openUsdPhysics:scene:reportContacts = false (
        displayName = "Report Contacts"
        doc = """Enables scene-wide contact event collection."""
    )

    uniform token openUsdPhysics:scene:solverType = "tgs" (
        allowedTokens = ["pgs", "tgs"]
        displayName = "Solver Type"
        doc = """Constraint solver to use for this scene."""
    )

    uniform int64 openUsdPhysics:scene:timeStepsPerSecond = 60 (
        displayName = "Time Steps Per Second"
        doc = """Requested fixed simulation frequency. The session clamps this to the supported range and reports a diagnostic when it does."""
    )

    uniform int64 openUsdPhysics:scene:velocityIterationCount = 1 (
        displayName = "Velocity Iteration Count"
        doc = """Solver velocity iterations per simulation step."""
    )
}

class "OpenUsdPhysicsRigidBodySettingsAPI" (
    customData = {
        string className = "RigidBodySettingsAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Per-body solver settings that standard UsdPhysicsRigidBodyAPI does not express. Apply alongside PhysicsRigidBodyAPI."""

    inherits = </APISchemaBase>
)
{
    double openUsdPhysics:body:contactSlopCoefficient = 0 (
        displayName = "Contact Slop Coefficient"
        doc = """Penetration tolerance retained to reduce jitter, in stage linear units."""
    )

    bool openUsdPhysics:body:disableGravity = false (
        displayName = "Disable Gravity"
        doc = """Excludes this body from scene gravity."""
    )

    bool openUsdPhysics:body:enableCCD = false (
        displayName = "Enable CCD"
        doc = """Enables continuous collision detection for this body."""
    )

    bool openUsdPhysics:body:enableSpeculativeCCD = false (
        displayName = "Enable Speculative CCD"
        doc = """Enables speculative contacts for this body."""
    )

    token[] openUsdPhysics:body:lockedAngularAxes = [] (
        displayName = "Locked Angular Axes"
        doc = """Rotation axes the solver must not move. Valid entries are 'x', 'y', and 'z' in stage space."""
    )

    token[] openUsdPhysics:body:lockedLinearAxes = [] (
        displayName = "Locked Linear Axes"
        doc = """Translation axes the solver must not move. Valid entries are 'x', 'y', and 'z' in stage space."""
    )

    double openUsdPhysics:body:maxAngularVelocity = inf (
        displayName = "Max Angular Velocity"
        doc = """Angular velocity clamp in degrees per second."""
    )

    double openUsdPhysics:body:maxContactImpulse = inf (
        displayName = "Max Contact Impulse"
        doc = """Upper bound on the impulse a single contact may apply."""
    )

    double openUsdPhysics:body:maxDepenetrationVelocity = inf (
        displayName = "Max Depenetration Velocity"
        doc = """Upper bound on the velocity the solver may apply to resolve penetration."""
    )

    double openUsdPhysics:body:maxLinearVelocity = inf (
        displayName = "Max Linear Velocity"
        doc = """Linear velocity clamp in stage linear units per second."""
    )

    uniform int64 openUsdPhysics:body:positionIterationCount = 4 (
        displayName = "Position Iteration Count"
        doc = """Solver position iterations for this body. Overrides the scene value."""
    )

    bool openUsdPhysics:body:retainAccelerations = false (
        displayName = "Retain Accelerations"
        doc = """Keeps solver accelerations between steps."""
    )

    double openUsdPhysics:body:sleepThreshold = 0.005 (
        displayName = "Sleep Threshold"
        doc = """Mass-normalized kinetic energy below which the body may sleep."""
    )

    double openUsdPhysics:body:stabilizationThreshold = 0.00025 (
        displayName = "Stabilization Threshold"
        doc = """Mass-normalized kinetic energy below which the stabilization pass engages."""
    )

    uniform int64 openUsdPhysics:body:velocityIterationCount = 1 (
        displayName = "Velocity Iteration Count"
        doc = """Solver velocity iterations for this body. Overrides the scene value."""
    )
}

class "OpenUsdPhysicsCollisionSettingsAPI" (
    customData = {
        string className = "CollisionSettingsAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Per-collider tolerances and reporting that standard UsdPhysicsCollisionAPI does not express."""

    inherits = </APISchemaBase>
)
{
    double openUsdPhysics:collision:contactImpulseThreshold = 0 (
        displayName = "Contact Impulse Threshold"
        doc = """Minimum impulse a contact must carry before it is reported as an event."""
    )

    double openUsdPhysics:collision:contactOffset = -1 (
        displayName = "Contact Offset"
        doc = """Distance at which contacts are generated, in stage linear units. A negative value requests the runtime default."""
    )

    double openUsdPhysics:collision:minTorsionalPatchRadius = 0 (
        displayName = "Min Torsional Patch Radius"
        doc = """Lower bound applied to the torsional patch radius, in stage linear units."""
    )

    bool openUsdPhysics:collision:reportContacts = false (
        displayName = "Report Contacts"
        doc = """Emits contact events for this collider."""
    )

    double openUsdPhysics:collision:restOffset = 0 (
        displayName = "Rest Offset"
        doc = """Separation maintained at rest, in stage linear units."""
    )

    double openUsdPhysics:collision:torsionalPatchRadius = 0 (
        displayName = "Torsional Patch Radius"
        doc = """Radius used to derive torsional friction for patch contacts, in stage linear units."""
    )
}

class "OpenUsdPhysicsMaterialSettingsAPI" (
    customData = {
        string className = "MaterialSettingsAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Material combine modes and compliant-contact settings that standard UsdPhysicsMaterialAPI does not express."""

    inherits = </APISchemaBase>
)
{
    double openUsdPhysics:material:compliantContactDamping = 0 (
        displayName = "Compliant Contact Damping"
        doc = """Contact spring damping. Ignored when the stiffness is zero."""
    )

    double openUsdPhysics:material:compliantContactStiffness = 0 (
        displayName = "Compliant Contact Stiffness"
        doc = """Contact spring stiffness. Zero selects rigid contacts."""
    )

    uniform token openUsdPhysics:material:frictionCombineMode = "average" (
        allowedTokens = ["average", "min", "multiply", "max"]
        displayName = "Friction Combine Mode"
        doc = """How friction coefficients of two contacting materials combine."""
    )

    bool openUsdPhysics:material:improvePatchFriction = true (
        displayName = "Improve Patch Friction"
        doc = """Uses the improved patch friction model for this material."""
    )

    uniform token openUsdPhysics:material:restitutionCombineMode = "average" (
        allowedTokens = ["average", "min", "multiply", "max"]
        displayName = "Restitution Combine Mode"
        doc = """How restitution coefficients of two contacting materials combine."""
    )
}

class "OpenUsdPhysicsArticulationSettingsAPI" (
    customData = {
        string className = "ArticulationSettingsAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Reduced-coordinate articulation settings that standard UsdPhysicsArticulationRootAPI does not express."""

    inherits = </APISchemaBase>
)
{
    uniform bool openUsdPhysics:articulation:enabledSelfCollisions = false (
        displayName = "Enabled Self Collisions"
        doc = """Allows links of the same articulation to collide with each other."""
    )

    uniform bool openUsdPhysics:articulation:fixBase = false (
        displayName = "Fix Base"
        doc = """Anchors the articulation root to the world."""
    )

    uniform int64 openUsdPhysics:articulation:positionIterationCount = 4 (
        displayName = "Position Iteration Count"
        doc = """Solver position iterations for the articulation."""
    )

    double openUsdPhysics:articulation:sleepThreshold = 0.005 (
        displayName = "Sleep Threshold"
        doc = """Mass-normalized kinetic energy below which the articulation may sleep."""
    )

    double openUsdPhysics:articulation:stabilizationThreshold = 0.00025 (
        displayName = "Stabilization Threshold"
        doc = """Mass-normalized kinetic energy below which the stabilization pass engages."""
    )

    uniform int64 openUsdPhysics:articulation:velocityIterationCount = 1 (
        displayName = "Velocity Iteration Count"
        doc = """Solver velocity iterations for the articulation."""
    )
}

class "OpenUsdPhysicsSimulationMetadataAPI" (
    customData = {
        string className = "SimulationMetadataAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Stable simulation identity and provenance recorded on a physics object so results, events, and queries can be correlated across rebuilds."""

    inherits = </APISchemaBase>
)
{
    uniform int64 openUsdPhysics:simulation:identity = 0 (
        displayName = "Identity"
        doc = """Stable signed 64-bit simulation identity. Zero requests a derived identity from the canonical prim path and instance domain."""
    )

    uniform token openUsdPhysics:simulation:identityDomain = "prim" (
        allowedTokens = ["prim", "instance", "component"]
        displayName = "Identity Domain"
        doc = """Addressing domain the identity index applies to."""
    )

    uniform int64 openUsdPhysics:simulation:identityIndex = -1 (
        displayName = "Identity Index"
        doc = """Index within the identity domain. -1 addresses the prim itself."""
    )

    uniform int64 openUsdPhysics:simulation:schemaVersion = 1 (
        displayName = "Schema Version"
        doc = """Version of the openUsdPhysics schema the opinions on this prim were authored against."""
    )

    uniform string openUsdPhysics:simulation:sourceRevision = "" (
        displayName = "Source Revision"
        doc = """Opaque revision recorded when these opinions were produced by a bake or an export."""
    )
}

class "OpenUsdPhysicsCharacterControllerAPI" (
    customData = {
        string className = "CharacterControllerAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """A kinematic character controller. Apply to a UsdGeomXformable prim. The controller is driven by session move commands, not by authored per-frame input."""

    inherits = </APISchemaBase>
)
{
    uniform token openUsdPhysics:controller:climbingMode = "easy" (
        allowedTokens = ["easy", "constrained"]
        displayName = "Climbing Mode"
        doc = """Capsule climbing behaviour. Ignored for box controllers."""
    )

    double openUsdPhysics:controller:contactOffset = 0.02 (
        displayName = "Contact Offset"
        doc = """Skin width kept between the controller and geometry, in stage linear units."""
    )

    double openUsdPhysics:controller:density = 10 (
        displayName = "Density"
        doc = """Density of the controller kinematic proxy, in stage mass units per cubic linear unit."""
    )

    bool openUsdPhysics:controller:enabled = true (
        displayName = "Enabled"
        doc = """Enables the controller."""
    )

    float3 openUsdPhysics:controller:halfExtents = (0.5, 1, 0.5) (
        displayName = "Half Extents"
        doc = """Box half extents in stage linear units."""
    )

    double openUsdPhysics:controller:height = 1 (
        displayName = "Height"
        doc = """Capsule segment height, excluding the caps, in stage linear units."""
    )

    double openUsdPhysics:controller:invisibleWallHeight = 0 (
        displayName = "Invisible Wall Height"
        doc = """Height of the virtual wall added above non-walkable surfaces, in stage linear units. Zero disables it."""
    )

    rel openUsdPhysics:controller:material (
        displayName = "Material"
        doc = """Single physics material applied to the controller volume."""
    )

    double openUsdPhysics:controller:maxJumpHeight = 0 (
        displayName = "Max Jump Height"
        doc = """Height above the controller kept clear when invisible walls are enabled, in stage linear units."""
    )

    double openUsdPhysics:controller:minMoveDistance = 0 (
        displayName = "Min Move Distance"
        doc = """Move requests shorter than this distance are discarded, in stage linear units."""
    )

    uniform token openUsdPhysics:controller:nonWalkableMode = "preventClimbing" (
        allowedTokens = ["preventClimbing", "preventClimbingAndForceSliding"]
        displayName = "Non Walkable Mode"
        doc = """Behaviour when the controller meets a surface steeper than the slope limit."""
    )

    double openUsdPhysics:controller:radius = 0.5 (
        displayName = "Radius"
        doc = """Capsule radius in stage linear units."""
    )

    double openUsdPhysics:controller:scaleCoeff = 0.8 (
        displayName = "Scale Coefficient"
        doc = """Scale applied to the controller volume when generating its collision proxy."""
    )

    uniform token openUsdPhysics:controller:shapeType = "capsule" (
        allowedTokens = ["capsule", "box"]
        displayName = "Shape Type"
        doc = """Controller volume. 'halfExtents' applies to boxes; 'radius' and 'height' apply to capsules."""
    )

    rel openUsdPhysics:controller:simulationOwner (
        displayName = "Simulation Owner"
        doc = """Single PhysicsScene that simulates this controller."""
    )

    double openUsdPhysics:controller:slopeLimit = 45 (
        displayName = "Slope Limit"
        doc = """Maximum walkable slope in degrees, measured from the up axis."""
    )

    double openUsdPhysics:controller:stepOffset = 0.5 (
        displayName = "Step Offset"
        doc = """Maximum obstacle height the controller can climb, in stage linear units."""
    )

    float3 openUsdPhysics:controller:upAxis = (0, 1, 0) (
        displayName = "Up Axis"
        doc = """Controller up direction in stage space. A zero vector requests the stage upAxis."""
    )

    double openUsdPhysics:controller:volumeGrowth = 1.5 (
        displayName = "Volume Growth"
        doc = """Cache volume growth factor used when gathering nearby geometry."""
    )
}

class "OpenUsdPhysicsVehicleAPI" (
    customData = {
        string className = "VehicleAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Marks a rigid body as a vehicle. Apply alongside PhysicsRigidBodyAPI. Wheels are described by descendant prims carrying OpenUsdPhysicsVehicleWheelAttachmentAPI."""

    inherits = </APISchemaBase>
)
{
    uniform token openUsdPhysics:vehicle:driveType = "direct" (
        allowedTokens = ["none", "direct", "engine"]
        displayName = "Drive Type"
        doc = """Drivetrain model. 'none' simulates suspension and tires only, 'direct' applies wheel torques directly, and 'engine' uses the engine, clutch, gearbox, and differential."""
    )

    rel openUsdPhysics:vehicle:drivetrain (
        displayName = "Drivetrain"
        doc = """Single prim carrying the engine, clutch, gearbox, and differential schemas for this vehicle. When absent, those schemas are looked up on the vehicle prim itself."""
    )

    bool openUsdPhysics:vehicle:enabled = true (
        displayName = "Enabled"
        doc = """Enables vehicle simulation for this body."""
    )

    uniform token openUsdPhysics:vehicle:lateralAxis = "posX" (
        allowedTokens = ["posX", "negX", "posY", "negY", "posZ", "negZ"]
        displayName = "Lateral Axis"
        doc = """Right axis of the vehicle in its own body space."""
    )

    double openUsdPhysics:vehicle:lateralStickyTireDamping = 1 (
        displayName = "Lateral Sticky Tire Damping"
        doc = """Damping of the lateral sticky tire constraint."""
    )

    double openUsdPhysics:vehicle:lateralStickyTireThresholdSpeed = 0.2 (
        displayName = "Lateral Sticky Tire Threshold Speed"
        doc = """Lateral speed below which the sticky tire constraint may engage, in stage linear units per second."""
    )

    double openUsdPhysics:vehicle:lateralStickyTireThresholdTime = 1 (
        displayName = "Lateral Sticky Tire Threshold Time"
        doc = """Time the lateral speed must stay below the threshold before the sticky tire constraint engages, in seconds."""
    )

    uniform token openUsdPhysics:vehicle:longitudinalAxis = "posZ" (
        allowedTokens = ["posX", "negX", "posY", "negY", "posZ", "negZ"]
        displayName = "Longitudinal Axis"
        doc = """Forward axis of the vehicle in its own body space."""
    )

    double openUsdPhysics:vehicle:longitudinalStickyTireDamping = 0.1 (
        displayName = "Longitudinal Sticky Tire Damping"
        doc = """Damping of the longitudinal sticky tire constraint."""
    )

    double openUsdPhysics:vehicle:longitudinalStickyTireThresholdSpeed = 0.2 (
        displayName = "Longitudinal Sticky Tire Threshold Speed"
        doc = """Longitudinal speed below which the sticky tire constraint may engage, in stage linear units per second."""
    )

    double openUsdPhysics:vehicle:longitudinalStickyTireThresholdTime = 1 (
        displayName = "Longitudinal Sticky Tire Threshold Time"
        doc = """Time the longitudinal speed must stay below the threshold before the sticky tire constraint engages, in seconds."""
    )

    double openUsdPhysics:vehicle:minActiveLongitudinalSlipDenominator = 0.1 (
        displayName = "Min Active Longitudinal Slip Denominator"
        doc = """Lower bound on the longitudinal slip denominator while drive torque is applied, in stage linear units per second."""
    )

    double openUsdPhysics:vehicle:minLateralSlipDenominator = 1 (
        displayName = "Min Lateral Slip Denominator"
        doc = """Lower bound on the lateral slip denominator, in stage linear units per second."""
    )

    double openUsdPhysics:vehicle:minPassiveLongitudinalSlipDenominator = 4 (
        displayName = "Min Passive Longitudinal Slip Denominator"
        doc = """Lower bound on the longitudinal slip denominator while no drive torque is applied, in stage linear units per second."""
    )

    uniform int64 openUsdPhysics:vehicle:subStepCountHighSpeed = 1 (
        displayName = "Sub Step Count High Speed"
        doc = """Vehicle sub-steps per simulation step at or above the longitudinal speed threshold."""
    )

    uniform int64 openUsdPhysics:vehicle:subStepCountLowSpeed = 3 (
        displayName = "Sub Step Count Low Speed"
        doc = """Vehicle sub-steps per simulation step below the longitudinal speed threshold."""
    )

    double openUsdPhysics:vehicle:subStepThresholdLongitudinalSpeed = 5 (
        displayName = "Sub Step Threshold Longitudinal Speed"
        doc = """Longitudinal speed separating the low- and high-speed sub-step counts, in stage linear units per second."""
    )

    uniform token openUsdPhysics:vehicle:suspensionQueryType = "raycast" (
        allowedTokens = ["raycast", "sweep"]
        displayName = "Suspension Query Type"
        doc = """Scene query used to find the ground under each wheel."""
    )

    uniform token openUsdPhysics:vehicle:verticalAxis = "posY" (
        allowedTokens = ["posX", "negX", "posY", "negY", "posZ", "negZ"]
        displayName = "Vertical Axis"
        doc = """Up axis of the vehicle in its own body space."""
    )
}

class "OpenUsdPhysicsVehicleWheelAttachmentAPI" (
    customData = {
        string className = "VehicleWheelAttachmentAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Attaches one wheel to a vehicle. Apply to a descendant prim of the vehicle body."""

    inherits = </APISchemaBase>
)
{
    uniform int64 openUsdPhysics:wheelAttachment:index = -1 (
        displayName = "Index"
        doc = """Wheel index referenced by the brake, steering, and differential wheel lists. -1 requests an index derived from traversal order."""
    )

    rel openUsdPhysics:wheelAttachment:suspension (
        displayName = "Suspension"
        doc = """Single prim carrying OpenUsdPhysicsVehicleSuspensionAPI. When absent, the schema is looked up on this prim."""
    )

    float[] openUsdPhysics:wheelAttachment:suspensionFrameOrientation = [1, 0, 0, 0] (
        displayName = "Suspension Frame Orientation"
        doc = """Suspension frame orientation in vehicle body space as a unit quaternion ordered (w, x, y, z)."""
    )

    float3 openUsdPhysics:wheelAttachment:suspensionFramePosition = (0, 0, 0) (
        displayName = "Suspension Frame Position"
        doc = """Suspension frame origin in vehicle body space, in stage linear units."""
    )

    float3 openUsdPhysics:wheelAttachment:suspensionTravelDirection = (0, -1, 0) (
        displayName = "Suspension Travel Direction"
        doc = """Direction the suspension compresses along, in vehicle body space."""
    )

    rel openUsdPhysics:wheelAttachment:tire (
        displayName = "Tire"
        doc = """Single prim carrying OpenUsdPhysicsVehicleTireAPI. When absent, the schema is looked up on this prim."""
    )

    rel openUsdPhysics:wheelAttachment:wheel (
        displayName = "Wheel"
        doc = """Single prim carrying OpenUsdPhysicsVehicleWheelAPI. When absent, the schema is looked up on this prim."""
    )

    float[] openUsdPhysics:wheelAttachment:wheelFrameOrientation = [1, 0, 0, 0] (
        displayName = "Wheel Frame Orientation"
        doc = """Wheel orientation relative to the suspension frame as a unit quaternion ordered (w, x, y, z)."""
    )

    float3 openUsdPhysics:wheelAttachment:wheelFramePosition = (0, 0, 0) (
        displayName = "Wheel Frame Position"
        doc = """Wheel centre offset from the suspension frame at maximum droop, in stage linear units."""
    )
}

class "OpenUsdPhysicsVehicleWheelAPI" (
    customData = {
        string className = "VehicleWheelAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Rotating wheel mass properties for a vehicle wheel."""

    inherits = </APISchemaBase>
)
{
    double openUsdPhysics:wheel:dampingRate = 0.25 (
        displayName = "Damping Rate"
        doc = """Damping applied to the wheel rotation speed."""
    )

    double openUsdPhysics:wheel:mass = 20 (
        displayName = "Mass"
        doc = """Wheel mass in stage mass units."""
    )

    double openUsdPhysics:wheel:momentOfInertia = 1 (
        displayName = "Moment Of Inertia"
        doc = """Wheel moment of inertia about its rotation axis."""
    )

    double openUsdPhysics:wheel:radius = 0.5 (
        displayName = "Radius"
        doc = """Wheel radius in stage linear units."""
    )

    double openUsdPhysics:wheel:toeAngle = 0 (
        displayName = "Toe Angle"
        doc = """Static toe angle in degrees."""
    )

    double openUsdPhysics:wheel:width = 0.2 (
        displayName = "Width"
        doc = """Wheel width in stage linear units."""
    )
}

class "OpenUsdPhysicsVehicleSuspensionAPI" (
    customData = {
        string className = "VehicleSuspensionAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Suspension spring and camber compliance for a vehicle wheel."""

    inherits = </APISchemaBase>
)
{
    double openUsdPhysics:suspension:camberAtMaxCompression = 0 (
        displayName = "Camber At Max Compression"
        doc = """Camber angle in degrees at maximum compression."""
    )

    double openUsdPhysics:suspension:camberAtMaxDroop = 0 (
        displayName = "Camber At Max Droop"
        doc = """Camber angle in degrees at maximum droop."""
    )

    double openUsdPhysics:suspension:camberAtRest = 0 (
        displayName = "Camber At Rest"
        doc = """Camber angle in degrees at the rest position."""
    )

    double openUsdPhysics:suspension:springDamperRate = 1000 (
        displayName = "Spring Damper Rate"
        doc = """Suspension damping rate."""
    )

    double openUsdPhysics:suspension:springStrength = 10000 (
        displayName = "Spring Strength"
        doc = """Suspension spring stiffness."""
    )

    double openUsdPhysics:suspension:sprungMass = 0 (
        displayName = "Sprung Mass"
        doc = """Mass carried by this suspension in stage mass units. Zero requests a distribution derived from the vehicle mass and wheel placement."""
    )

    double openUsdPhysics:suspension:travelDistance = 0.5 (
        displayName = "Travel Distance"
        doc = """Total suspension travel from maximum droop to maximum compression, in stage linear units."""
    )
}

class "OpenUsdPhysicsVehicleTireAPI" (
    customData = {
        string className = "VehicleTireAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Tire force response for a vehicle wheel."""

    inherits = </APISchemaBase>
)
{
    double openUsdPhysics:tire:camberStiffness = 0 (
        displayName = "Camber Stiffness"
        doc = """Lateral force per unit camber angle in degrees."""
    )

    rel openUsdPhysics:tire:frictionTable (
        displayName = "Friction Table"
        doc = """Single OpenUsdPhysicsVehicleTireFrictionTable prim selecting friction by ground material."""
    )

    float2[] openUsdPhysics:tire:frictionVsSlipGraph = [(0, 1), (0.1, 1), (1, 1)] (
        displayName = "Friction Vs Slip Graph"
        doc = """Friction multiplier as (longitudinal slip, multiplier) pairs in ascending slip order."""
    )

    float2[] openUsdPhysics:tire:lateralStiffnessGraph = [(0.3125, 20)] (
        displayName = "Lateral Stiffness Graph"
        doc = """Lateral stiffness response as (normalized load, stiffness) pairs in ascending load order."""
    )

    double openUsdPhysics:tire:longitudinalStiffness = 5000 (
        displayName = "Longitudinal Stiffness"
        doc = """Longitudinal force per unit longitudinal slip."""
    )

    double openUsdPhysics:tire:restLoad = 0 (
        displayName = "Rest Load"
        doc = """Load carried by the tire at rest. Zero requests a value derived from the sprung mass and scene gravity."""
    )
}

class OpenUsdPhysicsVehicleTireFrictionTable "OpenUsdPhysicsVehicleTireFrictionTable" (
