#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "Near"
    {
        uniform token subdivisionScheme = "none"
        bool doubleSided = true
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-3, -1, -3), (-1, -1, -3), (-1, 1, -3), (-3, 1, -3)]
        color3f[] primvars:displayColor = [(1, 0, 0)] (
            interpolation = "constant"
        )
    }
    def Mesh "Far"
    {
        uniform token subdivisionScheme = "none"
        bool doubleSided = true
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(1, -1, -7), (3, -1, -7), (3, 1, -7), (1, 1, -7)]
        color3f[] primvars:displayColor = [(0, 1, 0)] (
            interpolation = "constant"
        )
    }
    def PointInstancer "Instances"
    {
        rel prototypes = </World/Instances/Prototype>
        int[] protoIndices = [0, 0]
        int64[] ids = [101, 202]
        point3f[] positions = [(-1, 2, -5), (1, 2, -5)]
        def Mesh "Prototype"
        {
            uniform token subdivisionScheme = "none"
            bool doubleSided = true
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            point3f[] points = [(-0.4, -0.4, 0), (0.4, -0.4, 0), (0.4, 0.4, 0), (-0.4, 0.4, 0)]
            color3f[] primvars:displayColor = [(0, 0, 1)] (
                interpolation = "constant"
            )
        }
    }
}
