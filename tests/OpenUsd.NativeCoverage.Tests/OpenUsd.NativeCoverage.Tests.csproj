<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenUsd\OpenUsd.csproj" />
    <ProjectReference Include="..\..\src\OpenUsd.Interop\OpenUsd.Interop.csproj" />
    <ProjectReference Include="..\..\src\OpenUsd.Physics\OpenUsd.Physics.csproj" />
    <ProjectReference Include="..\..\src\OpenUsd.Rendering.Silk.D3D12\OpenUsd.Rendering.Silk.D3D12.csproj" />
    <ProjectReference Include="..\..\src\OpenUsd.Rendering.Silk\OpenUsd.Rendering.Silk.csproj" />
    <ProjectReference Include="..\..\src\OpenUsd.Viewer\OpenUsd.Viewer.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OpenUsd.NativeCoverage.Tests</AssemblyName>
    <RootNamespace>OpenUsd.NativeCoverage.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <OpenUsdRequiresNativeRuntime>true</OpenUsdRequiresNativeRuntime>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\test-assets\native-profile\**\*">
      <Link>test-assets\native-profile\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
